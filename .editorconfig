# EditorConfig helps maintain consistent whitespace conventions across
# editors and contributors. See https://editorconfig.org.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source is tab-indented; gofmt is the enforcement mechanism, this just
# keeps editors from fighting it before a save-time format runs.
[*.go]
indent_style = tab

[go.mod]
indent_style = tab

# Windows-native files keep CRLF; everything else in this repository is LF.
[*.{bat,cmd}]
end_of_line = crlf

# Generated/vendored trees are never hand-edited; do not reformat them.
[{**/node_modules/**,**/.svelte-kit/**,**/dist/**,**/build/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
