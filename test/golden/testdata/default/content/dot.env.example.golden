# Generated once by nise; owned by this application. Nise will not overwrite it.
#
# Every variable this application reads, with a safe placeholder value.
# Copy this file to .env for local use; .env is git-ignored and is never
# read by the application itself — runtime/config reads only the process
# environment, so export these or let your shell tooling do it.
#
# Any variable below may instead be supplied as <NAME>_FILE naming a file
# whose contents are the value, but only for the secrets marked as such.
# Setting both <NAME> and <NAME>_FILE at once is always an error.

# Deployment environment: development, test, or production.
# There is no fourth value and no default beyond "development".
APP_ENV=development

# Default process mode when the binary is started without -mode:
# all (web + worker), web (HTTP only), or worker (no HTTP port bound).
APP_MODE=all

# Listen address. Production refuses to bind every interface unless
# ALLOW_PUBLIC_BIND is also set.
BIND_ADDR=127.0.0.1
PORT=8080
ALLOW_PUBLIC_BIND=false

# Logging. LOG_FORMAT is json or text; production requires json.
LOG_LEVEL=info
LOG_FORMAT=text

# Developer-facing behavior. Production requires this to be false.
DEBUG=false

# Adopt inbound X-Request-Id and X-Correlation-Id headers instead of always
# generating them. Enable this only behind an ingress that sanitizes them, and
# only together with TRUSTED_PROXY_COUNT: trusting a proxy's identifiers while
# declaring that there is no proxy fails startup.
TRUST_PROXY_HEADERS=false

# How many reverse proxies sit in front of this process. Zero means none, and
# every X-Forwarded-* header is ignored — correct for a service exposed
# directly. With a count of N the client address is the entry N from the right
# of X-Forwarded-For, so anything a client forges to the left of the real
# entries is never read. Coolify and the Compose examples put exactly one proxy
# in front: set 1 there.
TRUSTED_PROXY_COUNT=0

# Which peers may be that proxy, as a comma-separated list of CIDR blocks or
# bare addresses. When it is empty, forwarded headers are honored from any
# peer, which is only safe if this port cannot be reached except through the
# proxy. Write the block, not an address inside it: 10.0.0.0/8, not 10.1.2.3/8.
TRUSTED_PROXY_NETWORKS=

# Secret. Gates the operator-only endpoints (/internal/metrics and the
# detailed readiness report). When it is unset those endpoints are not
# mounted at all, in every environment. Generate a real value with:
#   openssl rand -base64 32
# Also accepted as OPERATOR_TOKEN_FILE, naming a file holding the value.
OPERATOR_TOKEN=

# PostgreSQL is mandatory. nise dev supplies its managed local database URL
# to the child process automatically; set this when running the binary
# directly. DATABASE_URL_FILE is also accepted.
DATABASE_URL=postgres://myapp:password@127.0.0.1:5432/myapp?sslmode=disable

# Optional secret. When set, this exact value overrides any password inside
# DATABASE_URL. Compose uses it so URL-reserved password characters are safe.
DATABASE_PASSWORD=

# Conservative pool defaults. Increase DB_MAX_CONNS only after accounting
# for every application replica and PostgreSQL's server connection budget.
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s

# Secret. Signs the opaque pagination cursors the API issues, as
# <id>:<base64 secret>. The identifier is public and travels in every cursor;
# the secret must be at least 32 bytes. Generate one with:
#   echo "y2026a:$(openssl rand -base64 32)"
# Leaving it unset generates a random key for each process, which is fine on a
# development machine and refused in production because every restart and every
# replica would then reject cursors the others issued.
# Also accepted as CURSOR_SIGNING_KEY_FILE.
CURSOR_SIGNING_KEY=

# Optional secret. Comma-separated verification-only cursor keys, in the same
# <id>:<base64 secret> form. To rotate without breaking outstanding cursors,
# move the current CURSOR_SIGNING_KEY here, set a new signing key, and remove
# this entry once CURSOR_TTL has elapsed.
CURSOR_RETIRED_KEYS=

# How long an issued cursor stays valid. At most 24h.
CURSOR_TTL=1h

# Authentication throttling. The check runs before any password hashing, so an
# unthrottled login endpoint is not only a way in but a way to exhaust the
# machine. Two buckets: one per address, one per client. The client limit is
# normally the looser of the two, because several people behind one office
# address are one client and a limit tight enough for a single account would
# lock out a building.
LOGIN_ATTEMPTS_PER_ADDRESS=10
LOGIN_ATTEMPTS_PER_CLIENT=60
LOGIN_THROTTLE_WINDOW=15m

# Background jobs. Both apply only to a process running in "all" or "worker"
# mode; a web replica builds a job client but never fetches with it, so these
# are per worker process rather than per deployment.
#
# JOB_MAX_WORKERS is how many jobs one worker process runs at once. Choose it
# against DB_MAX_CONNS above, not against the CPU count: every running job
# holds work the pool has to serve, so raising this past the pool size turns
# throughput into connection waiting.
#
# JOB_POLL_INTERVAL is the backstop. River hears about almost every job
# immediately through a PostgreSQL notification; this is how long a job waits
# when that notification is missed. Lowering it costs one small query per
# worker process per interval.
JOB_MAX_WORKERS=10
JOB_POLL_INTERVAL=5s

# Outbound email.
#
# MAIL_TRANSPORT is "smtp" or "log". "log" records that a message would have
# been sent, and sends nothing — which is what a developer with no mail server
# wants, and what production refuses to start with. An application that
# silently sends no invitations is worse than one that will not start without
# a mail server: the first failure is reported weeks later as "the link is
# broken" by somebody who never received a link.
MAIL_TRANSPORT=log
MAIL_FROM=noreply@localhost

# SMTP_ENCRYPTION is "starttls" (port 587), "implicit" (port 465), or "none".
# "none" exists for a relay reached over loopback or a private network the
# deployment already trusts. Configuring credentials with it is refused at
# startup: SMTP AUTH PLAIN is a base64-encoded password on the wire.
#
# A server that does not offer STARTTLS is an error, never a fallback to
# plaintext — a silent downgrade would make an active attacker's job a matter
# of stripping one capability line.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# BACKUP_ENCRYPTION_KEY seals database backups: base64 of exactly 32 random
# bytes. Generate one with:
#
#   openssl rand -base64 32
#
# Also accepted as BACKUP_ENCRYPTION_KEY_FILE.
#
# It is read only by `db backup`, `db restore`, and `db verify`, and is not
# part of the configuration the server loads — a web replica that will never
# take a backup has no reason to hold the key that opens every one of them.
#
# There is no default and nothing is generated. An unset cursor key can fall
# back to an ephemeral one because the cost is cursors that stop verifying
# after a restart; an unset backup key would produce a backup nobody can ever
# read, and that is discovered on the day it is needed.
#
# Store it somewhere that is NOT the machine holding the backups. A key kept
# beside the ciphertext defends against nothing that actually happens.
BACKUP_ENCRYPTION_KEY=

# Origins permitted to make state-changing requests, comma-separated, each an
# absolute scheme://host with no path. Empty means this application's own
# origin, derived per request, which is what a single-origin application wants:
# a browser making a cross-site request sends the attacker's Origin and this
# host, so the two disagree and the request is refused.
ALLOWED_ORIGINS=

# The session cookie is __Host- prefixed, Secure, HttpOnly, SameSite=Lax on
# every environment, including development: http://localhost and
# http://127.0.0.1 are secure contexts in every current browser, so a developer
# exercises the production cookie path.
#
# Set this to true only when developing from an origin that is NOT localhost —
# a phone on the LAN pointed at this machine, say. It drops Secure and the
# __Host- prefix together, because a browser discards a __Host- cookie that is
# not Secure. Production refuses to start with it set.
SESSION_COOKIE_INSECURE=false

# The session cookie's name. Empty means the default, which is __Host-session
# when the cookie is Secure and session when SESSION_COOKIE_INSECURE is set.
# A name must match the transport: a __Host- name without Secure is discarded
# by the browser, and an unprefixed name with Secure silently gives up a
# browser-enforced guarantee. Both mismatches fail startup.
SESSION_COOKIE_NAME=

# Session policy. Idle is how long a session survives without use; absolute is
# the deadline fixed when it is created, which no later configuration change
# moves. The touch interval is how stale the recorded activity time may get
# before a request writes it back, which keeps an authenticated GET from being
# a database write.
SESSION_IDLE_TIMEOUT=12h
SESSION_ABSOLUTE_TIMEOUT=720h
SESSION_TOUCH_INTERVAL=5m

# Query metrics use bounded operation labels, never raw SQL. Queries at or
# above this duration emit a warning without SQL, arguments, or result data.
DB_SLOW_QUERY_THRESHOLD=250ms

# deploy/compose.yaml requires this value for PostgreSQL and passes it to the
# application as DATABASE_PASSWORD. It is not read under this name by the
# application.
POSTGRES_PASSWORD=your-password-here
