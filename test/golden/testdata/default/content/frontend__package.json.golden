{
  "name": "myapp-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run api:check && vite build",
    "messages:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --disable-async-local-storage",
    "preview": "vite preview",
    "check": "pnpm run api:check && pnpm run messages:compile && pnpm run check:runes && pnpm run check:contrast && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src e2e scripts",
    "lint:fix": "biome check --write src e2e scripts",
    "check:runes": "node scripts/check-runes.mjs src",
    "check:contrast": "node scripts/check-contrast.mjs src/app.css",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "pnpm run messages:compile && svelte-kit sync && vitest run --project unit",
    "test:browser": "pnpm run messages:compile && svelte-kit sync && vitest run --project browser",
    "test:component": "pnpm run messages:compile && svelte-kit sync && vitest run",
    "test:browser:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts --check"
  },
  "dependencies": {
    "@tanstack/table-core": "8.21.3",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@biomejs/biome": "2.5.11",
    "axe-core": "4.13.0",
    "@inlang/paraglide-js": "2.25.0",
    "@inlang/plugin-message-format": "4.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "3.0.0"
  }
}
