	r.Group(func(r chi.Router) {
		r.Delete(options.BaseURL+"/sessions/{sessionId}", wrapper.RevokeSession)
	})
	r.Group(func(r chi.Router) {
		r.Post(options.BaseURL+"/account/password", wrapper.ChangePassword)
	})
	r.Group(func(r chi.Router) {
