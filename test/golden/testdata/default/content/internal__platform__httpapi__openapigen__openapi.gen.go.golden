	r.Group(func(r chi.Router) {
		r.Get(options.BaseURL+"/", wrapper.GetAPIIndex)
	})
	r.Group(func(r chi.Router) {
		r.Delete(options.BaseURL+"/session", wrapper.SignOut)
	})
	r.Group(func(r chi.Router) {
		r.Get(options.BaseURL+"/session", wrapper.GetCurrentSession)
	})
	r.Group(func(r chi.Router) {
		r.Post(options.BaseURL+"/session", wrapper.SignIn)
	})
	r.Group(func(r chi.Router) {
		r.Post(options.BaseURL+"/session/second-factor", wrapper.CompleteSecondFactor)
	})
	r.Group(func(r chi.Router) {
		r.Delete(options.BaseURL+"/sessions", wrapper.RevokeOtherSessions)
