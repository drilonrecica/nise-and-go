// StrictServerInterface represents all server handlers.
type StrictServerInterface interface {
	// GetAPIIndex Describe the versioned API boundary
	// (GET /)
	GetAPIIndex(ctx context.Context, request GetAPIIndexRequestObject) (GetAPIIndexResponseObject, error)
	// ChangePassword Change the signed-in account's password
	// (POST /account/password)
	ChangePassword(ctx context.Context, request ChangePasswordRequestObject) (ChangePasswordResponseObject, error)
	// AcceptInvitation Turn an invitation into an account
	// (POST /invitations/accept)
	AcceptInvitation(ctx context.Context, request AcceptInvitationRequestObject) (AcceptInvitationResponseObject, error)
	// SignOut End the session making this request
	// (DELETE /session)
	SignOut(ctx context.Context, request SignOutRequestObject) (SignOutResponseObject, error)
	// GetCurrentSession Describe the session making this request
	// (GET /session)
	GetCurrentSession(ctx context.Context, request GetCurrentSessionRequestObject) (GetCurrentSessionResponseObject, error)
	// SignIn Exchange an address and password for a session
	// (POST /session)
	SignIn(ctx context.Context, request SignInRequestObject) (SignInResponseObject, error)
	// CompleteSecondFactor Finish a sign-in that opened a second-factor challenge
	// (POST /session/second-factor)
	CompleteSecondFactor(ctx context.Context, request CompleteSecondFactorRequestObject) (CompleteSecondFactorResponseObject, error)
	// RevokeOtherSessions End every session except the one making this request
	// (DELETE /sessions)
	RevokeOtherSessions(ctx context.Context, request RevokeOtherSessionsRequestObject) (RevokeOtherSessionsResponseObject, error)
	// ListSessions List the signed-in account's own sessions
	// (GET /sessions)
	ListSessions(ctx context.Context, request ListSessionsRequestObject) (ListSessionsResponseObject, error)
	// RevokeSession End one of the signed-in account's sessions
	// (DELETE /sessions/{sessionId})
	RevokeSession(ctx context.Context, request RevokeSessionRequestObject) (RevokeSessionResponseObject, error)
}

type StrictHandlerFunc func(ctx context.Context, w http.ResponseWriter, r *http.Request, request any) (any, error)
type StrictMiddlewareFunc func(f StrictHandlerFunc, operationID string) StrictHandlerFunc

type StrictHTTPServerOptions struct {
	RequestErrorHandlerFunc   func(w http.ResponseWriter, r *http.Request, err error)
	ResponseErrorHandlerFunc  func(w http.ResponseWriter, r *http.Request, err error)
	JSONBodyDecoder           func(w http.ResponseWriter, r *http.Request, expectedMediaType string, dst any) error
	JSONResponseSizeChecker   func(size int) error
	RequestContentTypeMatcher func(actual string, expected string) bool
	RequestBodyAbsentChecker  func(w http.ResponseWriter, r *http.Request) (bool, error)
}

var ErrUnsupportedRequestContentType = errors.New("request Content-Type is not declared for this operation")

func NewStrictHandler(ssi StrictServerInterface, middlewares []StrictMiddlewareFunc) ServerInterface {
	return &strictHandler{ssi: ssi, middlewares: middlewares, options: StrictHTTPServerOptions{
		RequestErrorHandlerFunc: func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, err.Error(), http.StatusBadRequest)
		},
		ResponseErrorHandlerFunc: func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, err.Error(), http.StatusInternalServerError)
		},
		JSONBodyDecoder: func(http.ResponseWriter, *http.Request, string, any) error {
			return errors.New("strict JSON body decoder is not configured")
		},
		JSONResponseSizeChecker: func(int) error {
			return errors.New("strict JSON response size checker is not configured")
		},
		RequestContentTypeMatcher: func(string, string) bool {
			return false
		},
		RequestBodyAbsentChecker: func(http.ResponseWriter, *http.Request) (bool, error) {
			return false, errors.New("request body absence checker is not configured")
		},
	}}
}

func NewStrictHandlerWithOptions(ssi StrictServerInterface, middlewares []StrictMiddlewareFunc, options StrictHTTPServerOptions) ServerInterface {
	if options.RequestErrorHandlerFunc == nil {
		options.RequestErrorHandlerFunc = func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, err.Error(), http.StatusBadRequest)
		}
	}
	if options.ResponseErrorHandlerFunc == nil {
		options.ResponseErrorHandlerFunc = func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, err.Error(), http.StatusInternalServerError)
		}
	}
	if options.JSONBodyDecoder == nil {
		options.JSONBodyDecoder = func(http.ResponseWriter, *http.Request, string, any) error {
			return errors.New("strict JSON body decoder is not configured")
		}
	}
	if options.JSONResponseSizeChecker == nil {
		options.JSONResponseSizeChecker = func(int) error {
			return errors.New("strict JSON response size checker is not configured")
		}
	}
	if options.RequestContentTypeMatcher == nil {
		options.RequestContentTypeMatcher = func(string, string) bool {
			return false
		}
	}
	if options.RequestBodyAbsentChecker == nil {
		options.RequestBodyAbsentChecker = func(http.ResponseWriter, *http.Request) (bool, error) {
			return false, errors.New("request body absence checker is not configured")
		}
	}
	return &strictHandler{ssi: ssi, middlewares: middlewares, options: options}
}

type strictHandler struct {
	ssi         StrictServerInterface
	middlewares []StrictMiddlewareFunc
	options     StrictHTTPServerOptions
}

// GetAPIIndex operation middleware
func (sh *strictHandler) GetAPIIndex(w http.ResponseWriter, r *http.Request) {
	var request GetAPIIndexRequestObject

	handler := func(ctx context.Context, w http.ResponseWriter, r *http.Request, request interface{}) (interface{}, error) {
		return sh.ssi.GetAPIIndex(ctx, request.(GetAPIIndexRequestObject))
	}
	for _, middleware := range sh.middlewares {
		handler = middleware(handler, "GetAPIIndex")
	}

	response, err := handler(r.Context(), w, r, request)

	if err != nil {
		sh.options.ResponseErrorHandlerFunc(w, r, err)
	} else if validResponse, ok := response.(GetAPIIndexResponseObject); ok {
		if err := validResponse.VisitGetAPIIndexResponse(w, sh.options.JSONResponseSizeChecker); err != nil {
			sh.options.ResponseErrorHandlerFunc(w, r, err)
		}
	} else if response != nil {
		sh.options.ResponseErrorHandlerFunc(w, r, fmt.Errorf("unexpected response type: %T", response))
	}
}

