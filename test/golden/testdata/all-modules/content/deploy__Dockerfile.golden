# Generated once by nise; owned by this application. Nise will not overwrite it.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile -t myapp .
#
# Three stages: the frontend is built with Node, its output is embedded by the
# Go build, and the runtime image carries only the static binary and a
# non-root user. Nothing else — no shell, no package manager, no libc.
#
# # Before the first build
#
# Run `pnpm --dir frontend install` once and commit `frontend/pnpm-lock.yaml`.
# Generation writes no lockfile, because resolving one requires the network
# and would make two `nise new` runs produce different projects. The frontend
# stage below refuses to guess: see the check in it for why.
#
# # Base images are pinned by digest
#
# A tag moves. `golang:1.26` is a different image next month, which means the
# same commit produces a different binary — and an image nobody can rebuild is
# one nobody can audit after an advisory. The tag is kept beside the digest so
# a reader can see what it is meant to be; the digest is what resolves.
#
# Update one deliberately, with:
#   docker buildx imagetools inspect <image>:<tag>

FROM node:22-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96 AS frontend
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml* ./frontend/
# The lockfile is required, and its absence is reported here rather than by
# pnpm — because pnpm's own message suggests `--no-frozen-lockfile`, which is
# the wrong answer for a production image. An image built from unpinned
# dependencies is an image whose contents nobody can state, and the whole
# point of building it in a container was to be able to.
RUN test -f frontend/pnpm-lock.yaml || { \
      echo "frontend/pnpm-lock.yaml is missing." >&2; \
      echo "Run 'pnpm --dir frontend install' and commit the lockfile before building an image." >&2; \
      echo "Do not pass --no-frozen-lockfile: an image built from unpinned dependencies is one whose contents nobody can state." >&2; \
      exit 1; \
    }
RUN pnpm --dir frontend install --frozen-lockfile
COPY api/openapi.yaml ./api/openapi.yaml
COPY frontend ./frontend
RUN pnpm --dir frontend build

FROM golang:1.26@sha256:ba4c8df3f74321b0d5c44911ccb694c8156340b684eed1fae09a9bd9f7a82b4d AS build
WORKDIR /src
# CGO off is what makes the binary static, which is what lets the runtime
# stage carry no libc at all. GOTOOLCHAIN=local refuses to download a
# different Go than the image has: a build that fetches its own toolchain is
# a build whose output depends on when it ran.
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/internal/platform/webui/embedded/client ./internal/platform/webui/embedded/client
# -trimpath removes the build machine's paths from the binary, so two people
# building the same commit get the same bytes. -s -w drop the symbol and DWARF
# tables, which are a third of the size and of no use in production.
RUN go build -trimpath -ldflags="-s -w" -o /out/myapp ./cmd/myapp

# An empty directory, created here so the runtime stage can copy it with the
# right ownership. The runtime image is distroless and has no shell, so there
# is no `RUN mkdir` available there — and a volume mounted over a path that
# does not exist in the image is created owned by root, which a container
# running as nonroot cannot write to. Creating it in this stage is the only
# place a directory can be given an owner before the volume inherits it.
RUN mkdir -p /out/storage

FROM gcr.io/distroless/static-debian12:nonroot@sha256:52dcfbabb7457ea47c82f6e13af8c8a4a1d9f7b0145142b3ecab20f2b888411d

# OCI annotations. They are what lets a scanner, a registry, and an incident
# responder answer "what is this and where did it come from" from the image
# alone. Set the revision and created labels at build time:
#
#   docker build -f deploy/Dockerfile \
#     --label org.opencontainers.image.revision="$(git rev-parse HEAD)" \
#     --label org.opencontainers.image.created="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
#     -t myapp .
#
# They are not baked in here because a value that changes every commit would
# invalidate this layer on every build, and because a hard-coded date is a
# lie the moment it is written.
LABEL org.opencontainers.image.title="myapp"
LABEL org.opencontainers.image.description="myapp, generated by Nise & Go"
LABEL org.opencontainers.image.base.name="gcr.io/distroless/static-debian12:nonroot"
LABEL org.opencontainers.image.base.digest="sha256:52dcfbabb7457ea47c82f6e13af8c8a4a1d9f7b0145142b3ecab20f2b888411d"

WORKDIR /
COPY --from=build /out/myapp /myapp

# The local object store's directory, owned by the user the process runs as.
# A named volume mounted here inherits that ownership; mounted over a path the
# image does not have, it would be created owned by root and the application
# would fail to start with "permission denied" on its first upload — or, as it
# happens, before serving anything at all, because the store is built during
# startup.
#
# STORAGE_LOCAL_DIR is set to it below. Point STORAGE_BACKEND at s3 instead and
# neither this directory nor the volume matters.
COPY --from=build --chown=nonroot:nonroot /out/storage /var/lib/myapp/storage

# nonroot is uid/gid 65532 in the distroless image. It is named rather than
# numbered so the intent survives a base-image change, and it is set here
# rather than left to the orchestrator because an image that only runs as
# root when nobody configures otherwise will eventually run as root.
USER nonroot:nonroot

EXPOSE 8080

# ALLOW_PUBLIC_BIND is set because a container binding only to loopback is a
# container nothing can reach. The application refuses a public bind in
# production without this exact opt-in, which is the check working rather than
# being bypassed: inside a container, published ports are the boundary.
ENV APP_ENV=production BIND_ADDR=0.0.0.0 ALLOW_PUBLIC_BIND=true PORT=8080 STORAGE_LOCAL_DIR=/var/lib/myapp/storage

# No HEALTHCHECK. This image has no shell and no HTTP client, so any
# instruction here would need a second binary purely to call an endpoint the
# orchestrator can call directly. Point your platform's liveness probe at
# /healthz and its readiness probe at /readyz — see docs/operations-runtime.md.

ENTRYPOINT ["/myapp"]
