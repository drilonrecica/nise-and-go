# Generated once by nise; owned by this application. Nise will not overwrite it.
#
# Run from the repository root:
#   docker compose -f deploy/compose.yaml up --build

services:
  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    ports:
      - "8080:8080"
    environment:
      APP_ENV: production
      APP_MODE: all
      BIND_ADDR: 0.0.0.0
      ALLOW_PUBLIC_BIND: "true"
      PORT: "8080"
      LOG_FORMAT: json
      LOG_LEVEL: info
      DEBUG: "false"
      DATABASE_URL: postgres://myapp@db:5432/myapp?sslmode=disable
      DATABASE_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      DB_MAX_CONNS: "10"
    depends_on:
      db:
        condition: service_healthy

  db:
    image: docker.io/library/postgres:17.6-alpine
    environment:
      POSTGRES_USER: myapp
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      POSTGRES_DB: myapp
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready --quiet --username myapp --dbname myapp"]
      interval: 2s
      timeout: 2s
      retries: 30
      start_period: 10s

# No healthcheck is declared for the application service. Its runtime image
# is distroless: it carries no shell and no curl, so a Compose healthcheck
# would have to run the application binary against itself, which proves
# nothing an exited process does not already prove. Probe /healthz/ready from
# outside instead — that is the endpoint your load balancer and orchestrator
# should both use.

volumes:
  postgres-data:
