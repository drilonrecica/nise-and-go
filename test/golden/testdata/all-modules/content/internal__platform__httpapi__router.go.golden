// Generated once by nise; owned by this application. Nise will not overwrite it.

// Package httpapi builds this application's HTTP handler: the ordered
// middleware chain and the routes mounted under it.
//
// The middleware order is application code on purpose. No package under
// runtime/ aggregates middleware, so the one place a reader has to look to
// know what wraps a request is New, below.
package httpapi

import (
	"bufio"
	"bytes"
	"crypto/sha256"
	"crypto/subtle"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net"
	"net/http"
	"slices"
	"strings"

	"github.com/go-chi/chi/v5"

	rtconfig "github.com/drilonrecica/nise-and-go/runtime/config"
	"github.com/drilonrecica/nise-and-go/runtime/health"
	"github.com/drilonrecica/nise-and-go/runtime/logging"
	"github.com/drilonrecica/nise-and-go/runtime/observability"
	"github.com/drilonrecica/nise-and-go/runtime/secure"

	"github.com/example/myapp/internal/platform/config"
	"github.com/example/myapp/internal/platform/httpapi/httpjson"
	"github.com/example/myapp/internal/platform/httpapi/problem"
	"github.com/example/myapp/internal/platform/webui"
)

// Deps are everything the router needs, passed explicitly. There is no
// container and no locator: if a dependency is not in this struct, no
// handler below can reach it.
type Deps struct {
	// Config is the application's resolved configuration.
	Config config.Config
	// Logger is the process logger the request middleware derives a
	// request-scoped logger from.
	Logger *slog.Logger
	// Gate is the readiness gate the lifecycle package flips during
	// shutdown.
	Gate *health.Gate
	// Prober aggregates the registered dependency checks behind readiness.
	Prober *health.Prober
	// Registry holds the process's metrics.
	Registry *observability.Registry
	// Metrics is the HTTP metrics middleware's collector.
	Metrics *observability.HTTPMetrics
	// UI serves the embedded single-page application.
	UI *webui.UI
	// Middleware contains the only supported application extension points in
	// the document and API chains. Both slots run inside the complete core.
	Middleware MiddlewareSlots
	// RegisterAPI mounts application API routes relative to /api/v1. Nil is a
	// valid empty API; unmatched API paths still use the API policy and never
	// fall through to the single-page application.
	RegisterAPI func(chi.Router)
}

// Middleware is one ordinary net/http middleware.
type Middleware func(http.Handler) http.Handler

// MiddlewareSlots are the application-owned extension points. Entries run in
// slice order, first entry outermost, after security, request IDs, logging,
// recovery, and metrics but before route dispatch. Application middleware can
// therefore extend either surface without moving ahead of a core protection.
type MiddlewareSlots struct {
	Document []Middleware
	API      []Middleware
}

// New builds the application's HTTP handler.
//
// Each sibling chain has this fixed core, outermost first:
//
//  1. secure.Middleware — security headers and the Content Security
//     Policy, outermost so that every response carries them, including one
//     produced by a panic or by chi's own 404.
//
//  2. forwarded.Policy.Middleware — resolves the client address, scheme, and
//     host once, so a log line, a recovered panic, and every handler agree
//     about who is asking.
//
//  3. logging.Middleware — assigns the request and correlation IDs and
//     stores a request-scoped logger in the context.
//
//  4. recoverer — turns a panic into a request-scoped logged 500 instead of
//     a dropped connection.
//
//  5. observability.HTTPMetrics.Middleware — counts and times the request,
//     labeled by chi's resolved route template rather than the raw path.
//
//  6. the matching application middleware slot.
//
//  7. route dispatch.
//
// The edge view is outside logging because logging is one of its consumers.
// Recovery is inside logging so it can use the request-scoped logger. Metrics
// is inside recovery so a panic is observed before it deliberately re-panics.
// Application middleware is inside the entire core. The document and API
// security policies are siblings, so neither can overwrite the other.
func New(d Deps) (http.Handler, error) {
	if err := validateMiddlewareSlots(d.Middleware); err != nil {
		return nil, err
	}
	documentPolicy, err := secure.NewDocumentPolicy(
		d.Config.Deployment(),
		secure.WithScriptHashes(d.UI.ScriptHashes()...),
		secure.WithStyleHashes(d.UI.StyleHashes()...),
	)
	if err != nil {
		return nil, fmt.Errorf("construct document security policy: %w", err)
	}
	apiPolicy, err := secure.NewAPIPolicy(d.Config.Deployment())
	if err != nil {
		return nil, fmt.Errorf("construct API security policy: %w", err)
	}
	logPolicyWaivers(d.Logger, "document", documentPolicy)
	logPolicyWaivers(d.Logger, "api", apiPolicy)

	document := chi.NewRouter()

	// The three probes are unauthenticated by design: each answers with a
	// status code and one of two fixed bodies, and never names a
	// dependency. See docs/operations-runtime.md.
	document.Method(http.MethodGet, "/healthz/startup", health.NewStartupHandler(d.Gate))
	document.Method(http.MethodGet, "/healthz/live", health.NewLivenessHandler(d.Gate))
	document.Method(http.MethodGet, "/healthz/ready", health.NewReadinessHandler(d.Gate, d.Prober))

	// The operator subtree exposes the metrics endpoint and the detailed
	// readiness report, both of which reveal internal topology. They are
	// mounted only when OPERATOR_TOKEN is set, and always behind the token
	// check — an unset token means the routes do not exist, in every
	// environment.
	if d.Config.OperatorToken.IsSet() {
		token := d.Config.OperatorToken
		document.Group(func(op chi.Router) {
			op.Use(requireOperatorToken(token))
			op.Method(http.MethodGet, "/internal/metrics", observability.NewHandler(d.Registry))
			op.Method(http.MethodGet, "/internal/healthz/ready/report", health.NewReadinessReportHandler(d.Gate, d.Prober))
		})
	}
	document.Handle("/*", d.UI)

	api := chi.NewRouter()
	if d.RegisterAPI != nil {
		d.RegisterAPI(api)
	}
	api.NotFound(problem.HTTPHandler(problem.NotFound()))
	api.MethodNotAllowed(apiMethodNotAllowed(api))

	// Mount sibling chains at the unprotected dispatch layer. Mounting the API
	// below the document policy would let the outer document middleware
	// overwrite the stricter API CSP as the response unwinds.
	root := chi.NewRouter()
	// Each core is composed around its router as an opaque http.Handler. This
	// keeps an empty API's default 404 inside the core without adding a wildcard
	// route that would turn a known path's native 405 into a 404.
	apiCore := newCoreHandler(d, apiPolicy, d.Middleware.API, api, problem.HTTPHandler(problem.InternalServerError()), true)
	documentCore := newCoreHandler(d, documentPolicy, d.Middleware.Document, document, fixedHTTPError(http.StatusInternalServerError, "internal server error"), false)
	root.Mount(APIPathPrefix, apiCore)
	root.Mount("/", documentCore)
	root.MethodNotAllowed(unsupportedMethod(apiCore, documentCore))
	return root, nil
}

// APIPathPrefix is the versioned API boundary. Routes registered through
// Deps.RegisterAPI are relative to it.
const APIPathPrefix = "/api/v1"

// apiPathRemainder reports whether path is inside the API boundary, and what
// is left of it after the prefix.
//
// The prefix is a path segment, not a string prefix: "/api/v10" is a document
// path that merely starts with the same characters, and treating it as an API
// path would move a whole future version of this application under the wrong
// security policy.
func apiPathRemainder(path string) (string, bool) {
	remainder, found := strings.CutPrefix(path, APIPathPrefix)
	if !found || (remainder != "" && !strings.HasPrefix(remainder, "/")) {
		return "", false
	}
	return remainder, true
}

// unsupportedMethod dispatches a request whose method chi's own router does
// not know.
//
// chi answers such a request from Mux.routeHTTP before any mounted handler
// runs, which means the response would be the only one this server produces
// with no security headers, no request identity, no log line, and no metric —
// reachable by anyone willing to send WebDAV's PROPFIND, or the single
// character "0". Sending it into the surface's own core instead restores every
// invariant the rest of the server holds; the core's inner router still
// produces the per-surface 405, because it reaches the same unknown-method
// branch one level down, this time from inside the chain.
func unsupportedMethod(apiCore, documentCore http.Handler) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		remainder, underAPI := apiPathRemainder(r.URL.Path)
		if !underAPI {
			documentCore.ServeHTTP(w, r)
			return
		}
		// Reproduce what chi's own Mount does to the routing path, so the
		// API 405 can still report the methods that path does allow.
		if routeContext := chi.RouteContext(r.Context()); routeContext != nil {
			if remainder == "" {
				remainder = "/"
			}
			routeContext.RoutePath = remainder
		}
		apiCore.ServeHTTP(w, r)
	}
}

// newCoreHandler fixes the core ordering in one place. Application middleware
// cannot move ahead of security, recovery, request identity/logging, or
// metrics through Deps.
func newCoreHandler(d Deps, policy *secure.Policy, application []Middleware, routes http.Handler, panicHandler http.HandlerFunc, bufferForRecovery bool) http.Handler {
	handler := routes
	for index := len(application) - 1; index >= 0; index-- {
		handler = application[index](handler)
	}
	handler = d.Metrics.Middleware(routeTemplate)(handler)
	handler = recoverer(d.Logger, panicHandler, bufferForRecovery)(handler)
	handler = logging.Middleware(d.Logger, logging.MiddlewareOptions{
		TrustInbound: d.Config.TrustProxyHeaders,
	})(handler)
	// The edge view is resolved outside logging so a log line, a recovered
	// panic, and every handler agree about who is asking. Resolving it in
	// two places would eventually mean two answers.
	handler = d.Config.TrustedProxies.Middleware(handler)
	return secure.Middleware(policy)(handler)
}

func validateMiddlewareSlots(slots MiddlewareSlots) error {
	for index, middleware := range slots.Document {
		if middleware == nil {
			return fmt.Errorf("document middleware slot %d must not be nil", index)
		}
	}
	for index, middleware := range slots.API {
		if middleware == nil {
			return fmt.Errorf("api middleware slot %d must not be nil", index)
		}
	}
	return nil
}

func logPolicyWaivers(logger *slog.Logger, surface string, policy *secure.Policy) {
	for _, waiver := range policy.Waivers() {
		logger.Warn("security policy weakened",
			slog.String("surface", surface),
			slog.String("waiver", waiver.String()))
	}
}

// routeTemplate reports the route pattern chi matched, so an HTTP metric is
// labeled "/widgets/{id}" and never a raw path carrying a record
// identifier. An unmatched request has no pattern; returning "" lets
// runtime/observability apply its own fixed fallback label.
func routeTemplate(r *http.Request) string {
	if rc := chi.RouteContext(r.Context()); rc != nil {
		return rc.RoutePattern()
	}
	return ""
}

// recoverer turns a panic in a downstream handler into a logged 500. It
// logs through the request-scoped logger, so the failing request's own IDs
// are on the record, and never writes the panic value to the response.
func recoverer(logger *slog.Logger, panicHandler http.HandlerFunc, bufferForRecovery bool) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			var buffered *recoveryResponseWriter
			responseWriter := w
			if bufferForRecovery {
				buffered = newRecoveryResponseWriter(w)
				responseWriter = buffered
			}
			defer func() {
				p := recover()
				if p == nil {
					if buffered != nil {
						if err := buffered.commit(); err != nil {
							logging.FromContext(r.Context()).Error("commit API response",
								slog.String("error_type", fmt.Sprintf("%T", err)))
						}
					}
					return
				}
				if err, ok := p.(error); ok && errors.Is(err, http.ErrAbortHandler) {
					panic(p)
				}
				log := logger
				if scoped := logging.FromContext(r.Context()); scoped != nil {
					log = scoped
				}
				log.Error("panic serving request",
					slog.String("method", r.Method),
					slog.String("route", routeTemplate(r)),
					slog.String("panic_type", fmt.Sprintf("%T", p)),
				)
				if buffered != nil && buffered.passthrough {
					panic(http.ErrAbortHandler)
				}
				panicHandler(w, r)
			}()
			next.ServeHTTP(responseWriter, r)
		})
	}
}

// recoveryResponseWriter stages an API response until its handler returns so
// a pre-commit panic can replace every partial byte with one valid Problem.
// Memory remains bounded by the JSON response limit. Explicit flush/hijack and
// larger non-JSON output switch to passthrough; a later panic aborts the
// connection instead of appending a misleading second response.
type recoveryResponseWriter struct {
	target      http.ResponseWriter
	header      http.Header
	body        bytes.Buffer
	status      int
	wroteHeader bool
	passthrough bool
}

func newRecoveryResponseWriter(target http.ResponseWriter) *recoveryResponseWriter {
	return &recoveryResponseWriter{target: target, header: target.Header().Clone()}
}

func (w *recoveryResponseWriter) Header() http.Header {
	if w.passthrough {
		return w.target.Header()
	}
	return w.header
}

func (w *recoveryResponseWriter) WriteHeader(status int) {
	if w.passthrough {
		w.target.WriteHeader(status)
		return
	}
	if status >= 100 && status <= 199 && status != http.StatusSwitchingProtocols {
		w.syncHeaders()
		w.target.WriteHeader(status)
		return
	}
	if !w.wroteHeader {
		w.status = status
		w.wroteHeader = true
	}
}

func (w *recoveryResponseWriter) Write(data []byte) (int, error) {
	if w.passthrough {
		return w.target.Write(data)
	}
	if !w.wroteHeader {
		w.WriteHeader(http.StatusOK)
	}
	if int64(w.body.Len())+int64(len(data)) > httpjson.MaxResponseBodyBytes {
		if err := w.commit(); err != nil {
			return 0, err
		}
		return w.target.Write(data)
	}
	return w.body.Write(data)
}

func (w *recoveryResponseWriter) commit() error {
	if w.passthrough {
		return nil
	}
	w.syncHeaders()
	status := w.status
	if !w.wroteHeader {
		status = http.StatusOK
	}
	w.passthrough = true
	w.target.WriteHeader(status)
	_, err := w.body.WriteTo(w.target)
	return err
}

func (w *recoveryResponseWriter) syncHeaders() {
	targetHeader := w.target.Header()
	clear(targetHeader)
	for name, values := range w.header {
		targetHeader[name] = slices.Clone(values)
	}
}

func (w *recoveryResponseWriter) startPassthrough() error {
	if w.passthrough {
		return nil
	}
	if w.wroteHeader || w.body.Len() != 0 {
		return w.commit()
	}
	w.syncHeaders()
	w.passthrough = true
	return nil
}

// FlushError is the net/http.ResponseController flush seam used through the
// metrics wrapper. Flushing deliberately commits and exits recovery staging.
func (w *recoveryResponseWriter) FlushError() error {
	if err := w.commit(); err != nil {
		return err
	}
	return http.NewResponseController(w.target).Flush()
}

// Hijack marks the response irreversible before transferring the connection.
func (w *recoveryResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	// Give outer response middleware the complete staged header map before it
	// applies write-time protections during takeover.
	w.syncHeaders()
	connection, readWriter, err := http.NewResponseController(w.target).Hijack()
	if err != nil {
		return nil, nil, err
	}
	// A successful takeover is irreversible even if serializing staged bytes
	// into the returned writer subsequently fails.
	w.passthrough = true
	w.header = w.target.Header().Clone()
	if w.wroteHeader || w.body.Len() != 0 {
		status := w.status
		if !w.wroteHeader {
			status = http.StatusOK
		}
		response := &http.Response{
			StatusCode:    status,
			ProtoMajor:    1,
			ProtoMinor:    1,
			Header:        w.header.Clone(),
			Body:          io.NopCloser(bytes.NewReader(w.body.Bytes())),
			ContentLength: int64(w.body.Len()),
		}
		if err := response.Write(readWriter.Writer); err != nil {
			if connection != nil {
				_ = connection.Close()
			}
			return nil, nil, err
		}
	}
	return connection, readWriter, nil
}

// EnableFullDuplex exits staging only after the underlying writer accepts the
// mode, so an unsupported request can still produce its buffered fallback.
func (w *recoveryResponseWriter) EnableFullDuplex() error {
	if err := http.NewResponseController(w.target).EnableFullDuplex(); err != nil {
		return err
	}
	return w.startPassthrough()
}

// Unwrap preserves ResponseController access to optional interfaces that do
// not change response commitment, such as deadline and full-duplex controls.
func (w *recoveryResponseWriter) Unwrap() http.ResponseWriter { return w.target }

func fixedHTTPError(status int, message string) http.HandlerFunc {
	return func(w http.ResponseWriter, _ *http.Request) {
		http.Error(w, message, status)
	}
}

// apiMethodNotAllowed preserves chi's Allow semantics while replacing its
// empty 405 body with the API's Problem Details representation. chi does not
// pass its discovered method set to a custom 405 handler, so match the same
// immutable route tree without executing application handlers.
func apiMethodNotAllowed(routes chi.Routes) http.HandlerFunc {
	methods := make([]string, 0)
	seen := make(map[string]struct{})
	_ = chi.Walk(routes, func(method, _ string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
		if method == "*" {
			return nil
		}
		if _, exists := seen[method]; !exists {
			seen[method] = struct{}{}
			methods = append(methods, method)
		}
		return nil
	}) // The callback always returns nil, so Walk cannot fail.
	slices.Sort(methods)

	writeProblem := problem.HTTPHandler(problem.MethodNotAllowed())
	return func(w http.ResponseWriter, r *http.Request) {
		routePath := r.URL.Path
		if routeContext := chi.RouteContext(r.Context()); routeContext != nil && routeContext.RoutePath != "" {
			routePath = routeContext.RoutePath
		}
		for _, method := range methods {
			if routes.Match(chi.NewRouteContext(), method, routePath) {
				w.Header().Add("Allow", method)
			}
		}
		writeProblem(w, r)
	}
}

// requireOperatorToken gates the operator subtree on a bearer token
// compared in constant time. It answers 404 rather than 401 for a wrong or
// absent token, so an unauthorized caller cannot learn that the endpoint
// exists at all.
// Both sides are hashed before the comparison so that the fixed-width
// digests, rather than the credentials themselves, are what the constant-
// time compare sees — otherwise the comparison's length check would leak
// the token's length.
func requireOperatorToken(token rtconfig.Secret) func(http.Handler) http.Handler {
	want := sha256.Sum256([]byte(token.Reveal()))
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			got := sha256.Sum256([]byte(bearerToken(r)))
			if subtle.ConstantTimeCompare(got[:], want[:]) != 1 {
				http.NotFound(w, r)
				return
			}
			next.ServeHTTP(w, r)
		})
	}
}

// bearerToken extracts the credential from an Authorization: Bearer header.
func bearerToken(r *http.Request) string {
	const prefix = "Bearer "
	value := r.Header.Get("Authorization")
	if len(value) <= len(prefix) || !strings.EqualFold(value[:len(prefix)], prefix) {
		return ""
	}
	return value[len(prefix):]
}
