{
  "name": "{{.AppName}}-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "{{.PackageManager}}",
  "engines": {
    "node": ">={{.NodeVersion}}"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run api:check && vite build",
    "preview": "vite preview",
    "check": "pnpm run api:check && pnpm run check:runes && pnpm run check:contrast && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:runes": "node scripts/check-runes.mjs src",
    "check:contrast": "node scripts/check-contrast.mjs src/app.css",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "svelte-kit sync && vitest run",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts --check"
  },
  "dependencies": {
{{- range $i, $d := .FrontendRuntimeDeps }}{{if $i}},{{end}}
    "{{$d.Name}}": "{{$d.Version}}"
{{- end }}
  },
  "devDependencies": {
{{- range $i, $d := .FrontendDeps }}{{if $i}},{{end}}
    "{{$d.Name}}": "{{$d.Version}}"
{{- end }}
  }
}
