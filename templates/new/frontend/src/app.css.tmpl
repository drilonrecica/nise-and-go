/* Generated once by nise; owned by this application. Nise will not overwrite it. */

@import 'tailwindcss';

/*
 * ---------------------------------------------------------------------------
 * The design tokens
 * ---------------------------------------------------------------------------
 *
 * Every color, radius, shadow, and duration a component uses is named here
 * and nowhere else. A component says `bg-surface text-text-muted`, never
 * `bg-white text-zinc-600`, so rebranding this application is editing the two
 * blocks below rather than every component that ever drew a border.
 *
 * The default personality is professional, neutral, and operational: zinc
 * surfaces in light, slate in dark, one cobalt-blue accent, and semantic
 * success/warning/danger/information tokens that are colors with meanings
 * rather than a second palette. Corners are medium, borders are thin,
 * shadows are restrained, and the font stack is the system UI stack — no
 * external font request, no layout shift, and no font-vendor dependency.
 *
 * Roles, not shades. `--line` is the decorative rule between things;
 * `--control-line` is the boundary that tells a person where an input is,
 * which is why it is darker and why WCAG 2.2 SC 1.4.11 applies to it and not
 * to `--line`. Contrast ratios of every text and boundary pair are checked
 * by `pnpm check:contrast`; keep them passing when rebranding.
 *
 * The theme is always resolved. `<html>` always carries
 * data-theme="light" or data-theme="dark" — never "system" and never
 * nothing — because the application is a single-page application that does
 * not run without JavaScript, so the small script in app.html that resolves
 * a stored preference can be relied on to have run. That is what lets the
 * two blocks below be plain attribute rules, with no `prefers-color-scheme`
 * duplicate of either palette to keep in sync.
 */

:root,
[data-theme='light'] {
	color-scheme: light;

	/* Surfaces, from furthest back to nearest the reader. */
	--canvas: #fafafa;
	--surface: #ffffff;
	--surface-muted: #f4f4f5;
	--surface-raised: #ffffff;
	--overlay: rgb(24 24 27 / 0.45);

	/* Text. */
	--text: #18181b;
	--text-muted: #52525b;
	--text-subtle: #6b6b74;
	--text-inverted: #ffffff;

	/* Lines. --line is decorative; --control-line identifies a control and
	 * therefore holds 3:1 against every surface it is drawn on. */
	--line: #e4e4e7;
	--line-strong: #d4d4d8;
	--control-line: #8b8b95;

	/* The one accent. */
	--primary: #2049db;
	--primary-hover: #1a3bb0;
	--primary-active: #17338f;
	--primary-text: #ffffff;
	--primary-soft: #eef4ff;
	--primary-on-soft: #1a3bb0;

	/* Semantic states. Each has a fill (for a solid badge or button), a text
	 * color readable on its own soft background, and that soft background. */
	--success: #067647;
	--success-text: #05603a;
	--success-soft: #ecfdf3;
	--success-line: #a6f4c5;

	--warning: #b54708;
	--warning-text: #93370d;
	--warning-soft: #fffaeb;
	--warning-line: #fedf89;

	--danger: #b42318;
	--danger-hover: #912018;
	--danger-text: #912018;
	--danger-soft: #fef3f2;
	--danger-line: #fecdca;

	--info: #175cd3;
	--info-text: #1849a9;
	--info-soft: #eff8ff;
	--info-line: #b2ddff;

	--ring: #2049db;
}

[data-theme='dark'] {
	color-scheme: dark;

	--canvas: #0c111d;
	--surface: #131a2a;
	--surface-muted: #1b2434;
	--surface-raised: #1b2434;
	--overlay: rgb(2 6 14 / 0.65);

	--text: #e8ecf3;
	--text-muted: #a3aebf;
	--text-subtle: #8592a6;
	--text-inverted: #ffffff;

	--line: #26303f;
	--line-strong: #334154;
	--control-line: #606e86;

	--primary: #2f5ae8;
	--primary-hover: #3b66f5;
	--primary-active: #2447c4;
	--primary-text: #ffffff;
	--primary-soft: #16204a;
	--primary-on-soft: #a8c0ff;

	--success: #0b7a54;
	--success-text: #6ee7b7;
	--success-soft: #06251b;
	--success-line: #115e46;

	--warning: #b45309;
	--warning-text: #fcd34d;
	--warning-soft: #2a1c05;
	--warning-line: #6b4310;

	--danger: #c53030;
	--danger-hover: #a52a2a;
	--danger-text: #fca5a5;
	--danger-soft: #2c1113;
	--danger-line: #7a2626;

	--info: #2f5ae8;
	--info-text: #a8c0ff;
	--info-soft: #101c3a;
	--info-line: #26407e;

	--ring: #8fb0ff;
}

/*
 * ---------------------------------------------------------------------------
 * Tailwind's view of the tokens
 * ---------------------------------------------------------------------------
 *
 * `@theme inline` publishes each role as a utility — `bg-surface`,
 * `text-text-muted`, `border-line`, `rounded-md`, `shadow-raised` — while
 * leaving the value a reference to the custom property above, so a theme
 * switch is one attribute change and no stylesheet reload.
 *
 * `inline` matters: without it Tailwind would copy the current value into
 * its own variable at build time and both themes would render as light.
 */
@theme inline {
	--color-canvas: var(--canvas);
	--color-surface: var(--surface);
	--color-surface-muted: var(--surface-muted);
	--color-surface-raised: var(--surface-raised);
	--color-overlay: var(--overlay);

	--color-text: var(--text);
	--color-text-muted: var(--text-muted);
	--color-text-subtle: var(--text-subtle);
	--color-text-inverted: var(--text-inverted);

	--color-line: var(--line);
	--color-line-strong: var(--line-strong);
	--color-control-line: var(--control-line);

	--color-primary: var(--primary);
	--color-primary-hover: var(--primary-hover);
	--color-primary-active: var(--primary-active);
	--color-primary-text: var(--primary-text);
	--color-primary-soft: var(--primary-soft);
	--color-primary-on-soft: var(--primary-on-soft);

	--color-success: var(--success);
	--color-success-text: var(--success-text);
	--color-success-soft: var(--success-soft);
	--color-success-line: var(--success-line);

	--color-warning: var(--warning);
	--color-warning-text: var(--warning-text);
	--color-warning-soft: var(--warning-soft);
	--color-warning-line: var(--warning-line);

	--color-danger: var(--danger);
	--color-danger-hover: var(--danger-hover);
	--color-danger-text: var(--danger-text);
	--color-danger-soft: var(--danger-soft);
	--color-danger-line: var(--danger-line);

	--color-info: var(--info);
	--color-info-text: var(--info-text);
	--color-info-soft: var(--info-soft);
	--color-info-line: var(--info-line);

	--color-ring: var(--ring);

	/* Medium radii. Nothing here is pill-shaped except a deliberate badge. */
	--radius-xs: 0.25rem;
	--radius-sm: 0.375rem;
	--radius-md: 0.5rem;
	--radius-lg: 0.75rem;
	--radius-xl: 1rem;

	/* Restrained shadows. Elevation is mostly a border and a surface change;
	 * these are for things that genuinely float above the page. */
	--shadow-raised: 0 1px 2px 0 rgb(9 12 20 / 0.06), 0 1px 3px 0 rgb(9 12 20 / 0.08);
	--shadow-floating: 0 4px 8px -2px rgb(9 12 20 / 0.10), 0 2px 4px -2px rgb(9 12 20 / 0.06);
	--shadow-overlay: 0 12px 24px -6px rgb(9 12 20 / 0.16), 0 4px 8px -4px rgb(9 12 20 / 0.08);

	/* The system UI stack: no network request, no layout shift, and the
	 * typeface the reader's operating system already renders best. */
	--font-sans:
		system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans',
		sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
	--font-mono:
		ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

	/* Functional motion only: 120–200ms, and every one of them is suppressed
	 * under prefers-reduced-motion.
	 *
	 * Tailwind has no --duration-* namespace, so these three are plain
	 * variables and the three utilities that read them are defined below with
	 * @utility. The defaults are overridden here as well, so a bare
	 * `transition-colors` is already this application's timing rather than
	 * Tailwind's 150ms and its own easing curve. */
	--duration-fast: 120ms;
	--duration-base: 160ms;
	--duration-slow: 200ms;
	--ease-standard: cubic-bezier(0.2, 0, 0, 1);
	--default-transition-duration: var(--duration-base);
	--default-transition-timing-function: var(--ease-standard);

	/* Balanced operational density: comfortable controls, compact tables. */
	--spacing-control-sm: 1.75rem;
	--spacing-control-md: 2.25rem;
	--spacing-control-lg: 2.75rem;
	--spacing-row: 2.5rem;
}

/*
 * The three motion utilities. Tailwind's `duration-*` takes bare numbers and
 * has no theme namespace to hang a name on, so `duration-fast` would silently
 * not exist — a class that looks right, generates nothing, and leaves the
 * default timing in place. Defining them explicitly is what makes the tokens
 * above reachable from markup.
 */
@utility duration-fast {
	transition-duration: var(--duration-fast);
}

@utility duration-base {
	transition-duration: var(--duration-base);
}

@utility duration-slow {
	transition-duration: var(--duration-slow);
}

@layer base {
	html {
		background-color: var(--canvas);
	}

	body {
		background-color: var(--canvas);
		color: var(--text);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
	}

	/* One focus treatment for the whole application, on the token rather
	 * than per component, so nothing can quietly ship without one. It is
	 * :focus-visible so a pointer click does not draw a ring, and it is an
	 * outline rather than a box-shadow so forced-colors mode keeps it. */
	:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* Placeholder text is text: it gets a token, not an opacity. */
	::placeholder {
		color: var(--text-subtle);
		opacity: 1;
	}

	/* Selection follows the accent rather than the browser default, which is
	 * unreadable on a dark surface. */
	::selection {
		background-color: var(--primary-soft);
		color: var(--primary-on-soft);
	}

	/*
	 * Reduced motion, enforced once for the whole application.
	 *
	 * This is a blanket rule rather than a per-component decision because a
	 * per-component decision is one somebody forgets, and the thing they
	 * forget is the thing that makes a reader nauseated. Every transition and
	 * animation collapses to a single frame instead of being removed: a
	 * transitionend or animationend listener still fires, so a component that
	 * waits for one to unmount an element does not hang forever — which is
	 * what `animation: none` would cause.
	 *
	 * Smooth scrolling goes too; it is motion the reader did not ask for and
	 * cannot interrupt.
	 *
	 * Motion that CSS cannot reach — a scripted scroll, a count-up, anything
	 * that advances on its own — reads `preferences.reducedMotion` from
	 * src/lib/theme.svelte.ts, which watches the same query.
	 */
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
}

/*
 * SvelteKit's client runtime creates an accessibility announcer,
 * <div id="svelte-announcer">, carrying a hard-coded inline style attribute
 * with the standard visually-hidden declarations. This application's
 * Content Security Policy has no style-src-attr 'unsafe-inline', so that
 * attribute is blocked and the announcer's route names would render
 * visibly on every client-side navigation. Restoring the geometry from
 * this external stylesheet — which style-src 'self' allows — is the fix.
 * Do not replace it with a policy waiver.
 */
#svelte-announcer {
	position: absolute !important;
	left: 0 !important;
	top: 0 !important;
	clip: rect(0 0 0 0) !important;
	clip-path: inset(50%) !important;
	overflow: hidden !important;
	white-space: nowrap !important;
	width: 1px !important;
	height: 1px !important;
}
