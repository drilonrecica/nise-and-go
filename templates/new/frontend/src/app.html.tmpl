<!doctype html>
<!-- Generated once by nise; owned by this application. Nise will not overwrite it. -->
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="%sveltekit.assets%/favicon.svg" />
		%sveltekit.head%
	</head>
	<!--
		data-theme above is always present and always resolved to "light" or
		"dark" — never "system", never absent. app.css keys both palettes and
		color-scheme off it, so the attribute is the whole theme mechanism.
		The static value here is only the pre-JavaScript default; the theme
		script replaces it before first paint.

		No literal style attribute may appear in this file or in a component.
		The Content Security Policy this application sends has no
		style-src-attr 'unsafe-inline', so an inline style attribute is
		blocked. Use a class or Svelte's style: directive, which compiles to
		CSSOM property writes that CSP does not govern.
	-->
	<body data-sveltekit-preload-data="hover">
		<div>%sveltekit.body%</div>
	</body>
</html>
