// Generated once by nise; owned by this application. Nise will not overwrite it.

import { describe, expect, expectTypeOf, it, vi } from 'vitest';

import {
	APIError,
	APITransportError,
	createAPIClient,
	readCSRFCookie,
	type APIFetch
} from './client';
import { problemCodes } from './problem';
import type { components } from './schema';

describe('API client', () => {
	it('returns the direct resource without an envelope', async () => {
		const controller = new AbortController();
		const fetcher = vi.fn(
			async () =>
				new Response(JSON.stringify({ version: 'v1' }), {
					status: 200,
					headers: { 'content-type': 'application/json' }
				})
		);
		const client = createAPIClient({ fetch: fetcher as APIFetch });

		await expect(client.get('/', { signal: controller.signal })).resolves.toEqual({ version: 'v1' });
		expect(fetcher).toHaveBeenCalledOnce();
		expect(fetcher).toHaveBeenCalledWith('/api/v1/', {
			method: 'GET',
			credentials: 'same-origin',
			headers: { Accept: 'application/json, application/problem+json' },
			body: undefined,
			signal: controller.signal
		});
	});

	it('maps HTTP failures without exposing their body in the message', async () => {
		const problem = {
			type: 'urn:problem:invalid',
			detail: 'private decoder detail'
		};
		const fetcher: APIFetch = async () =>
			new Response(JSON.stringify(problem), {
				status: 422,
				headers: {
					'content-type': 'application/problem+json; charset=utf-8',
					'x-request-id': 'req_123'
				}
			});
		const client = createAPIClient({ fetch: fetcher });

		const error = await client.get('/').catch((caught: unknown) => caught);
		expect(error).toBeInstanceOf(APIError);
		expect(error).toMatchObject({ status: 422, requestID: 'req_123', body: problem });
		expect((error as Error).message).toBe('API request failed with status 422');
		expect((error as Error).message).not.toContain(problem.detail);
	});

	it('maps network failures without exposing their cause in the message', async () => {
		const cause = new Error('failed beside /srv/private with secret-value');
		const client = createAPIClient({
			fetch: async () => {
				throw cause;
			}
		});

		const error = await client.get('/').catch((caught: unknown) => caught);
		expect(error).toBeInstanceOf(APITransportError);
		expect(error).toMatchObject({ cause });
		expect((error as Error).message).toBe('API request could not be completed');
		expect((error as Error).message).not.toContain('secret-value');
	});

	it('preserves cancellation errors', async () => {
		const cancellation = new DOMException('cancelled', 'AbortError');
		const client = createAPIClient({
			fetch: async () => {
				throw cancellation;
			}
		});

		await expect(client.get('/')).rejects.toBe(cancellation);
	});

	it('exposes only generated paths and methods to TypeScript', () => {
		const client = createAPIClient({ fetch: async () => new Response(null, { status: 204 }) });
		const collection = {
			items: [],
			page: { has_more: false }
		} satisfies components['schemas']['APIRootCollection'];
		expect(collection).toEqual({ items: [], page: { has_more: false } });

		if (false) {
			expectTypeOf(client.get('/')).toEqualTypeOf<
				Promise<components['schemas']['APIRoot']>
			>();
			// @ts-expect-error collection items are required and never null.
			void ({ items: null, page: { has_more: false } } satisfies components['schemas']['APIRootCollection']);
			// @ts-expect-error collection page metadata is required and never null.
			void ({ items: [], page: null } satisfies components['schemas']['APIRootCollection']);
			// @ts-expect-error collection items cannot be omitted.
			void ({ page: { has_more: false } } satisfies components['schemas']['APIRootCollection']);
			// @ts-expect-error generic envelope members are not in the collection contract.
			void ({ items: [], page: { has_more: false }, data: [] } satisfies components['schemas']['APIRootCollection']);
			// @ts-expect-error /missing is not in the generated OpenAPI paths.
			void client.get('/missing');
			// @ts-expect-error the generated root path has no POST operation.
			void client.request('post', '/');
		}
	});

	it('types cursor pages as opaque tokens that are absent, never null', () => {
		const firstPage: components['schemas']['APIRootCursorCollection'] = {
			items: [],
			page: { has_more: true, next_cursor: 'nc1.y2026a.eyJ9.Zm9v' }
		};
		expect(firstPage.page.next_cursor).toBeTypeOf('string');

		const lastPage: components['schemas']['APIRootCursorCollection'] = {
			items: [],
			page: { has_more: false }
		};
		expect(lastPage.page.next_cursor).toBeUndefined();
		expect(Object.hasOwn(lastPage.page, 'next_cursor')).toBe(false);

		if (false) {
			expectTypeOf<components['schemas']['Cursor']>().toEqualTypeOf<string>();
			expectTypeOf<components['schemas']['CursorPage']>().not.toEqualTypeOf<
				components['schemas']['Page']
			>();
			// @ts-expect-error an absent cursor is omitted, never null.
			void ({ items: [], page: { has_more: false, next_cursor: null } } satisfies components['schemas']['APIRootCursorCollection']);
			// @ts-expect-error has_more is required on every cursor page.
			void ({ items: [], page: {} } satisfies components['schemas']['APIRootCursorCollection']);
			// @ts-expect-error offset members do not belong to the cursor contract.
			void ({ items: [], page: { has_more: false, total: 0 } } satisfies components['schemas']['APIRootCursorCollection']);
			// @ts-expect-error a cursor page is not interchangeable with the neutral page.
			void ({ items: [], page: { has_more: false, next_cursor: 'nc1.a.b.c' } } satisfies components['schemas']['APIRootCollection']);
		}
	});

	it('types report pages as a separate page/size/total contract', () => {
		const report: components['schemas']['APIRootReportCollection'] = {
			items: [],
			page: { page: 2, size: 25, total: 51, total_pages: 3, has_more: true }
		};
		expect(report.page.total_pages).toBe(3);

		if (false) {
			expectTypeOf<components['schemas']['ReportPage']>().not.toEqualTypeOf<
				components['schemas']['CursorPage']
			>();
			// @ts-expect-error every reporting member is required.
			void ({ items: [], page: { page: 1, size: 25 } } satisfies components['schemas']['APIRootReportCollection']);
			// @ts-expect-error cursor members do not belong to the reporting contract.
			void ({ items: [], page: { page: 1, size: 25, total: 0, total_pages: 0, has_more: false, next_cursor: 'nc1.a.b.c' } } satisfies components['schemas']['APIRootReportCollection']);
			// @ts-expect-error a cursor page cannot stand in for a report page.
			void ({ items: [], page: { has_more: false } } satisfies components['schemas']['APIRootReportCollection']);
			// @ts-expect-error a report total is a number, never null for an empty report.
			void ({ items: [], page: { page: 1, size: 25, total: null, total_pages: 0, has_more: false } } satisfies components['schemas']['APIRootReportCollection']);
		}
	});

	it('parses a valid Problem body and exposes its code', async () => {
		const problem: components['schemas']['Problem'] = {
			type: '/problems/permission-denied',
			title: 'Permission denied',
			status: 403,
			detail: 'This account may not perform that action.',
			code: problemCodes.permissionDenied,
			request_id: 'req_abc',
			correlation_id: 'cor_abc'
		};
		const client = createAPIClient({
			fetch: async () =>
				new Response(JSON.stringify(problem), {
					status: 403,
					headers: { 'content-type': 'application/problem+json' }
				})
		});

		const error = (await client.get('/').catch((caught: unknown) => caught)) as APIError;
		expect(error.problem).toEqual(problem);
		expect(error.code).toBe(problemCodes.permissionDenied);
		// The problem's own request id wins over the header, and is present
		// even when a proxy stripped the header.
		expect(error.requestID).toBe('req_abc');
	});

	it('leaves problem null for a body that does not validate', async () => {
		const client = createAPIClient({
			fetch: async () =>
				new Response(JSON.stringify({ title: 'Nope', status: 500 }), {
					status: 500,
					headers: { 'content-type': 'application/problem+json' }
				})
		});

		const error = (await client.get('/').catch((caught: unknown) => caught)) as APIError;
		expect(error.problem).toBeNull();
		expect(error.code).toBeNull();
		expect(error.status).toBe(500);
	});

	it('sends the anti-forgery header on a state-changing request and not on a read', async () => {
		const calls: RequestInit[] = [];
		const client = createAPIClient({
			csrfToken: () => 'csrf-token-value',
			fetch: async (_input, init) => {
				calls.push(init ?? {});
				return new Response(null, { status: 204 });
			}
		});

		await client.get('/');
		await client.request('delete' as never, '/' as never).catch(() => undefined);

		expect((calls[0].headers as Record<string, string>)['X-CSRF-Token']).toBeUndefined();
		expect((calls[1].headers as Record<string, string>)['X-CSRF-Token']).toBe('csrf-token-value');
	});

	it('does not refuse a state change locally when the anti-forgery cookie is missing', async () => {
		// The server decides: an unauthenticated state change is protected by
		// Origin and Fetch Metadata instead. Refusing here would be a second,
		// divergent copy of a server-side policy.
		const calls: RequestInit[] = [];
		const client = createAPIClient({
			csrfToken: () => null,
			fetch: async (_input, init) => {
				calls.push(init ?? {});
				return new Response(null, { status: 204 });
			}
		});

		await client.request('post' as never, '/' as never).catch(() => undefined);
		expect(calls).toHaveLength(1);
		expect((calls[0].headers as Record<string, string>)['X-CSRF-Token']).toBeUndefined();
	});

	it('sends an idempotency key and a JSON content type only when there is a body', async () => {
		const calls: RequestInit[] = [];
		const client = createAPIClient({
			csrfToken: () => 'token',
			fetch: async (_input, init) => {
				calls.push(init ?? {});
				return new Response(null, { status: 204 });
			}
		});

		await client
			.request('post' as never, '/' as never, {
				idempotencyKey: 'key-0123456789',
				body: { name: 'Ada' }
			} as never)
			.catch(() => undefined);

		const headers = calls[0].headers as Record<string, string>;
		expect(headers['Idempotency-Key']).toBe('key-0123456789');
		expect(headers['Content-Type']).toBe('application/json');
		expect(calls[0].body).toBe('{"name":"Ada"}');
	});

	it('builds the query, omitting absent values and repeating an array', async () => {
		const urls: string[] = [];
		const client = createAPIClient({
			fetch: async (input) => {
				urls.push(String(input));
				return new Response(JSON.stringify({ version: 'v1' }), {
					status: 200,
					headers: { 'content-type': 'application/json' }
				});
			}
		});

		await client.get('/', {
			query: { limit: 25, after: undefined, status: ['open', 'closed'], q: null }
		} as never);

		expect(urls[0]).toBe('/api/v1/?limit=25&status=open&status=closed');
	});
});

describe('readCSRFCookie', () => {
	it('reads the anti-forgery cookie by exact name', () => {
		expect(readCSRFCookie('__Host-session_csrf=abc123')).toBe('abc123');
		expect(readCSRFCookie('other=1; __Host-session_csrf=abc123; more=2')).toBe('abc123');
	});

	it('reads the unprefixed name a development origin uses', () => {
		// The session cookie gives up __Host- when SESSION_COOKIE_INSECURE is
		// set, and the anti-forgery cookie is named after it. Production
		// refuses that setting, so this name only appears where the prefix was
		// already given up deliberately.
		expect(readCSRFCookie('session_csrf=devvalue')).toBe('devvalue');
	});

	it('prefers the hardened name when a document carries both', () => {
		expect(readCSRFCookie('session_csrf=old; __Host-session_csrf=current')).toBe('current');
	});

	it('does not match a cookie whose name merely ends with the right characters', () => {
		// Matching loosely is how a value an attacker could set gets echoed
		// into the header the server trusts.
		expect(readCSRFCookie('x__Host-session_csrf=attacker')).toBeNull();
		expect(readCSRFCookie('__Host-session_csrf_other=attacker')).toBeNull();
		expect(readCSRFCookie('xsession_csrf=attacker')).toBeNull();
		expect(readCSRFCookie('session_csrf_other=attacker')).toBeNull();
	});

	it('is null when there is no cookie, or it is empty', () => {
		expect(readCSRFCookie('')).toBeNull();
		expect(readCSRFCookie(undefined)).toBeNull();
		expect(readCSRFCookie('__Host-session_csrf=')).toBeNull();
		expect(readCSRFCookie('session_csrf=')).toBeNull();
	});
});
