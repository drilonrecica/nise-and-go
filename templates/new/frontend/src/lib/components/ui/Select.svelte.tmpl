		children: Snippet;
	} & Omit<HTMLSelectAttributes, 'value'> = $props();
</script>

<!--
	The native <select>, deliberately. A custom listbox has to reimplement
	type-ahead, the mobile picker, and the platform's own keyboard model, and
	it is never as good as the one the operating system already ships. When a
	select genuinely needs search or multi-selection, build that component for
	that case rather than replacing every select in the application.
-->
<div class="relative">
	<select
		bind:value
		aria-invalid={invalid || undefined}
		aria-describedby={describedBy}
		class="h-control-md w-full appearance-none rounded-md border bg-surface pr-9 pl-3 text-sm text-text transition-colors duration-fast ease-standard disabled:cursor-not-allowed disabled:bg-surface-muted disabled:text-text-subtle {invalid
