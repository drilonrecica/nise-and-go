			: 'border-control-line'}"
		{...rest}
	>
		{@render children()}
	</select>
	<Icon
		name="chevronDown"
		class="pointer-events-none absolute end-3 top-1/2 size-4 -translate-y-1/2 text-text-subtle"
	/>
</div>
