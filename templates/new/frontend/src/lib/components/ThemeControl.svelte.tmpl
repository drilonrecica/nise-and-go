<!-- Generated once by nise; owned by this application. Nise will not overwrite it. -->
<script lang="ts">
	import { preferences, themePreferences, type ThemePreference } from '$lib/theme.svelte';

	let { id = 'theme-control' }: { id?: string } = $props();

	const labels: Record<ThemePreference, string> = {
		light: 'Light',
		dark: 'Dark',
		system: 'System'
	};
</script>

<!--
	Three radio inputs in a fieldset, not a listbox and not a button that
	cycles. The control has three mutually exclusive values, which is what a
	radio group is; the browser then supplies arrow-key navigation, the group
	name for a screen reader, and the selected state, none of which this file
	has to reimplement or get wrong.

	The inputs are visually replaced by their labels rather than hidden with
	`display: none`, which would take them out of the accessibility tree and
	off the keyboard.
-->
<fieldset class="inline-flex items-center gap-1 rounded-md border border-line bg-surface p-0.5">
	<legend class="sr-only">Theme</legend>
	{#each themePreferences as preference (preference)}
		<div class="relative">
			<input
				class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0"
				type="radio"
				id="{id}-{preference}"
				name={id}
				value={preference}
				checked={preferences.preference === preference}
				onchange={() => preferences.set(preference)}
			/>
			<label
				class="block cursor-pointer rounded-sm px-2.5 py-1 text-xs font-medium text-text-muted transition-colors duration-fast ease-standard select-none peer-checked:bg-primary-soft peer-checked:text-primary-on-soft peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring hover:text-text"
				for="{id}-{preference}">{labels[preference]}</label
			>
		</div>
	{/each}
</fieldset>
