# Generated once by nise; owned by this application. Nise will not overwrite it.

openapi: 3.0.3
info:
  title: "{{.AppName}} API"
  version: 1.0.0
  description: "The authoritative HTTP transport contract for {{.AppName}}."
servers:
  - url: /api/v1
paths:
  /:
    get:
      operationId: getAPIIndex
      summary: Describe the versioned API boundary
      responses:
        "200":
          description: The API boundary resource.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIRoot'
  /session:
    get:
      operationId: getCurrentSession
      summary: Describe the session making this request
      responses:
        "200":
          description: The signed-in account and its session.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
        "401":
          $ref: '#/components/responses/Problem'
    post:
      operationId: signIn
      summary: Exchange an address and password for a session
      description: >-
        A correct password may finish the sign-in or open a second-factor
        challenge. Both are the same 200 response carrying a required status
        discriminator, so a client cannot read the body without deciding which
        of the two happened; `session` and `challenge` are each present only
        for their own status.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SignInRequest'
      responses:
        "200":
          description: The password was correct. Read status to learn what to do next.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SignInResult'
        "401":
          $ref: '#/components/responses/Problem'
        "429":
          $ref: '#/components/responses/Problem'
    delete:
      operationId: signOut
      summary: End the session making this request
      responses:
        "204":
          description: The session is revoked and its cookies are cleared.
        "401":
          $ref: '#/components/responses/Problem'
  /session/second-factor:
    post:
      operationId: completeSecondFactor
      summary: Finish a sign-in that opened a second-factor challenge
      description: >-
        The challenge token identifies the unfinished sign-in; it is not a
        session and authenticates nothing else. An application with no
        second-factor module refuses this operation, which is why the
        operation exists in every application: enabling the module is a
        recompile rather than a change to this contract.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SecondFactorRequest'
      responses:
        "200":
          description: The second step verified and a session was issued.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
        "401":
          $ref: '#/components/responses/Problem'
        "429":
          $ref: '#/components/responses/Problem'
  /sessions:
    get:
      operationId: listSessions
      summary: List the signed-in account's own sessions
      responses:
        "200":
          description: Every live session this account holds.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionSummaryCollection'
        "401":
          $ref: '#/components/responses/Problem'
    delete:
      operationId: revokeOtherSessions
      summary: End every session except the one making this request
      responses:
        "200":
          description: How many sessions were ended.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RevocationResult'
        "401":
          $ref: '#/components/responses/Problem'
  /sessions/{sessionId}:
    delete:
      operationId: revokeSession
      summary: End one of the signed-in account's sessions
      parameters:
        - name: sessionId
          in: path
          required: true
          schema:
            type: string
            minLength: 1
            maxLength: 64
            pattern: '^[A-Za-z0-9-]+$'
      responses:
        "204":
          description: The session is revoked.
        "401":
          $ref: '#/components/responses/Problem'
        "404":
          $ref: '#/components/responses/Problem'
  /account/password:
    post:
      operationId: changePassword
      summary: Change the signed-in account's password
      description: >-
        The current password is the proof, and every other session is ended so
        that a password change is also a way to evict whoever else is holding
        one.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
      responses:
        "204":
          description: The password was changed and other sessions were ended.
        "401":
          $ref: '#/components/responses/Problem'
        "422":
          $ref: '#/components/responses/Problem'
  /invitations/accept:
    post:
      operationId: acceptInvitation
      summary: Turn an invitation into an account
      description: >-
        The token is single-use and is spent by this call. It answers with the
        address the account was created for, so the sign-in form that follows
        can be filled in without the caller having to know it.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
      responses:
        "201":
          description: The account was created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AcceptedInvitation'
        "400":
          $ref: '#/components/responses/Problem'
        "422":
          $ref: '#/components/responses/Problem'
components:
  schemas:
    Account:
      type: object
      additionalProperties: false
      description: One identity, without its credential.
      required:
        - id
        - email
        - status
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 64
          pattern: '^[A-Za-z0-9-]+$'
        email:
          type: string
          maxLength: 320
        status:
          type: string
          enum:
            - active
            - disabled
    Session:
      type: object
      additionalProperties: false
      description: >-
        The signed-in account and the session carrying it. The session token
        itself is never in a body: it is written to a hardened cookie and
        exists nowhere else.
      required:
        - account
        - session_id
        - expires_at
        - proven_at
      properties:
        account:
          $ref: '#/components/schemas/Account'
        session_id:
          type: string
          minLength: 1
          maxLength: 64
          pattern: '^[A-Za-z0-9-]+$'
        expires_at:
          type: string
          format: date-time
        proven_at:
          type: string
          format: date-time
          description: When the holder last proved their identity with a password.
    SignInResult:
      type: object
      additionalProperties: false
      description: >-
        What a correct password produced. status is required and is the only
        member a client may read unconditionally.
      required:
        - status
      properties:
        status:
          type: string
          enum:
            - signed_in
            - second_factor_required
        session:
          $ref: '#/components/schemas/Session'
        challenge:
          $ref: '#/components/schemas/SecondFactorChallenge'
    SecondFactorChallenge:
      type: object
      additionalProperties: false
      description: >-
        An unfinished sign-in. The token identifies that attempt and nothing
        else: it is not a session, it authenticates no other request, and it is
        spent by the first correct answer.
      required:
        - token
        - expires_at
      properties:
        token:
          type: string
          maxLength: 512
        expires_at:
          type: string
          format: date-time
    SignInRequest:
      type: object
      additionalProperties: false
      required:
        - email
        - password
      properties:
        email:
          type: string
          minLength: 3
          maxLength: 320
        password:
          type: string
          minLength: 1
          maxLength: 4096
    SecondFactorRequest:
      type: object
      additionalProperties: false
      required:
        - challenge_token
        - code
      properties:
        challenge_token:
          type: string
          minLength: 1
          maxLength: 512
        code:
          type: string
          minLength: 1
          maxLength: 64
    SessionSummary:
      type: object
      additionalProperties: false
      description: One row of the account's own session list.
      required:
        - id
        - created_at
        - last_seen_at
        - expires_at
        - current
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 64
          pattern: '^[A-Za-z0-9-]+$'
        created_at:
          type: string
          format: date-time
        last_seen_at:
          type: string
          format: date-time
        expires_at:
          type: string
          format: date-time
        current:
          type: boolean
          description: Whether this is the session making the request.
    SessionSummaryCollection:
      type: object
      additionalProperties: false
      required:
        - items
        - page
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/SessionSummary'
        page:
          $ref: '#/components/schemas/Page'
    RevocationResult:
      type: object
      additionalProperties: false
      required:
        - revoked
      properties:
        revoked:
          type: integer
          format: int64
          minimum: 0
    ChangePasswordRequest:
      type: object
      additionalProperties: false
      required:
        - current_password
        - new_password
      properties:
        current_password:
          type: string
          minLength: 1
          maxLength: 4096
        new_password:
          type: string
          minLength: 1
          maxLength: 4096
    AcceptInvitationRequest:
      type: object
      additionalProperties: false
      required:
        - token
        - password
      properties:
        token:
          type: string
          minLength: 1
          maxLength: 512
        password:
          type: string
          minLength: 1
          maxLength: 4096
    AcceptedInvitation:
      type: object
      additionalProperties: false
      required:
        - email
      properties:
        email:
          type: string
          maxLength: 320
    APIRoot:
      type: object
      additionalProperties: false
      description: The direct resource returned by the versioned API root.
      required:
        - version
      properties:
        version:
          type: string
          enum:
            - v1
    Page:
      type: object
      additionalProperties: false
      description: Neutral pagination metadata for a collection with no paging strategy of its own.
      required:
        - has_more
      properties:
        has_more:
          type: boolean
    CursorPage:
      type: object
      additionalProperties: false
      description: >-
        Cursor pagination metadata. has_more reports whether another page exists
        in the direction this page was read. A cursor member is absent, never
        null, when there is no page in that direction.
      required:
        - has_more
      properties:
        has_more:
          type: boolean
        next_cursor:
          $ref: '#/components/schemas/Cursor'
        prev_cursor:
          $ref: '#/components/schemas/Cursor'
    ReportPage:
      type: object
      additionalProperties: false
      description: >-
        Offset reporting pagination metadata, for reports where a page number
        is something a person quotes and a total is something they need. It is
        a separate contract from CursorPage, never a variant of it.
      required:
        - page
        - size
        - total
        - total_pages
        - has_more
      properties:
        page:
          type: integer
          format: int32
          minimum: 1
          maximum: 100000
        size:
          type: integer
          format: int32
          minimum: 1
          maximum: 200
        total:
          type: integer
          format: int64
          minimum: 0
        total_pages:
          type: integer
          format: int64
          minimum: 0
        has_more:
          type: boolean
    Cursor:
      type: string
      description: >-
        An opaque authenticated position token. Return it verbatim in after or
        before; never parse, construct, or store it beyond the current listing.
      minLength: 1
      maxLength: 4096
    APIRootCollection:
      type: object
      additionalProperties: false
      description: A concrete collection contract fixture; domain collections define their own schemas.
      required:
        - items
        - page
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/APIRoot'
        page:
          $ref: '#/components/schemas/Page'
    APIRootReportCollection:
      type: object
      additionalProperties: false
      description: A concrete offset-paginated reporting collection fixture; domain reports define their own schemas.
      required:
        - items
        - page
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/APIRoot'
        page:
          $ref: '#/components/schemas/ReportPage'
    APIRootCursorCollection:
      type: object
      additionalProperties: false
      description: A concrete cursor-paginated collection fixture; domain collections define their own schemas.
      required:
        - items
        - page
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/APIRoot'
        page:
          $ref: '#/components/schemas/CursorPage'
    Problem:
      type: object
      additionalProperties: false
      description: RFC 9457 Problem Details with the application's controlled extensions.
      required:
        - type
        - title
        - status
        - detail
        - code
        - request_id
        - correlation_id
      properties:
        type:
          type: string
          format: uri-reference
          minLength: 1
          maxLength: 2048
          pattern: '^([A-Za-z][A-Za-z0-9+.-]*:|/$|/[^/])'
        title:
          type: string
          minLength: 1
          maxLength: 256
        status:
          type: integer
          format: int32
          minimum: 400
          maximum: 599
        detail:
          type: string
          minLength: 1
          maxLength: 4096
        instance:
          type: string
          format: uri-reference
          maxLength: 2048
        code:
          type: string
          pattern: '^[a-z][a-z0-9_]{2,63}$'
        request_id:
          type: string
          minLength: 1
          maxLength: 128
          pattern: '^[A-Za-z0-9_-]+$'
        correlation_id:
          type: string
          minLength: 1
          maxLength: 128
          pattern: '^[A-Za-z0-9_-]+$'
  parameters:
    CursorLimit:
      name: limit
      in: query
      required: false
      description: >-
        Page size. Absent means the collection's default. A value outside
        1..200, or outside the collection's own smaller maximum, is refused
        rather than clamped.
      schema:
        type: integer
        format: int32
        minimum: 1
        maximum: 200
    CursorAfter:
      name: after
      in: query
      required: false
      description: >-
        Read the page following this cursor. Only a cursor this collection
        issued as next_cursor is accepted; it cannot be combined with before.
      schema:
        $ref: '#/components/schemas/Cursor'
    CursorBefore:
      name: before
      in: query
      required: false
      description: >-
        Read the page preceding this cursor. Only a cursor this collection
        issued as prev_cursor is accepted; it cannot be combined with after.
      schema:
        $ref: '#/components/schemas/Cursor'
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      description: >-
        A client-generated key that makes this command safe to retry. Reuse the
        same key for every retry of the same request and a new key for a new
        request; a key replayed with a different body is refused. Recorded
        responses are replayable for a bounded retention window.
      schema:
        type: string
        minLength: 8
        maxLength: 255
        pattern: '^[!-~]+$'
    ReportPageNumber:
      name: page
      in: query
      required: false
      description: >-
        1-based page number. Absent means the first page. A page whose first
        row is past the report's offset ceiling is refused rather than served
        slowly.
      schema:
        type: integer
        format: int32
        minimum: 1
        maximum: 100000
    ReportPageSize:
      name: size
      in: query
      required: false
      description: >-
        Report page size. Absent means the report's default. Out of range is
        refused rather than clamped. It cannot be combined with the cursor
        parameters.
      schema:
        type: integer
        format: int32
        minimum: 1
        maximum: 200
  responses:
    Problem:
      description: The request failed with an RFC 9457 Problem Details response.
      content:
        application/problem+json:
          schema:
            $ref: '#/components/schemas/Problem'
