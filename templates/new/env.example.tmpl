# Generated once by nise; owned by this application. Nise will not overwrite it.
#
# Every variable this application reads, with a safe placeholder value.
# Copy this file to .env for local use; .env is git-ignored and is never
# read by the application itself — runtime/config reads only the process
# environment, so export these or let your shell tooling do it.
#
# Any variable below may instead be supplied as <NAME>_FILE naming a file
# whose contents are the value, but only for the secrets marked as such.
# Setting both <NAME> and <NAME>_FILE at once is always an error.

# Deployment environment: development, test, or production.
# There is no fourth value and no default beyond "development".
APP_ENV=development

# Default process mode when the binary is started without -mode:
# all (web + worker), web (HTTP only), or worker (no HTTP port bound).
APP_MODE=all

# Listen address. Production refuses to bind every interface unless
# ALLOW_PUBLIC_BIND is also set.
BIND_ADDR=127.0.0.1
PORT=8080
ALLOW_PUBLIC_BIND=false

# Logging. LOG_FORMAT is json or text; production requires json.
LOG_LEVEL=info
LOG_FORMAT=text

# Developer-facing behavior. Production requires this to be false.
DEBUG=false

# Adopt inbound X-Request-Id and X-Correlation-Id headers instead of always
# generating them. Enable this only behind an ingress that sanitizes them.
TRUST_PROXY_HEADERS=false

# Secret. Gates the operator-only endpoints (/internal/metrics and the
# detailed readiness report). When it is unset those endpoints are not
# mounted at all, in every environment. Generate a real value with:
#   openssl rand -base64 32
# Also accepted as OPERATOR_TOKEN_FILE, naming a file holding the value.
OPERATOR_TOKEN=

# PostgreSQL is mandatory. nise dev supplies its managed local database URL
# to the child process automatically; set this when running the binary
# directly. DATABASE_URL_FILE is also accepted.
DATABASE_URL=postgres://{{.AppName}}:password@127.0.0.1:5432/{{.AppName}}?sslmode=disable

# Optional secret. When set, this exact value overrides any password inside
# DATABASE_URL. Compose uses it so URL-reserved password characters are safe.
DATABASE_PASSWORD=

# Conservative pool defaults. Increase DB_MAX_CONNS only after accounting
# for every application replica and PostgreSQL's server connection budget.
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s

# Secret. Signs the opaque pagination cursors the API issues, as
# <id>:<base64 secret>. The identifier is public and travels in every cursor;
# the secret must be at least 32 bytes. Generate one with:
#   echo "y2026a:$(openssl rand -base64 32)"
# Leaving it unset generates a random key for each process, which is fine on a
# development machine and refused in production because every restart and every
# replica would then reject cursors the others issued.
# Also accepted as CURSOR_SIGNING_KEY_FILE.
CURSOR_SIGNING_KEY=

# Optional secret. Comma-separated verification-only cursor keys, in the same
# <id>:<base64 secret> form. To rotate without breaking outstanding cursors,
# move the current CURSOR_SIGNING_KEY here, set a new signing key, and remove
# this entry once CURSOR_TTL has elapsed.
CURSOR_RETIRED_KEYS=

# How long an issued cursor stays valid. At most 24h.
CURSOR_TTL=1h

# Query metrics use bounded operation labels, never raw SQL. Queries at or
# above this duration emit a warning without SQL, arguments, or result data.
DB_SLOW_QUERY_THRESHOLD=250ms

# deploy/compose.yaml requires this value for PostgreSQL and passes it to the
# application as DATABASE_PASSWORD. It is not read under this name by the
# application.
POSTGRES_PASSWORD=your-password-here
