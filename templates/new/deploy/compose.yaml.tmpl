# Generated once by nise; owned by this application. Nise will not overwrite it.
#
# Run from the repository root:
#
#   export POSTGRES_PASSWORD="$(openssl rand -base64 24)"
#   export CURSOR_SIGNING_KEY="k1:$(openssl rand -base64 32)"
#   docker compose -f deploy/compose.yaml up --build
#
# This runs the application the way production does — APP_ENV=production, so
# every fail-closed check applies. That is deliberate: a recipe that runs in
# development mode proves the image starts and proves nothing about whether
# your deployment will.
#
# The `:?` on each secret below is Compose's own "fail if unset". It is used
# rather than a default because a default for a signing key is a signing key
# everybody who copied this file shares.

services:
  # Migrations run as their own service, to completion, before the
  # application starts. They are not run by the application on startup, and
  # that is a decision rather than an omission: an application that migrates
  # when it boots migrates once per replica, concurrently, during a rolling
  # deploy — and the second replica's migration runs against a schema the
  # first one is halfway through changing.
  #
  # Running them here also makes the failure legible. A migration that fails
  # stops the deploy with the migration's own error, rather than starting an
  # application that refuses to serve for a reason somebody has to go and
  # find.
  migrate:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    command: ["db", "migrate"]
    environment:
      APP_ENV: production
      LOG_FORMAT: json
      DATABASE_URL: postgres://{{.AppName}}@db:5432/{{.AppName}}?sslmode=disable
      DATABASE_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      # The migration step loads the same configuration as the application,
      # so production's required settings apply to it too.
      CURSOR_SIGNING_KEY: ${CURSOR_SIGNING_KEY:?set CURSOR_SIGNING_KEY, e.g. k1:$(openssl rand -base64 32)}
      MAIL_TRANSPORT: ${MAIL_TRANSPORT:-smtp}
      MAIL_FROM: ${MAIL_FROM:-noreply@localhost}
      SMTP_HOST: ${SMTP_HOST:-localhost}
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    ports:
      - "8080:8080"
    environment:
      APP_ENV: production
      APP_MODE: all
      BIND_ADDR: 0.0.0.0
      # A container that binds only to loopback is a container nothing can
      # reach. The application refuses a public bind in production without
      # this exact opt-in; setting it here is that check working, because
      # inside a container the published ports are the boundary.
      ALLOW_PUBLIC_BIND: "true"
      PORT: "8080"
      LOG_FORMAT: json
      LOG_LEVEL: info
      DEBUG: "false"
{{- if .HasOrganizations}}
      # The application connects as {{.AppName}}_app, not as the role that owns
      # the tables. Row-level security does not apply to a table's owner, and
      # a superuser bypasses it outright — so an application running as either
      # has policies that are never consulted. It would start, pass every test
      # that checks the policies exist, and enforce nothing at all, which is
      # why production refuses to start that way rather than warning.
      #
      # The role is created by deploy/initdb/00-app-role.sh when the database
      # is first initialized, and the migrations' default privileges grant it
      # access to every table they create.
      DATABASE_URL: postgres://{{.AppName}}_app@db:5432/{{.AppName}}?sslmode=disable
      DATABASE_PASSWORD: ${APP_DB_PASSWORD:?set APP_DB_PASSWORD}
{{- else}}
      DATABASE_URL: postgres://{{.AppName}}@db:5432/{{.AppName}}?sslmode=disable
      DATABASE_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
{{- end}}
      DB_MAX_CONNS: "10"
      # Pagination cursors are signed. Without a configured key the process
      # generates one, and every restart and every replica then rejects
      # cursors the others issued — so production refuses to start without
      # it. Generate one with: openssl rand -base64 32
      CURSOR_SIGNING_KEY: ${CURSOR_SIGNING_KEY:?set CURSOR_SIGNING_KEY, e.g. k1:$(openssl rand -base64 32)}
      # Production refuses the log transport, because an application that
      # silently sends no invitations is worse than one that will not start.
      # Point these at a real relay before this recipe is more than a local
      # trial.
      MAIL_TRANSPORT: ${MAIL_TRANSPORT:-smtp}
      MAIL_FROM: ${MAIL_FROM:-noreply@localhost}
      SMTP_HOST: ${SMTP_HOST:-localhost}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_ENCRYPTION: ${SMTP_ENCRYPTION:-starttls}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD: ${SMTP_PASSWORD:-}
{{- if .HasUploads}}
    volumes:
      # Uploaded objects. The image creates this directory owned by the user
      # the process runs as, so the volume inherits that ownership — without
      # it the volume is created owned by root and the application fails at
      # startup, when it builds the object store, rather than at the first
      # upload.
      #
      # A local directory is the simplest thing that works and the least
      # durable: it lives on one host, is not backed up by the database
      # backup, and does not survive the machine. Point STORAGE_BACKEND at s3
      # before this recipe is more than a local trial.
      - object-storage:/var/lib/{{.AppName}}/storage
{{- end}}
    depends_on:
      db:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully

  db:
    image: docker.io/library/postgres:17.6-alpine
    environment:
      POSTGRES_USER: {{.AppName}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      POSTGRES_DB: {{.AppName}}
{{- if .HasOrganizations}}
      APP_DB_PASSWORD: ${APP_DB_PASSWORD:?set APP_DB_PASSWORD}
{{- end}}
    volumes:
      - postgres-data:/var/lib/postgresql/data
{{- if .HasOrganizations}}
      # Scripts here run once, when the data directory is first initialized —
      # so this creates the unprivileged role before the first migration, and
      # the default privileges it sets apply to every table the migrations go
      # on to create. Running it later would grant nothing on the tables that
      # already existed.
      #
      # The `z` is not decoration. On a host with SELinux enforcing — Fedora,
      # RHEL, and their derivatives — a bind mount the container has not been
      # granted access to is unreadable, and PostgreSQL fails to start with
      # "can't open /docker-entrypoint-initdb.d/: Permission denied" rather
      # than with anything about SELinux. It relabels the directory as
      # container-shareable; on a host without SELinux it is ignored.
      - ./initdb:/docker-entrypoint-initdb.d:ro,z
{{- end}}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready --quiet --username {{.AppName}} --dbname {{.AppName}}"]
      interval: 2s
      timeout: 2s
      retries: 30
      start_period: 10s

# No healthcheck is declared for the application service. Its runtime image is
# distroless: it carries no shell and no curl, so a Compose healthcheck would
# have to run the application binary against itself, which proves nothing an
# exited process does not already prove. Probe /readyz from outside instead —
# that is the endpoint your load balancer and orchestrator should both use.
#
{{if .HasOrganizations}}# Two database roles, and the split is the point. Migrations run as
# {{.AppName}}, which owns the tables; the application connects as
# {{.AppName}}_app, which owns nothing. Row-level security does not apply to a
# table's owner and does not apply to a superuser at all, so an application
# running as either has policies that are never consulted — and would enforce
# nothing while passing every test that checks the policies exist. Production
# refuses to start that way rather than warning, which is why this recipe has
# a second role rather than a comment recommending one. See
# docs/multitenancy.md.{{else}}# This recipe runs the application as the same role that owns the tables. That
# is fine here: without the organizations module there are no row-level
# security policies for an owner's exemption to bypass. Selecting that module
# changes this recipe to create a second, unprivileged role — see
# docs/multitenancy.md.{{end}}

volumes:
  postgres-data:{{if .HasUploads}}
  object-storage:{{end}}
