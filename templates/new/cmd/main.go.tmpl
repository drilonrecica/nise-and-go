// Generated once by nise; owned by this application. Nise will not overwrite it.

// Command {{.AppName}} is this application's single binary. Every process the
// deployment runs — the web server, the background worker, or both — is
// this binary in a different mode.
package main

import (
	"context"
	"encoding/json"
	"flag"
	"fmt"
	"io"
	"math"
	"os"
	"os/signal"
	"syscall"

	"{{.ModulePath}}/internal/app"
)

func main() {
	// The signal handler lives here, not in runtime/lifecycle: deciding
	// when to shut down is the application's job, and a runtime package
	// that installed its own would be hidden lifecycle behavior.
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	if err := run(ctx, os.Args[1:], os.Stdout); err != nil {
		fmt.Fprintf(os.Stderr, "{{.AppName}}: %v\n", err)
		os.Exit(1)
	}
}

func run(ctx context.Context, args []string, stdout io.Writer) error {
	if len(args) > 0 && args[0] == "db" {
		action, jsonOutput, err := parseDatabaseArgs(args[1:])
		if err != nil {
			return err
		}
		result, err := app.RunDatabase(ctx, action)
		if err != nil {
			return err
		}
		if jsonOutput {
			if err := json.NewEncoder(stdout).Encode(result); err != nil {
				return fmt.Errorf("encoding database result: %w", err)
			}
			return nil
		}
		_, err = fmt.Fprintln(stdout, result.String())
		return err
	}

	if len(args) > 0 && args[0] == "admin" {
		email, jsonOutput, err := parseAdminArgs(args[1:])
		if err != nil {
			return err
		}
		result, err := app.RunBootstrap(ctx, email)
		if err != nil {
			return err
		}
		if jsonOutput {
			if err := json.NewEncoder(stdout).Encode(result); err != nil {
				return fmt.Errorf("encoding bootstrap result: %w", err)
			}
			return nil
		}
		_, err = fmt.Fprintln(stdout, result.String())
		return err
	}

	if len(args) > 0 && args[0] == "password" {
		request, jsonOutput, err := parsePasswordArgs(args[1:])
		if err != nil {
			return err
		}
		result, err := app.RunPasswordBenchmark(request)
		if err != nil {
			return err
		}
		if jsonOutput {
			if err := json.NewEncoder(stdout).Encode(result); err != nil {
				return fmt.Errorf("encoding password benchmark result: %w", err)
			}
			return nil
		}
		_, err = fmt.Fprintln(stdout, result.String())
		return err
	}

	fs := flag.NewFlagSet("{{.AppName}}", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	mode := fs.String("mode", "", `process mode: "all", "web", or "worker" (default: $APP_MODE, or "all")`)
	if err := fs.Parse(args); err != nil {
		return fmt.Errorf("parse process flags: %w", err)
	}
	if fs.NArg() != 0 {
		return fmt.Errorf("unexpected argument %q; use db migrate, db status, password benchmark, or admin bootstrap", fs.Arg(0))
	}
	return app.Run(ctx, *mode)
}

// parseAdminArgs parses the administrator command surface.
//
// There is one action, and it works only on an empty directory: registration is
// closed, so this is how a deployment gets its first account and it stops
// working the moment it has one.
func parseAdminArgs(args []string) (email string, jsonOutput bool, err error) {
	if len(args) == 0 {
		return "", false, fmt.Errorf("admin action is required; use admin bootstrap --email <address>")
	}
	if args[0] != "bootstrap" {
		return "", false, fmt.Errorf("unknown admin action %q; use admin bootstrap", args[0])
	}

	fs := flag.NewFlagSet("admin bootstrap", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	fs.StringVar(&email, "email", "", "address to invite as the first administrator")
	fs.BoolVar(&jsonOutput, "json", false, "write one JSON result")
	if err := fs.Parse(args[1:]); err != nil {
		return "", false, fmt.Errorf("parse admin bootstrap flags: %w", err)
	}
	if fs.NArg() != 0 {
		return "", false, fmt.Errorf("admin bootstrap takes no positional arguments, found %q", fs.Arg(0))
	}
	if email == "" {
		return "", false, fmt.Errorf("admin bootstrap requires --email")
	}
	return email, jsonOutput, nil
}

// parsePasswordArgs parses the password command surface. Only one action
// exists; naming it anyway keeps room for later ones without changing how this
// one is invoked.
func parsePasswordArgs(args []string) (request app.PasswordBenchmarkRequest, jsonOutput bool, err error) {
	if len(args) == 0 {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("password action is required; use password benchmark")
	}
	if args[0] != "benchmark" {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("unknown password action %q; use password benchmark", args[0])
	}

	fs := flag.NewFlagSet("password benchmark", flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	memory := fs.Uint("memory", app.DefaultBenchmarkMemoryKiB, "argon2id memory cost in KiB, held fixed while passes are searched")
	parallelism := fs.Uint("parallelism", app.DefaultBenchmarkParallelism, "argon2id degree of parallelism, held fixed")
	target := fs.Duration("target", app.DefaultBenchmarkTarget, "per-login time budget the recommendation must stay inside")
	samples := fs.Int("samples", app.DefaultBenchmarkSamples, "evaluations per measurement; the median is reported")
	fs.BoolVar(&jsonOutput, "json", false, "write one JSON result")
	if err := fs.Parse(args[1:]); err != nil {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("parse password benchmark flags: %w", err)
	}
	if fs.NArg() != 0 {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("password benchmark takes no positional arguments, found %q", fs.Arg(0))
	}
	if *memory > math.MaxUint32 {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("-memory %d is larger than argon2id accepts", *memory)
	}
	if *parallelism > math.MaxUint8 {
		return app.PasswordBenchmarkRequest{}, false, fmt.Errorf("-parallelism %d is larger than argon2id accepts", *parallelism)
	}
	return app.PasswordBenchmarkRequest{
		MemoryKiB:   uint32(*memory),
		Parallelism: uint8(*parallelism),
		Target:      *target,
		Samples:     *samples,
	}, jsonOutput, nil
}

func parseDatabaseArgs(args []string) (action string, jsonOutput bool, err error) {
	if len(args) == 0 {
		return "", false, fmt.Errorf("database action is required; use db migrate or db status")
	}
	action = args[0]
	if action != "migrate" && action != "status" {
		return "", false, fmt.Errorf("unknown database action %q; use db migrate or db status", action)
	}
	fs := flag.NewFlagSet("db "+action, flag.ContinueOnError)
	fs.SetOutput(io.Discard)
	fs.BoolVar(&jsonOutput, "json", false, "write one JSON result")
	if err := fs.Parse(args[1:]); err != nil {
		return "", false, fmt.Errorf("parse db %s flags: %w", action, err)
	}
	if fs.NArg() != 0 {
		return "", false, fmt.Errorf("db %s takes no positional arguments, found %q", action, fs.Arg(0))
	}
	return action, jsonOutput, nil
}
