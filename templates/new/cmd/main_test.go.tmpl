// The two surfaces under `db` must not overlap: an action routed to the wrong
// one either loses its flags or reports the wrong result shape.
func TestTheTwoDatabaseSurfacesDoNotOverlap(t *testing.T) {
	t.Parallel()

	for _, action := range []string{"migrate", "status"} {
		if app.IsBackupAction(action) {
			t.Errorf("%q is routed to the backup surface", action)
		}
	}
	for _, action := range app.BackupActions {
		if _, _, err := parseDatabaseArgs([]string{action}); err == nil {
			t.Errorf("parseDatabaseArgs accepted %q, which belongs to the backup surface", action)
		}
	}
	// An unknown action must still name every action that exists, including
	// the ones added after that message was written.
	_, _, err := parseDatabaseArgs([]string{"repair"})
	if err == nil {
		t.Fatal("parseDatabaseArgs accepted an unknown action")
	}
	for _, action := range databaseActions {
		if !strings.Contains(err.Error(), action) {
			t.Errorf("the error for an unknown action does not mention %q: %v", action, err)
		}
	}
}

