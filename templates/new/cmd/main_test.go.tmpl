				}
				return
			}
			if err != nil {
				t.Fatalf("parseBackupArgs: %v", err)
			}
			if request != tc.want || jsonOutput != tc.wantJSON {
				t.Errorf("result = %+v/%v, want %+v/%v", request, jsonOutput, tc.want, tc.wantJSON)
