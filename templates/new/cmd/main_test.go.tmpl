func TestPasswordBenchmarkNeedsNoConfiguration(t *testing.T) {
	// Not parallel: it deliberately breaks the process environment to prove
	// the benchmark does not read it. The recommendation depends on this
	// host's CPU and memory and on nothing else, so the command must run on
	// a production machine without production credentials.
	t.Setenv("DATABASE_URL", "not a connection string")
	t.Setenv("APP_ENV", "not an environment")
	result, err := app.RunPasswordBenchmark(app.PasswordBenchmarkRequest{
		MemoryKiB:   app.DefaultBenchmarkMemoryKiB,
		Parallelism: 1,
		Target:      100 * time.Millisecond,
		Samples:     1,
	})
	if err != nil {
		t.Skipf("skipping: this machine cannot hash at the accepted floor within the budget: %v", err)
	}
	if result.Iterations < 1 || result.MeasuredMs > result.TargetMillis {
		t.Fatalf("result = %#v", result)
	}
	if !strings.Contains(result.String(), "recommended:") || !strings.Contains(result.String(), "current policy:") {
		t.Errorf("report lacks its recommendation or the current policy:\n%s", result.String())
	}
}
