			action: "backup",
			args:   []string{"-out", "/backups/today.backup"},
			want:   app.BackupRequest{Action: "backup", Path: "/backups/today.backup"},
		},
		{
			name:     "verify with JSON",
			action:   "verify",
			args:     []string{"-from", "/backups/today.backup", "-json"},
			want:     app.BackupRequest{Action: "verify", Path: "/backups/today.backup"},
			wantJSON: true,
		},
		{
			name:   "restore carries its confirmation",
			action: "restore",
			args:   []string{"-from", "/backups/today.backup", "-confirm", "myapp"},
			want:   app.BackupRequest{Action: "restore", Path: "/backups/today.backup", Confirmation: "myapp"},
		},
		// The path flag is named for the direction each command runs in, so
		// -out on a restore is a mistake worth catching rather than a synonym.
		{name: "backup without a path", action: "backup", args: nil, wantError: "requires -out"},
		{name: "verify without a path", action: "verify", args: nil, wantError: "requires -from"},
		{name: "restore given -out", action: "restore", args: []string{"-out", "/x"}, wantError: "flag provided but not defined"},
		{name: "backup given -confirm", action: "backup", args: []string{"-out", "/x", "-confirm", "myapp"}, wantError: "flag provided but not defined"},
		{name: "extra", action: "verify", args: []string{"-from", "/x", "extra"}, wantError: "takes no positional arguments"},
	}
	for _, tc := range tests {
