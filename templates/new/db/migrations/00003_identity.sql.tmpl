-- Generated once by nise; owned by this application. Nise will not overwrite it.
--
-- Identity and sessions. Every constraint here is a rule the application also
-- enforces; they are repeated in the schema because a bug in application code
-- must not be able to write a row the rest of the system cannot reason about.

-- +goose Up
CREATE TABLE users (
    id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    email         text NOT NULL,
    password_hash text NOT NULL,
    status        text NOT NULL DEFAULT 'active',
    created_at    timestamptz NOT NULL DEFAULT now(),
    updated_at    timestamptz NOT NULL DEFAULT now(),
    -- The address is stored already normalized, so lookups are a plain
    -- equality match on a plain index rather than a functional one, and two
    -- rows differing only in case cannot both exist.
    CONSTRAINT users_email_normalized CHECK (email = lower(email)),
    CONSTRAINT users_email_shape CHECK (position('@' IN email) > 1),
    CONSTRAINT users_email_length CHECK (char_length(email) BETWEEN 3 AND 320),
    CONSTRAINT users_password_hash_length CHECK (char_length(password_hash) BETWEEN 16 AND 512),
    CONSTRAINT users_status CHECK (status IN ('active', 'disabled'))
);

CREATE UNIQUE INDEX users_email_key ON users (email);

CREATE TABLE sessions (
    id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id        uuid NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    -- Only the digest is stored. A leak of this table hands nobody a working
    -- credential.
    token_digest   bytea NOT NULL,
    created_at     timestamptz NOT NULL,
    last_seen_at   timestamptz NOT NULL,
    -- The absolute deadline is written at issue, not derived from
    -- configuration, so changing the policy cannot extend or end a session
    -- that already exists.
    expires_at     timestamptz NOT NULL,
    revoked_at     timestamptz,
    revoked_reason text,
    CONSTRAINT sessions_token_digest_length CHECK (octet_length(token_digest) = 32),
    CONSTRAINT sessions_lifetime CHECK (expires_at > created_at),
    CONSTRAINT sessions_activity CHECK (last_seen_at >= created_at),
    CONSTRAINT sessions_revocation CHECK (
        (revoked_at IS NULL AND revoked_reason IS NULL)
        OR (revoked_at IS NOT NULL AND revoked_reason IS NOT NULL)
    ),
    CONSTRAINT sessions_revoked_reason_length CHECK (
        revoked_reason IS NULL OR char_length(revoked_reason) BETWEEN 1 AND 64
    )
);

CREATE UNIQUE INDEX sessions_token_digest_key ON sessions (token_digest);
CREATE INDEX sessions_user_id_created_at_idx ON sessions (user_id, created_at DESC);
CREATE INDEX sessions_expires_at_idx ON sessions (expires_at);

-- +goose Down
DROP TABLE sessions;
DROP TABLE users;
