// reviewedDirectPGXDB is the consumer-owned interface for one exceptional
// adapter. Exec is covered by pgx.QueryTracer and CopyFrom by
// pgx.CopyFromTracer. Deliberately omit Conn and PgConn: dropping to the wire
// connection would bypass the normal observation and transaction boundary.
type reviewedDirectPGXDB interface {
	Exec(context.Context, string, ...any) (pgconn.CommandTag, error)
	CopyFrom(context.Context, pgx.Identifier, []string, pgx.CopyFromSource) (int64, error)
}

var _ reviewedDirectPGXDB = (pgx.Tx)(nil)

const reviewedArchiveWidgetsSQL = `
	UPDATE widgets
	SET archived_at = clock_timestamp()
	WHERE id = ANY($1)`

// reviewedDirectPGXAdapter is an example, not a shared repository base. A real
// adapter belongs beside the feature that owns its SQL and receives the
// narrowest interface its exceptional operation needs.
type reviewedDirectPGXAdapter struct {
	db reviewedDirectPGXDB
}

func newReviewedDirectPGXAdapter(db reviewedDirectPGXDB) *reviewedDirectPGXAdapter {
	return &reviewedDirectPGXAdapter{db: db}
}

func (a *reviewedDirectPGXAdapter) archiveWidgets(ctx context.Context, ids []int64) (int64, error) {
	if len(ids) == 0 {
		return 0, nil
	}
	tag, err := a.db.Exec(ctx, reviewedArchiveWidgetsSQL, ids)
	if err != nil {
		return 0, fmt.Errorf("archive widgets with reviewed direct pgx adapter: %w", err)
	}
	return tag.RowsAffected(), nil
}

func (a *reviewedDirectPGXAdapter) copyWidgets(ctx context.Context, rows pgx.CopyFromSource) (int64, error) {
	count, err := a.db.CopyFrom(ctx, pgx.Identifier{"widgets"}, []string{"id", "name"}, rows)
	if err != nil {
		return 0, fmt.Errorf("copy widgets with reviewed direct pgx adapter: %w", err)
	}
	return count, nil
}

// reviewedBulkImport shows transaction ownership: the use case opens the
// boundary, then constructs the direct adapter with the callback's transaction.
func reviewedBulkImport(ctx context.Context, transactor *Transactor, rows pgx.CopyFromSource) error {
	return transactor.Within(ctx, transaction.Options{}, func(ctx context.Context, tx pgx.Tx) error {
		_, err := newReviewedDirectPGXAdapter(tx).copyWidgets(ctx, rows)
		return err
	})
}

