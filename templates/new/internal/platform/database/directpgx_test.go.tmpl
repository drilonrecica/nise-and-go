}

// directPGXProbeKey is this test's own context key type.
type directPGXProbeKey struct{}

func TestReviewedDirectPGXAdapter(t *testing.T) {
	t.Parallel()
	// A named type, not an anonymous empty struct: every anonymous struct{}
	// is the same type, so two packages using one as a context key would
	// silently read each other's values.
	ctx := context.WithValue(context.Background(), directPGXProbeKey{}, "sentinel")
	db := &recordingDirectPGXDB{}
	adapter := newReviewedDirectPGXAdapter(db)

	ids := []int64{11, 12}
	count, err := adapter.archiveWidgets(ctx, ids)
	if err != nil {
		t.Fatalf("archiveWidgets: %v", err)
	}
	if count != 2 || db.execContext != ctx || db.execSQL != reviewedArchiveWidgetsSQL || !reflect.DeepEqual(db.execArgs, []any{ids}) {
		t.Fatalf("archive call = count:%d context:%v SQL:%q args:%v", count, db.execContext == ctx, db.execSQL, db.execArgs)
	}

	sourceRows := make([][]any, 0, 2)
	sourceRows = append(sourceRows, []any{int64(11), "one"}, []any{int64(12), "two"})
	source := pgx.CopyFromRows(sourceRows)
	count, err = adapter.copyWidgets(ctx, source)
	if err != nil {
		t.Fatalf("copyWidgets: %v", err)
	}
	if count != 2 || db.copyContext != ctx || !reflect.DeepEqual(db.copyTable, pgx.Identifier{"widgets"}) || !reflect.DeepEqual(db.copyColumns, []string{"id", "name"}) || db.copySource != source {
		t.Fatalf("copy call = count:%d context:%v table:%v columns:%v", count, db.copyContext == ctx, db.copyTable, db.copyColumns)
	}

	db.execSQL = "not called"
	if count, err := adapter.archiveWidgets(ctx, nil); err != nil || count != 0 || db.execSQL != "not called" {
		t.Fatalf("empty archive call = count:%d error:%v SQL:%q", count, err, db.execSQL)
	}

	execCause := errors.New("exec cause")
	db.execErr = execCause
	if _, err := adapter.archiveWidgets(ctx, ids); !errors.Is(err, execCause) {
		t.Fatalf("archive error = %v, want wrapped cause", err)
	}
	copyCause := errors.New("copy cause")
	db.copyErr = copyCause
	if _, err := adapter.copyWidgets(ctx, source); !errors.Is(err, copyCause) {
		t.Fatalf("copy error = %v, want wrapped cause", err)
	}
}

func TestReviewedDirectPGXAdapterUsesCallerTransaction(t *testing.T) {
	testDatabase := dbtest.New(t)
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	settings, err := NewSettings(2, 0, time.Minute, time.Minute, time.Second, 5*time.Second)
	if err != nil {
		t.Fatalf("NewSettings: %v", err)
	}
	poolConfig, err := ParseConfig(testDatabase.URL().Reveal(), testDatabase.Password().Reveal(), settings)
	if err != nil {
		t.Fatalf("ParseConfig: %v", err)
	}
	tracer := &reviewedObservationTracer{}
	poolConfig.ConnConfig.Tracer = tracer
	pool, err := pgxpool.NewWithConfig(ctx, poolConfig)
	if err != nil {
		t.Fatalf("open traced pool: %v", err)
	}
	defer pool.Close()
	if err := pool.Ping(ctx); err != nil {
		t.Fatalf("ping traced pool: %v", err)
	}
	if _, err := pool.Exec(ctx, `CREATE TABLE widgets (id bigint PRIMARY KEY, name text NOT NULL, archived_at timestamptz)`); err != nil {
		t.Fatalf("create widgets: %v", err)
	}
	transactor, err := NewTransactor(pool)
	if err != nil {
		t.Fatalf("NewTransactor: %v", err)
	}

	rollbackCause := errors.New("roll back reviewed operation")
	err = transactor.Within(ctx, transaction.Options{}, func(ctx context.Context, tx pgx.Tx) error {
		adapter := newReviewedDirectPGXAdapter(tx)
		rollbackRows := append(make([][]any, 0, 1), []any{int64(1), "rolled back"})
		if _, err := adapter.copyWidgets(ctx, pgx.CopyFromRows(rollbackRows)); err != nil {
			return err
		}
		return rollbackCause
	})
	if !errors.Is(err, rollbackCause) {
		t.Fatalf("rollback transaction error = %v", err)
	}
	assertWidgetCount(t, ctx, pool, 0)

	rows := make([][]any, 0, 2)
	rows = append(rows, []any{int64(2), "committed"}, []any{int64(3), "archived"})
	if err := reviewedBulkImport(ctx, transactor, pgx.CopyFromRows(rows)); err != nil {
		t.Fatalf("reviewedBulkImport: %v", err)
	}
	if err := transactor.Within(ctx, transaction.Options{}, func(ctx context.Context, tx pgx.Tx) error {
		count, err := newReviewedDirectPGXAdapter(tx).archiveWidgets(ctx, []int64{3})
		if err != nil {
			return err
		}
		if count != 1 {
			return fmt.Errorf("archived row count = %d, want 1", count)
		}
		return nil
	}); err != nil {
		t.Fatalf("archive transaction: %v", err)
	}
	assertWidgetCount(t, ctx, pool, 2)
	var archived bool
	if err := pool.QueryRow(ctx, `SELECT archived_at IS NOT NULL FROM widgets WHERE id = 3`).Scan(&archived); err != nil {
		t.Fatalf("read archived widget: %v", err)
	}
	if !archived {
		t.Fatal("committed archive was not visible")
	}
	if !tracer.observedQuery(reviewedArchiveWidgetsSQL) {
		t.Fatal("reviewed Exec was not visible to pgx.QueryTracer")
	}
	if !tracer.observedCopy(pgx.Identifier{"widgets"}) {
		t.Fatal("reviewed CopyFrom was not visible to pgx.CopyFromTracer")
	}
}

type reviewedObservationTracer struct {
	queries    []string
	copyTables []pgx.Identifier
}

var _ pgx.QueryTracer = (*reviewedObservationTracer)(nil)
var _ pgx.CopyFromTracer = (*reviewedObservationTracer)(nil)

func (t *reviewedObservationTracer) TraceQueryStart(ctx context.Context, _ *pgx.Conn, data pgx.TraceQueryStartData) context.Context {
	t.queries = append(t.queries, data.SQL)
	return ctx
}

func (*reviewedObservationTracer) TraceQueryEnd(context.Context, *pgx.Conn, pgx.TraceQueryEndData) {
}

func (t *reviewedObservationTracer) TraceCopyFromStart(ctx context.Context, _ *pgx.Conn, data pgx.TraceCopyFromStartData) context.Context {
	t.copyTables = append(t.copyTables, data.TableName)
	return ctx
}

func (*reviewedObservationTracer) TraceCopyFromEnd(context.Context, *pgx.Conn, pgx.TraceCopyFromEndData) {
}

func (t *reviewedObservationTracer) observedQuery(want string) bool {
	for _, query := range t.queries {
		if query == want {
			return true
		}
	}
	return false
}

func (t *reviewedObservationTracer) observedCopy(want pgx.Identifier) bool {
	for _, table := range t.copyTables {
		if reflect.DeepEqual(table, want) {
			return true
		}
	}
	return false
}

type widgetCounter interface {
	QueryRow(context.Context, string, ...any) pgx.Row
}

func assertWidgetCount(t *testing.T, ctx context.Context, db widgetCounter, want int) {
	t.Helper()
	var got int
	if err := db.QueryRow(ctx, `SELECT count(*) FROM widgets`).Scan(&got); err != nil {
		t.Fatalf("count widgets: %v", err)
	}
	if got != want {
		t.Fatalf("widget count = %d, want %d", got, want)
	}
}
