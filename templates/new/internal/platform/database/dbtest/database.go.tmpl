func availabilityPolicy(baseURL, ci string) (skip bool, err error) {
	if strings.TrimSpace(baseURL) != "" {
		return false, nil
	}
	switch strings.ToLower(strings.TrimSpace(ci)) {
	case "1", "true":
		return false, errors.New("TEST_DATABASE_URL is required when CI is true")
	default:
		return true, nil
	}
}

func newDatabaseName(testName string) (string, error) {
	random := make([]byte, 8)
	if _, err := rand.Read(random); err != nil {
		return "", err
	}
	var slug strings.Builder
	for _, char := range strings.ToLower(testName) {
		if slug.Len() >= 24 {
			break
		}
		if char >= 'a' && char <= 'z' || char >= '0' && char <= '9' {
			slug.WriteRune(char)
		} else if slug.Len() > 0 && !strings.HasSuffix(slug.String(), "_") {
			slug.WriteByte('_')
		}
	}
	return "nise_test_" + strings.Trim(slug.String(), "_") + "_" + hex.EncodeToString(random), nil
}

func isolatedDatabaseURL(baseURL, name string) (string, error) {
	parsed, err := url.Parse(baseURL)
	if err != nil || parsed.Host == "" || parsed.Fragment != "" || (parsed.Scheme != "postgres" && parsed.Scheme != "postgresql") {
		return "", errors.New("TEST_DATABASE_URL must use postgres:// or postgresql:// URL syntax")
	}
	parsed.Path = "/" + name
	parsed.RawPath = ""
	if parsed.User != nil {
		parsed.User = url.User(parsed.User.Username())
	}
	query := parsed.Query()
	query.Del("password")
	parsed.RawQuery = query.Encode()
	return parsed.String(), nil
}

func cleanup(t testing.TB, adminConfig *pgx.ConnConfig, name string) {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), adminOperationTimeout)
	defer cancel()
	admin, err := pgx.ConnectConfig(ctx, adminConfig)
	if err != nil {
		t.Error("reconnect to TEST_DATABASE_URL to clean up isolated database")
		return
	}
	identifier := pgx.Identifier{name}.Sanitize()
	_, dropErr := admin.Exec(ctx, "DROP DATABASE IF EXISTS "+identifier+" WITH (FORCE)")
	closeErr := admin.Close(ctx)
	if err := errors.Join(dropErr, closeErr); err != nil {
		t.Errorf("clean up isolated PostgreSQL database %s: %v", name, err)
	}
}

var _ fmt.Stringer = Database{}
var _ fmt.GoStringer = Database{}
var _ slog.LogValuer = Database{}
