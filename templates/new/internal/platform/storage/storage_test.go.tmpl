// TestValidateKeyRefusesEverythingThatIsNotAKey is the security boundary of
// this package stated as a table. Every entry is something that has, in some
// system, been the difference between writing an object and writing a file
// somewhere else.
func TestValidateKeyRefusesEverythingThatIsNotAKey(t *testing.T) {
	t.Parallel()

	refused := []struct {
		name string
		key  string
	}{
		{"empty", ""},
		{"absolute", "/uploads/a"},
		{"trailing separator", "uploads/"},
		{"parent traversal", "uploads/../../etc/passwd"},
		{"bare parent", ".."},
		{"current directory", "."},
		{"embedded parent", "a/../b"},
		{"embedded current", "a/./b"},
		{"double separator", "a//b"},
		{"backslash traversal", `uploads\..\..\windows`},
		{"newline", "uploads/a\nb"},
		{"carriage return", "uploads/a\rb"},
		{"NUL", "uploads/a\x00b"},
		{"tab", "uploads/a\tb"},
		{"space", "uploads/a b"},
		{"colon", "uploads/a:b"},
		{"percent", "uploads/a%2e%2e"},
		{"tilde", "uploads/~root"},
		{"question mark", "uploads/a?b"},
		{"hash", "uploads/a#b"},
		{"invalid UTF-8", "uploads/\xff"},
		{"unicode homoglyph separator", "uploads/a∕b"},
		{"too long", strings.Repeat("a", MaxKeyBytes+1)},
		{"component too long", "uploads/" + strings.Repeat("a", MaxKeyComponentBytes+1)},
	}
	for _, c := range refused {
		t.Run(c.name, func(t *testing.T) {
			t.Parallel()
			if err := ValidateKey(c.key); err == nil {
				t.Fatalf("ValidateKey(%q) = nil, want a refusal", c.key)
			}
		})
	}
}

func TestValidateKeyAcceptsWhatAnApplicationActuallyUses(t *testing.T) {
	t.Parallel()

	accepted := []string{
		"a",
		"uploads/01J8Z0000000000000000000",
		"uploads/2026/08/31/01J8Z0.bin",
		"tenant_1/user-2/avatar.png",
		"a.b.c",
		// The longest key the rules permit: components at the component
		// bound, joined until the whole is at the key bound. The two limits
		// interact, and a key of MaxKeyBytes made of one component is
		// refused — which is correct, and was worth finding out here rather
		// than from a caller.
		longestPermittedKey(),
	}
	for _, key := range accepted {
		if err := ValidateKey(key); err != nil {
			t.Errorf("ValidateKey(%q) = %v, want it accepted", key, err)
		}
	}
}

// TestValidateKeyRefusesRatherThanCleans is the decision behind the
// canonical-form rule. Cleaning would mean two different key strings
// addressing one object — and an authorization check performed on the key the
// caller passed rather than on the object it reached.
// longestPermittedKey builds the longest key the two bounds allow together:
// components of MaxKeyComponentBytes joined by separators, filled up to
// MaxKeyBytes.
func longestPermittedKey() string {
	component := strings.Repeat("a", MaxKeyComponentBytes)
	var parts []string
	for length := 0; ; {
		next := len(component)
		if len(parts) > 0 {
			next++
		}
		if length+next > MaxKeyBytes {
			// Fill the remainder with a shorter final component.
			remaining := MaxKeyBytes - length - 1
			if remaining > 0 {
				parts = append(parts, strings.Repeat("a", remaining))
			}
			break
		}
		parts = append(parts, component)
		length += next
	}
	return strings.Join(parts, "/")
}

func TestValidateKeyRefusesRatherThanCleans(t *testing.T) {
	t.Parallel()

	if err := ValidateKey("uploads/./a"); err == nil {
		t.Fatal("a key that is not in canonical form was accepted")
	}
	if err := ValidateKey("uploads/a"); err != nil {
		t.Fatalf("its canonical form was refused: %v", err)
	}
}

func TestSanitizeFilenameNeverProducesAPath(t *testing.T) {
	t.Parallel()

	cases := map[string]string{
		"report.pdf":                 "report.pdf",
		"../../etc/passwd":           "passwd",
		`..\..\windows\system32`:     "system32",
		"/absolute/name.txt":         "name.txt",
		"my report.pdf":              "my-report.pdf",
		"réport.pdf":                 "r_port.pdf",
		"":                           "file",
		".":                          "file",
		"..":                         "file",
		"...":                        "file",
		"/":                          "file",
		"a\x00b.txt":                 "a_b.txt",
		"a\nb.txt":                   "a_b.txt",
		strings.Repeat("a", 400):     strings.Repeat("a", MaxKeyComponentBytes),
		// Truncation must not leave a separator at the end. A name cut to
		// the limit that ends in "-" or "." is not idempotent — sanitizing
		// it again would remove it — and a trailing "." is not a legal
		// filename on Windows. A fuzz target found this.
		// 199 zeros, a space, and two more. The space becomes "-", so the
		// cut at 200 lands on it.
		strings.Repeat("0", MaxKeyComponentBytes-1) + " 00": strings.Repeat("0", MaxKeyComponentBytes-1),
	}
	for input, want := range cases {
		if got := SanitizeFilename(input); got != want {
			t.Errorf("SanitizeFilename(%q) = %q, want %q", input, got, want)
		}
	}
}

// TestASanitizedFilenameIsNotAKey states the rule the doc comment makes,
// where a future change would trip over it. The output is safe to display and
// safe as one path component; it is not an identifier, and using it as a key
// hands key naming to whoever is uploading.
func TestASanitizedFilenameIsAValidComponentButNotAnIdentifier(t *testing.T) {
	t.Parallel()

	for _, input := range []string{"../../etc/passwd", "my report.pdf", "a\x00b"} {
		got := SanitizeFilename(input)
		if err := ValidateKey(got); err != nil {
			t.Errorf("SanitizeFilename(%q) = %q, which is not usable even as one component: %v", input, got, err)
		}
		if strings.Contains(got, "/") {
			t.Errorf("SanitizeFilename(%q) = %q, which spans more than one component", input, got)
		}
	}
	// Two different uploads can produce the same sanitized name, which is
	// exactly why it must not be the key.
	if SanitizeFilename("a b.txt") != SanitizeFilename("a-b.txt") {
		t.Skip("the collision this documents does not occur with these inputs")
	}
}

func TestJoinKeyComposesAndValidates(t *testing.T) {
	t.Parallel()

	key, err := JoinKey("uploads", "/2026/", "file.bin")
	if err != nil {
		t.Fatalf("JoinKey: %v", err)
	}
	if key != "uploads/2026/file.bin" {
		t.Errorf("JoinKey = %q", key)
	}
	if _, err := JoinKey("uploads", "..", "etc"); err == nil {
		t.Error("JoinKey composed a traversal")
	}
	if _, err := JoinKey(); err == nil {
		t.Error("JoinKey produced a key from nothing")
	}
}

// FuzzValidateKeyNeverAcceptsAnEscape is the upload-metadata fuzz target, and
// it asserts the property rather than a list of inputs.
//
// A key that ValidateKey accepts is one the local backend will pass to a
// rename and the S3 backend will interpolate into a path. So an accepted key
// must be one that cannot mean anything but itself: already canonical, one
// path component per separator, and made only of characters that no
// filesystem, URL parser, or S3 clone reads as an instruction.
func FuzzValidateKeyNeverAcceptsAnEscape(f *testing.F) {
	f.Add("uploads/a.bin")
	f.Add("../escaped")
	f.Add("uploads/../../etc/passwd")
	f.Add("uploads//a")
	f.Add("/uploads/a")
	f.Add("uploads/a\x00b")
	f.Add("uploads/a\nb")
	f.Add("uploads/%2e%2e/a")
	f.Add("uploads/\xff")
	f.Add("a")
	f.Add("")

	f.Fuzz(func(t *testing.T, key string) {
		if err := ValidateKey(key); err != nil {
			return
		}

		// Accepted. Everything below must therefore hold.
		if path.Clean(key) != key {
			t.Fatalf("accepted %q, which is not its own cleaned form (%q)", key, path.Clean(key))
		}
		if strings.HasPrefix(key, "/") || strings.HasSuffix(key, "/") {
			t.Fatalf("accepted %q, which has a leading or trailing separator", key)
		}
		if !utf8.ValidString(key) {
			t.Fatalf("accepted %q, which is not valid UTF-8", key)
		}
		if len(key) == 0 || len(key) > MaxKeyBytes {
			t.Fatalf("accepted %q, which is %d bytes", key, len(key))
		}
		for _, component := range strings.Split(key, "/") {
			if component == "" || component == "." || component == ".." {
				t.Fatalf("accepted %q, which has the component %q", key, component)
			}
			if len(component) > MaxKeyComponentBytes {
				t.Fatalf("accepted %q, whose component %q is %d bytes", key, component, len(component))
			}
		}
		for _, r := range key {
			if !allowedKeyRune(r) {
				t.Fatalf("accepted %q, which contains %q", key, r)
			}
		}
		// A backslash is a separator on one of the platforms this runs on,
		// so an accepted key containing one would mean two different things
		// on two different machines.
		if strings.ContainsAny(key, `\`) {
			t.Fatalf("accepted %q, which contains a backslash", key)
		}
	})
}

// FuzzSanitizeFilenameAlwaysProducesOneUsableComponent covers the other half
// of upload metadata: the name that comes from the client.
//
// Whatever arrives, what comes back must be usable as exactly one path
// component and must never be empty — because the caller is about to put it
// in a database column and offer it as a download name, and a
// SanitizeFilename that could return "" or "../x" would move the problem
// rather than solve it.
func FuzzSanitizeFilenameAlwaysProducesOneUsableComponent(f *testing.F) {
	f.Add("report.pdf")
	f.Add("../../etc/passwd")
	f.Add(`..\..\windows\system32`)
	f.Add("")
	f.Add(".")
	f.Add("..")
	f.Add("/")
	f.Add("a\x00b")
	f.Add("réport.pdf")
	f.Add(strings.Repeat("a", 1000))

	f.Fuzz(func(t *testing.T, name string) {
		got := SanitizeFilename(name)

		if got == "" {
			t.Fatalf("SanitizeFilename(%q) returned an empty name", name)
		}
		if strings.Contains(got, "/") || strings.Contains(got, `\`) {
			t.Fatalf("SanitizeFilename(%q) = %q, which spans more than one component", name, got)
		}
		if got == "." || got == ".." {
			t.Fatalf("SanitizeFilename(%q) = %q, which is a dot segment", name, got)
		}
		if len(got) > MaxKeyComponentBytes {
			t.Fatalf("SanitizeFilename(%q) returned %d bytes", name, len(got))
		}
		// It must be usable as a key component, because that is what a
		// caller composing a key with it will do.
		if err := ValidateKey(got); err != nil {
			t.Fatalf("SanitizeFilename(%q) = %q, which is not a usable component: %v", name, got, err)
		}
		// Sanitizing twice must change nothing. A function that is not
		// idempotent here means the value stored and the value used can
		// differ.
		if again := SanitizeFilename(got); again != got {
			t.Fatalf("SanitizeFilename is not idempotent: %q -> %q -> %q", name, got, again)
		}
	})
}
