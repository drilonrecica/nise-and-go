func TestS3RoundTrip(t *testing.T) {
	t.Parallel()

	store, fake := newFakeStore(t, true)
	ctx := context.Background()
	const key = "uploads/2026/report.bin"
	content := []byte("the bytes")

	object, err := store.Put(ctx, key, bytes.NewReader(content), PutOptions{
		ContentType:   "application/octet-stream",
		ContentLength: int64(len(content)),
	})
	if err != nil {
		t.Fatalf("Put: %v", err)
	}
	if object.ETag != "deadbeef" {
		t.Errorf("ETag = %q, want the quotes stripped", object.ETag)
	}
	if got := fake.objects["/test-bucket/"+key]; !bytes.Equal(got, content) {
		t.Errorf("the service stored %q, want %q", got, content)
	}

	reader, err := store.Get(ctx, key)
	if err != nil {
		t.Fatalf("Get: %v", err)
	}
	got, _ := io.ReadAll(reader)
	_ = reader.Close()
	if !bytes.Equal(got, content) {
		t.Errorf("Get = %q, want %q", got, content)
	}

	stat, err := store.Stat(ctx, key)
	if err != nil {
		t.Fatalf("Stat: %v", err)
	}
	if stat.Size != int64(len(content)) {
		t.Errorf("Stat size = %d, want %d", stat.Size, len(content))
	}

	if err := store.Delete(ctx, key); err != nil {
		t.Fatalf("Delete: %v", err)
	}
	if _, err := store.Stat(ctx, key); !errors.Is(err, ErrNotFound) {
		t.Fatalf("Stat after Delete = %v, want ErrNotFound", err)
	}
}

// TestEveryRequestIsSigned is the check that would catch the whole signing
// path being skipped.
func TestEveryRequestIsSigned(t *testing.T) {
	t.Parallel()

	store, fake := newFakeStore(t, true)
	ctx := context.Background()
	if _, err := store.Put(ctx, "a.bin", strings.NewReader("x"), PutOptions{}); err != nil {
		t.Fatalf("Put: %v", err)
	}
	request := fake.lastRequest(t)

	authorization := request.Header.Get("Authorization")
	if !strings.HasPrefix(authorization, sigV4Algorithm+" ") {
		t.Fatalf("Authorization = %q", authorization)
	}
	if request.Header.Get("X-Amz-Date") == "" {
		t.Error("the request carries no X-Amz-Date")
	}
	if request.Header.Get("X-Amz-Content-Sha256") != unsignedPayload {
		t.Errorf("X-Amz-Content-Sha256 = %q, want the unsigned-payload marker", request.Header.Get("X-Amz-Content-Sha256"))
	}
	if strings.Contains(authorization, "secret") {
		t.Fatal("the Authorization header contains the secret access key")
	}
}

// TestPathStyleAndVirtualHostAddressing covers the setting that decides
// whether a bucket is a path component or a subdomain. Every S3-compatible
// service that is not AWS needs path style, which is why it defaults on.
func TestPathStyleAndVirtualHostAddressing(t *testing.T) {
	t.Parallel()

	pathStyle, fake := newFakeStore(t, true)
	if _, err := pathStyle.Put(context.Background(), "a.bin", strings.NewReader("x"), PutOptions{}); err != nil {
		t.Fatalf("Put: %v", err)
	}
	if got := fake.lastRequest(t).URL.Path; got != "/test-bucket/a.bin" {
		t.Errorf("path-style path = %q, want /test-bucket/a.bin", got)
	}

	settings, err := NewS3Settings("https://example.com", "test-bucket", "us-east-1", "AKID", "secret", "", false)
	if err != nil {
		t.Fatalf("NewS3Settings: %v", err)
	}
	virtual, err := NewS3(settings, nil)
	if err != nil {
		t.Fatalf("NewS3: %v", err)
	}
	u := virtual.objectURL("a.bin")
	if u.Host != "test-bucket.example.com" {
		t.Errorf("virtual-host host = %q, want test-bucket.example.com", u.Host)
	}
	if u.Path != "/a.bin" {
		t.Errorf("virtual-host path = %q, want /a.bin", u.Path)
	}
}

// TestAFailureIncludesTheServicesOwnError matters because an S3-compatible
// service's XML error code is frequently the only thing distinguishing "the
// bucket does not exist" from "the signature did not match", and several
// return 403 for both.
func TestAFailureIncludesTheServicesOwnError(t *testing.T) {
	t.Parallel()

	store, fake := newFakeStore(t, true)
	fake.fail(http.StatusForbidden, "<Error><Code>SignatureDoesNotMatch</Code></Error>")

	_, err := store.Put(context.Background(), "a.bin", strings.NewReader("x"), PutOptions{})
	if err == nil {
		t.Fatal("Put succeeded against a 403")
	}
	if !strings.Contains(err.Error(), "SignatureDoesNotMatch") {
		t.Errorf("the error does not carry the service's own code: %v", err)
	}
}

// TestAnErrorBodyIsBounded keeps a service that answers with a very large
// body from putting all of it into this application's logs.
func TestAnErrorBodyIsBounded(t *testing.T) {
	t.Parallel()

	store, fake := newFakeStore(t, true)
	fake.fail(http.StatusInternalServerError, strings.Repeat("x", MaxS3ErrorBytes*4))

	_, err := store.Put(context.Background(), "a.bin", strings.NewReader("x"), PutOptions{})
	if err == nil {
		t.Fatal("Put succeeded against a 500")
	}
	if len(err.Error()) > MaxS3ErrorBytes*2 {
		t.Errorf("the error is %d bytes; the service's body was not bounded", len(err.Error()))
	}
}

func TestS3RefusesABadKeyBeforeConnecting(t *testing.T) {
	t.Parallel()

	store, fake := newFakeStore(t, true)
	ctx := context.Background()
	const escape = "../escaped"

	if _, err := store.Put(ctx, escape, strings.NewReader("x"), PutOptions{}); !errors.Is(err, ErrKey) {
		t.Errorf("Put = %v, want ErrKey", err)
	}
	if _, err := store.Get(ctx, escape); !errors.Is(err, ErrKey) {
		t.Errorf("Get = %v, want ErrKey", err)
	}
	if _, err := store.Stat(ctx, escape); !errors.Is(err, ErrKey) {
		t.Errorf("Stat = %v, want ErrKey", err)
	}
	if err := store.Delete(ctx, escape); !errors.Is(err, ErrKey) {
		t.Errorf("Delete = %v, want ErrKey", err)
	}

	fake.mu.Lock()
	defer fake.mu.Unlock()
	if len(fake.requests) != 0 {
		t.Errorf("a refused key still reached the service: %d requests", len(fake.requests))
	}
}

