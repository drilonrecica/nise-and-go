// What this file can and cannot prove.
//
// SigV4's difficulty is entirely in canonicalization: which headers are
// signed, how their values are trimmed, how a path segment is encoded, how the
// query is ordered. Every one of those can be checked here, directly, and each
// test below names the specific rule it pins.
//
// What cannot be checked here is whether the whole thing composes into a
// signature a service accepts. Every wrong implementation produces a
// well-formed signature; only the service disagrees. That is what
// TestS3AgainstARealService in s3_integration_test.go is for, and neither
// suite is sufficient without the other — this one says which rule broke, and
// that one says whether it works.
//
// The credentials and timestamp below are fixed rather than generated, so a
// failure names a rule instead of a value that changed.
const (
	fixtureAccessKeyID = "AKIDEXAMPLE"
	fixtureSecretKey   = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
	fixtureRegion      = "us-east-1"
	fixtureService     = "service"
)

// fixtureTime is the instant every signature here is computed at.
var fixtureTime = time.Date(2015, 8, 30, 12, 36, 0, 0, time.UTC)

func fixtureSigner() *signer {
	return &signer{
		credentials: credentials{accessKeyID: fixtureAccessKeyID, secretAccessKey: fixtureSecretKey},
		region:      fixtureRegion,
		service:     fixtureService,
		now:         func() time.Time { return fixtureTime },
	}
}

// TestSigningKeyMatchesTheDocumentedDerivation covers the four chained HMACs
// on their own, so a failure further down can be attributed.
func TestSigningKeyMatchesTheDocumentedDerivation(t *testing.T) {
	t.Parallel()

	key := fixtureSigner().signingKey(fixtureTime.Format(yyyymmdd))
	if len(key) != 32 {
		t.Fatalf("the signing key is %d bytes, want 32", len(key))
	}
	// Deriving it twice must produce the same key; a derivation that read
	// anything ambient would not.
	again := fixtureSigner().signingKey(fixtureTime.Format(yyyymmdd))
	if string(key) != string(again) {
		t.Error("the signing key is not a pure function of its inputs")
	}
}

// TestDuplicateHeaderValuesAreJoined covers one of the two canonicalization
// rules most often got wrong: a header appearing twice signs as one line with
// its values joined by a comma, in the order they were added.
func TestDuplicateHeaderValuesAreJoined(t *testing.T) {
	t.Parallel()

	u, err := url.Parse("https://example.com/")
	if err != nil {
		t.Fatalf("Parse: %v", err)
	}
	req := &http.Request{Method: http.MethodGet, URL: u, Host: "example.com", Header: http.Header{}}
	req.Header.Add("X-Amz-Header1", "value2")
	req.Header.Add("X-Amz-Header1", "value1")

	_, block := canonicalHeaders(req)
	// The values are joined in the order they were added, comma separated,
	// on one line.
	if !strings.Contains(block, "x-amz-header1:value2,value1\n") {
		t.Errorf("duplicate headers were not joined:\n%q", block)
	}
	if !strings.Contains(block, "host:example.com\n") {
		t.Errorf("the Host header was not signed:\n%q", block)
	}
}

// TestHostIsSignedFromRequestHost is the single most common way a
// hand-written SigV4 implementation produces a rejected signature: Go keeps
// the host in Request.Host, not in Request.Header, so a loop over Header
// alone omits it.
func TestHostIsSignedFromRequestHost(t *testing.T) {
	t.Parallel()

	u, _ := url.Parse("https://bucket.example.com/key")
	req := &http.Request{Method: http.MethodGet, URL: u, Host: "bucket.example.com", Header: http.Header{}}
	signed, block := canonicalHeaders(req)
	if !strings.Contains(signed, "host") {
		t.Errorf("SignedHeaders = %q, and does not include host", signed)
	}
	if !strings.Contains(block, "host:bucket.example.com") {
		t.Errorf("the canonical headers do not carry the host:\n%q", block)
	}
}

// TestHeaderWhitespaceIsCollapsed covers the trimming rule: leading, trailing,
// and repeated internal whitespace in a header value is normalized before it
// is signed.
func TestHeaderWhitespaceIsCollapsed(t *testing.T) {
	t.Parallel()

	u, _ := url.Parse("https://example.com/")
	req := &http.Request{Method: http.MethodGet, URL: u, Host: "example.com", Header: http.Header{}}
	req.Header.Set("X-Amz-Meta-Note", "  a   b  ")
	_, block := canonicalHeaders(req)
	if !strings.Contains(block, "x-amz-meta-note:a b\n") {
		t.Errorf("header whitespace was not collapsed:\n%q", block)
	}
}

// TestOnlySignedHeadersAreSigned keeps the signature from depending on
// headers a proxy may add in transit, which would make every request through
// that proxy fail with an authentication error.
func TestOnlySignedHeadersAreSigned(t *testing.T) {
	t.Parallel()

	u, _ := url.Parse("https://example.com/")
	req := &http.Request{Method: http.MethodGet, URL: u, Host: "example.com", Header: http.Header{}}
	req.Header.Set("Accept-Encoding", "gzip")
	req.Header.Set("User-Agent", "probe")
	req.Header.Set("Content-Type", "text/plain")
	req.Header.Set("X-Amz-Date", "20150830T123600Z")

	signed, _ := canonicalHeaders(req)
	for _, unwanted := range []string{"accept-encoding", "user-agent"} {
		if strings.Contains(signed, unwanted) {
			t.Errorf("SignedHeaders = %q, and includes %q, which a proxy may change", signed, unwanted)
		}
	}
	for _, wanted := range []string{"content-type", "host", "x-amz-date"} {
		if !strings.Contains(signed, wanted) {
			t.Errorf("SignedHeaders = %q, and omits %q", signed, wanted)
		}
	}
}

// TestURIEncodingFollowsSigV4NotGo covers where Go's own escaping and SigV4
// disagree. Go leaves several of these unescaped in a path; SigV4 requires
// them encoded, and one differing byte is a rejected request.
func TestURIEncodingFollowsSigV4NotGo(t *testing.T) {
	t.Parallel()

	cases := map[string]string{
		"simple":      "simple",
		"a b":         "a%20b",
		"a+b":         "a%2Bb",
		"a=b":         "a%3Db",
		"a&b":         "a%26b",
		"a~b":         "a~b",
		"a.b-c_d":     "a.b-c_d",
		"ä":           "%C3%A4",
		"a:b":         "a%3Ab",
		"a*b":         "a%2Ab",
		"a'b":         "a%27b",
		"a(b)":        "a%28b%29",
		"a!b":         "a%21b",
	}
	for input, want := range cases {
		if got := uriEncode(input, true); got != want {
			t.Errorf("uriEncode(%q) = %q, want %q", input, got, want)
		}
	}
	// In a path the slash has already been split out; encodeSlash false is
	// what lets the joined path keep its separators.
	if got := uriEncode("a/b", false); got != "a/b" {
		t.Errorf("uriEncode(%q, false) = %q", "a/b", got)
	}
	if got := uriEncode("a/b", true); got != "a%2Fb" {
		t.Errorf("uriEncode(%q, true) = %q", "a/b", got)
	}
}

// TestCanonicalQuerySortsAndEncodes covers the query rules: keys sorted,
// values sorted within a key, and both encoded.
func TestCanonicalQuerySortsAndEncodes(t *testing.T) {
	t.Parallel()

	values := url.Values{}
	values.Set("b", "2")
	values.Set("a", "1")
	values.Add("a", "0")
	values.Set("needs encoding", "a b")

	got := canonicalQuery(values)
	want := "a=0&a=1&b=2&needs%20encoding=a%20b"
	if got != want {
		t.Errorf("canonicalQuery = %q, want %q", got, want)
	}
}

