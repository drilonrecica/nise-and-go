// TestSignIsDeterministic is what makes every other assertion in this file
// meaningful: two signings of the same request at the same instant must
// produce the same signature, or nothing here is reproducible.
func TestSignIsDeterministic(t *testing.T) {
	t.Parallel()

	sign := func() string {
		u, _ := url.Parse("https://example.com/bucket/key.bin")
		req := &http.Request{Method: http.MethodPut, URL: u, Host: "example.com", Header: http.Header{}}
		req.Header.Set("Content-Type", "application/octet-stream")
		fixtureSigner().sign(req, unsignedPayload)
		return req.Header.Get("Authorization")
	}
	first, second := sign(), sign()
	if first != second {
		t.Fatalf("two signings differ:\n%s\n%s", first, second)
	}
	for _, want := range []string{
		sigV4Algorithm + " ",
		"Credential=" + fixtureAccessKeyID + "/20150830/us-east-1/service/aws4_request",
		"SignedHeaders=content-type;host;x-amz-content-sha256;x-amz-date",
		"Signature=",
	} {
		if !strings.Contains(first, want) {
			t.Errorf("the Authorization header lacks %q:\n%s", want, first)
		}
	}
}

// TestADifferentRequestProducesADifferentSignature is the negative check on
// all of it: if the signature did not actually cover the request, every
// assertion above would pass against an implementation that signed nothing.
func TestADifferentRequestProducesADifferentSignature(t *testing.T) {
	t.Parallel()

	signOf := func(method, target string) string {
		u, _ := url.Parse(target)
		req := &http.Request{Method: method, URL: u, Host: u.Host, Header: http.Header{}}
		fixtureSigner().sign(req, unsignedPayload)
		return req.Header.Get("Authorization")
	}
	base := signOf(http.MethodPut, "https://example.com/bucket/key.bin")
	for _, other := range []struct{ method, target string }{
		{http.MethodGet, "https://example.com/bucket/key.bin"},
		{http.MethodPut, "https://example.com/bucket/other.bin"},
		{http.MethodPut, "https://example.com/bucket/key.bin?versionId=2"},
		{http.MethodPut, "https://other.example.com/bucket/key.bin"},
	} {
		if signOf(other.method, other.target) == base {
			t.Errorf("%s %s signs identically to the base request", other.method, other.target)
		}
	}
}

// TestPresignCarriesEverythingTheServiceNeeds covers the query-string form:
// it must be verifiable with no headers beyond the ones it names.
func TestPresignCarriesEverythingTheServiceNeeds(t *testing.T) {
	t.Parallel()

	u, _ := url.Parse("https://example.com/bucket/key.bin")
	signed := fixtureSigner().presign(http.MethodPut, u, 15*time.Minute, nil)

	parsed, err := url.Parse(signed)
	if err != nil {
		t.Fatalf("the presigned URL does not parse: %v", err)
	}
	query := parsed.Query()
	for _, name := range []string{
		"X-Amz-Algorithm", "X-Amz-Credential", "X-Amz-Date",
		"X-Amz-Expires", "X-Amz-SignedHeaders", "X-Amz-Signature",
	} {
		if query.Get(name) == "" {
			t.Errorf("the presigned URL has no %s", name)
		}
	}
	if query.Get("X-Amz-Algorithm") != sigV4Algorithm {
		t.Errorf("X-Amz-Algorithm = %q", query.Get("X-Amz-Algorithm"))
	}
	if query.Get("X-Amz-Expires") != "900" {
		t.Errorf("X-Amz-Expires = %q, want 900", query.Get("X-Amz-Expires"))
	}
	if query.Get("X-Amz-SignedHeaders") != "host" {
		t.Errorf("X-Amz-SignedHeaders = %q, want host", query.Get("X-Amz-SignedHeaders"))
	}
	// The signature must not be in the signed-headers list, and the URL must
	// not carry credentials in a form that could be mistaken for the secret.
	if strings.Contains(signed, fixtureSecretKey) {
		t.Fatal("the presigned URL contains the secret access key")
	}
}

// TestPresigningADifferentExpiryChangesTheSignature proves the expiry is
// inside the signature rather than beside it. If it were not, a recipient
// could extend the window by editing one query parameter.
func TestPresigningADifferentExpiryChangesTheSignature(t *testing.T) {
	t.Parallel()

	signatureFor := func(expires time.Duration) string {
		u, _ := url.Parse("https://example.com/bucket/key.bin")
		parsed, _ := url.Parse(fixtureSigner().presign(http.MethodPut, u, expires, nil))
		return parsed.Query().Get("X-Amz-Signature")
	}
	if signatureFor(time.Minute) == signatureFor(time.Hour) {
		t.Fatal("the expiry is not covered by the signature; a recipient could extend it by editing the URL")
	}
}

// TestPresigningADifferentMethodChangesTheSignature is the same argument for
// the verb: a URL presigned for PUT must not also authorize GET.
func TestPresigningADifferentMethodChangesTheSignature(t *testing.T) {
	t.Parallel()

	signatureFor := func(method string) string {
		u, _ := url.Parse("https://example.com/bucket/key.bin")
		parsed, _ := url.Parse(fixtureSigner().presign(method, u, time.Minute, nil))
		return parsed.Query().Get("X-Amz-Signature")
	}
	if signatureFor(http.MethodPut) == signatureFor(http.MethodGet) {
		t.Fatal("a URL presigned for PUT signs identically for GET")
	}
}
