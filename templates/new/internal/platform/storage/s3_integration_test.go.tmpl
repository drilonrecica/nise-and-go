package storage

import (
	"bytes"
	"context"
	"errors"
	"io"
	"net/http"
	"os"
	"strings"
	"testing"
	"time"
)

// The S3 adapter signs its own requests, and a signature is either accepted
// by a real service or it is not. Every other test in this package asserts
// the shape of what this code produces; this one asserts that a service
// verifies it.
//
// That distinction is not academic. AWS Signature Version 4 is specified
// precisely and its difficulty is entirely in canonicalization — one
// differing byte in a path segment, one header signed that should not have
// been, one query parameter sorted wrongly — and every one of those failures
// looks identical from inside this package. It looks like a correct
// signature. Only the service disagrees.
//
// Set TEST_S3_ENDPOINT to a disposable S3-compatible service to run it. A
// local MinIO is enough:
//
//	podman run --rm -p 9000:9000 -e MINIO_ROOT_USER=minio \
//	    -e MINIO_ROOT_PASSWORD=miniosecret quay.io/minio/minio server /data
//
// then create the bucket and export TEST_S3_ENDPOINT, TEST_S3_BUCKET,
// TEST_S3_ACCESS_KEY_ID, and TEST_S3_SECRET_ACCESS_KEY.
//
// It skips when they are unset, and it skips rather than failing under CI —
// unlike the PostgreSQL suites, which fail. That is a deliberate difference
// and not an oversight: a database is required for this application to work
// at all, while object storage is an optional module that many deployments
// will configure as "local" and never point at a service.
func TestS3AgainstARealService(t *testing.T) {
	endpoint := os.Getenv("TEST_S3_ENDPOINT")
	if endpoint == "" {
		t.Skip("set TEST_S3_ENDPOINT (and TEST_S3_BUCKET, TEST_S3_ACCESS_KEY_ID, TEST_S3_SECRET_ACCESS_KEY) to verify signatures against a real service")
	}

	settings, err := NewS3Settings(
		endpoint,
		envOr("TEST_S3_BUCKET", "nise-test"),
		envOr("TEST_S3_REGION", "us-east-1"),
		os.Getenv("TEST_S3_ACCESS_KEY_ID"),
		os.Getenv("TEST_S3_SECRET_ACCESS_KEY"),
		os.Getenv("TEST_S3_SESSION_TOKEN"),
		envOr("TEST_S3_PATH_STYLE", "true") != "false",
	)
	if err != nil {
		t.Fatalf("NewS3Settings: %v", err)
	}
	store, err := NewS3(settings, &http.Client{Timeout: 30 * time.Second})
	if err != nil {
		t.Fatalf("NewS3: %v", err)
	}

	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()

	// A key with punctuation, so the canonical-URI encoding is exercised
	// rather than assumed. A key of only letters and digits would sign
	// identically under several wrong implementations.
	key := "nise-probe/" + randomSuffix() + "/a.b-c_d.dat"
	content := []byte("bytes that crossed a real signature check")

	object, err := store.Put(ctx, key, bytes.NewReader(content), PutOptions{
		ContentType:   "application/octet-stream",
		ContentLength: int64(len(content)),
	})
	if err != nil {
		t.Fatalf("Put: %v", err)
	}
	t.Cleanup(func() {
		if err := store.Delete(context.Background(), key); err != nil {
			t.Errorf("cleaning up %s: %v", key, err)
		}
	})
	if object.ETag == "" {
		t.Error("the service returned no ETag")
	}

	reader, err := store.Get(ctx, key)
	if err != nil {
		t.Fatalf("Get: %v", err)
	}
	got, err := io.ReadAll(reader)
	if err != nil {
		t.Fatalf("reading: %v", err)
	}
	if err := reader.Close(); err != nil {
		t.Errorf("Close: %v", err)
	}
	if !bytes.Equal(got, content) {
		t.Errorf("Get returned %q, want %q", got, content)
	}

	stat, err := store.Stat(ctx, key)
	if err != nil {
		t.Fatalf("Stat: %v", err)
	}
	if stat.Size != int64(len(content)) {
		t.Errorf("Stat size = %d, want %d", stat.Size, len(content))
	}

	missing := "nise-probe/" + randomSuffix() + "/absent.dat"
	if _, err := store.Stat(ctx, missing); !errors.Is(err, ErrNotFound) {
		t.Errorf("Stat of a missing object = %v, want ErrNotFound", err)
	}
	// Deleting what is not there is not an error, on a real service too.
	if err := store.Delete(ctx, missing); err != nil {
		t.Errorf("Delete of a missing object = %v, want nil", err)
	}
}

func envOr(name, fallback string) string {
	if value := strings.TrimSpace(os.Getenv(name)); value != "" {
		return value
	}
	return fallback
}
