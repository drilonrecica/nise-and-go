// Generated once by nise; owned by this application. Nise will not overwrite it.

package authorization

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"

	"github.com/drilonrecica/nise-and-go/runtime/authz"
	"github.com/drilonrecica/nise-and-go/runtime/logging"
)

// ErrDenied reports that the caller may not do the thing.
//
// It is one error for every reason: no session, no roles, the wrong roles. A
// use case that could distinguish them would eventually return the distinction
// to the caller, and "you are not allowed, and by the way that record exists"
// is the leak a 403 was supposed to prevent.
var ErrDenied = errors.New("the caller does not hold the required permission")

// Reasons a denial can carry. They are values so a log line, a metric, and an
// audit record all name the same thing.
const (
	// ReasonNoSession means the request was not authenticated.
	ReasonNoSession = "no_session"
	// ReasonUnresolved means the middleware that resolves authority did not
	// run, or could not.
	ReasonUnresolved = "unresolved"
	// ReasonNotGranted means the caller is authenticated and does not hold
	// the permission.
	ReasonNotGranted = "not_granted"
)

// DeniedError carries which permission was missing, for the log and the audit
// record. It is never rendered to the caller.
type DeniedError struct {
	// Permission is what the use case required.
	Permission authz.Permission
	// UserID is the caller, or empty when there was no session.
	UserID string
	// Reason is one of the closed values above.
	Reason string
}

func (e *DeniedError) Error() string {
	return fmt.Sprintf("permission %s denied: %s", e.Permission, e.Reason)
}

// Is makes every DeniedError match ErrDenied, so a caller writes one check.
func (e *DeniedError) Is(target error) bool { return target == ErrDenied }

// Grants is the resolved authority of one request.
type Grants struct {
	// UserID is the authenticated account.
	UserID string
	// Permissions is what that account holds.
	Permissions authz.Set
	// StaleRoles are grant rows naming roles the catalog no longer declares.
	// They granted nothing; they are carried so a caller can log them.
	StaleRoles []string
}

// contextKey is unexported, so nothing outside this package can put authority
// into a request. Permissions any package could write would not be permissions.
type contextKey struct{}

// WithGrants returns a context carrying resolved authority.
func WithGrants(ctx context.Context, grants Grants) context.Context {
	return context.WithValue(ctx, contextKey{}, grants)
}

// GrantsFrom returns the resolved authority, and whether any was resolved.
func GrantsFrom(ctx context.Context) (Grants, bool) {
	grants, ok := ctx.Value(contextKey{}).(Grants)
	return grants, ok
}

// Require reports whether the caller may do the thing, and is the only way a
// use case should ask.
//
// It denies by default in every direction: unresolved authority denies, an
// empty permission set denies, an unauthenticated request denies. No path
// through this function allows without finding the permission in a set that was
// actually resolved for this request.
//
// It takes a context rather than a permission set on purpose. A use case that
// accepted the caller's permissions as an argument would be as trustworthy as
// its least careful call site, and "pass in what you are allowed to do" is not
// an authorization check.
func Require(ctx context.Context, permission authz.Permission) error {
	grants, ok := GrantsFrom(ctx)
	if !ok {
		return &DeniedError{Permission: permission, Reason: ReasonUnresolved}
	}
	if grants.UserID == "" {
		return &DeniedError{Permission: permission, Reason: ReasonNoSession}
	}
	if !grants.Permissions.Has(permission) {
		return &DeniedError{Permission: permission, UserID: grants.UserID, Reason: ReasonNotGranted}
	}
	return nil
}

// RequireAll denies unless the caller holds every permission, so a use case
// needing two capabilities writes one check rather than two that can drift.
//
// Requiring nothing is a denial, not a permission everyone holds: a use case
// that lost its permission list must not silently become public.
func RequireAll(ctx context.Context, permissions ...authz.Permission) error {
	if len(permissions) == 0 {
		return &DeniedError{Reason: ReasonUnresolved}
	}
	for _, permission := range permissions {
		if err := Require(ctx, permission); err != nil {
			return err
		}
	}
	return nil
}

// PermissionSource resolves an account's permissions. It is declared here, by
// the consumer, rather than imported from the feature that provides it.
type PermissionSource interface {
	Permissions(ctx context.Context, userID string) (authz.Set, []string, error)
}

// SessionSource reports the authenticated account for a request, if there is
// one. It is injected rather than imported so this package and the session
// package do not become mutually dependent the moment one wants something from
// the other.
type SessionSource func(ctx context.Context) (string, bool)

// Resolver attaches each request's authority once.
//
// Resolving once per request rather than once per check is not only about cost:
// two checks in one request that consulted the database separately could
// disagree, and a use case would then be authorized for its first write and not
// its second.
type Resolver struct {
	source    PermissionSource
	sessionOf SessionSource
	catalog   *authz.Catalog
}

// NewResolver constructs the authority-resolving middleware.
func NewResolver(source PermissionSource, catalog *authz.Catalog, sessionOf SessionSource) (*Resolver, error) {
	if source == nil {
		return nil, errors.New("authorization: a permission source is required")
	}
	if catalog == nil {
		return nil, errors.New("authorization: a permission catalog is required")
	}
	if sessionOf == nil {
		return nil, errors.New("authorization: a session source is required")
	}
	return &Resolver{source: source, catalog: catalog, sessionOf: sessionOf}, nil
}

// Catalog returns the catalog authority is resolved against.
func (r *Resolver) Catalog() *authz.Catalog { return r.catalog }

// Middleware resolves the authenticated caller's permissions into the context.
//
// It never rejects a request. Deciding what a caller may do is the use case's
// job, and a middleware that refused here would put the decision where no
// handler's reader can see it. What it guarantees is the opposite: a request
// reaching a handler either carries authority that was actually resolved or
// carries none, and Require denies in the second case.
//
// A resolution failure produces empty authority rather than an error the
// request sees. Empty authority denies everything, which is the safe direction;
// failing the request would turn a transient database problem into an error on
// a page that may have needed no permission at all.
func (r *Resolver) Middleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
		userID, authenticated := r.sessionOf(request.Context())
		if !authenticated || userID == "" {
			next.ServeHTTP(w, request)
			return
		}

		granted, stale, err := r.source.Permissions(request.Context(), userID)
		if err != nil {
			logging.FromContext(request.Context()).Error("resolving caller permissions",
				slog.String("error_type", fmt.Sprintf("%T", err)))
			next.ServeHTTP(w, request.WithContext(WithGrants(request.Context(), Grants{UserID: userID})))
			return
		}
		if len(stale) > 0 {
			logging.FromContext(request.Context()).Warn("account holds roles the catalog no longer declares",
				slog.Any("roles", stale))
		}
		next.ServeHTTP(w, request.WithContext(WithGrants(request.Context(), Grants{
			UserID:      userID,
			Permissions: granted,
			StaleRoles:  stale,
		})))
	})
}
