// NewServer constructs the application's strict OpenAPI adapter.
//
// cursors issues and verifies the opaque pagination tokens every cursor-paged
// collection uses. It is required rather than optional: a collection that
// silently fell back to an unauthenticated position would be exactly the
// defect the codec exists to prevent.
func NewServer(cursors *pagination.Codec) (*Server, error) {
	if cursors == nil {
		return nil, errors.New("httpapi: a cursor codec is required")
	}
	return &Server{cursors: cursors}, nil
