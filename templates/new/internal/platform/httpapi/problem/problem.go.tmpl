// Definition is one stable public problem type. Its fields are private so
// every value has passed NewDefinition's wire and safety validation.
type Definition struct {
	typeURI string
	title   string
	status  int
	detail  string
	code    string
}

// NewDefinition validates one application problem type.
func NewDefinition(typeURI, title string, status int, detail, code string) (Definition, error) {
	definition := Definition{typeURI: typeURI, title: title, status: status, detail: detail, code: code}
	if err := validateDefinition(definition); err != nil {
		return Definition{}, err
	}
	return definition, nil
}

// Status returns the definition's HTTP status code.
func (d Definition) Status() int { return d.status }

// Code returns the definition's stable machine-readable code.
func (d Definition) Code() string { return d.code }

