		{name: "nonempty", body: "data", want: false},
		{name: "oversized", body: strings.Repeat("x", int(MaxRequestBodyBytes)+1), wantError: ErrRequestBodyTooLarge},
	} {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			request := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(tc.body))
			got, err := IsBodyAbsent(httptest.NewRecorder(), request)
			if !errors.Is(err, tc.wantError) || got != tc.want {
				t.Fatalf("IsBodyAbsent = (%t, %v), want (%t, %v)", got, err, tc.want, tc.wantError)
