func TestWrite(t *testing.T) {
	t.Parallel()
	recorder := httptest.NewRecorder()
	if err := Write(recorder, http.StatusCreated, map[string]string{"state": "ok"}); err != nil {
		t.Fatalf("Write: %v", err)
	}
	if recorder.Code != http.StatusCreated || recorder.Header().Get("Content-Type") != "application/json" || recorder.Body.String() != "{\"state\":\"ok\"}\n" {
		t.Fatalf("response = status %d, headers %v, body %q", recorder.Code, recorder.Header(), recorder.Body.String())
	}

	oversized := httptest.NewRecorder()
	if err := Write(oversized, http.StatusOK, strings.Repeat("x", int(MaxResponseBodyBytes))); !errors.Is(err, ErrResponseBodyTooLarge) {
		t.Fatalf("oversized Write error = %v, want ErrResponseBodyTooLarge", err)
	}
	if oversized.Body.Len() != 0 || oversized.Header().Get("Content-Type") != "" {
		t.Fatalf("oversized response was partially committed: headers %v, body bytes %d", oversized.Header(), oversized.Body.Len())
	}

	exact := httptest.NewRecorder()
	value := strings.Repeat("x", int(MaxResponseBodyBytes)-3) // quotes plus encoder newline
	if err := Write(exact, http.StatusOK, value); err != nil {
		t.Fatalf("exact-limit Write: %v", err)
	}
	if exact.Body.Len() != int(MaxResponseBodyBytes) {
		t.Fatalf("exact-limit response bytes = %d, want %d", exact.Body.Len(), MaxResponseBodyBytes)
	}

	problem := httptest.NewRecorder()
	if err := WriteMediaType(problem, http.StatusBadRequest, "application/problem+json", map[string]string{"title": "Invalid Request"}); err != nil {
		t.Fatalf("WriteMediaType: %v", err)
	}
	if got := problem.Header().Get("Content-Type"); got != "application/problem+json" {
		t.Fatalf("problem Content-Type = %q", got)
	}

	invalid := httptest.NewRecorder()
	if err := WriteMediaType(invalid, http.StatusOK, "application/json\r\nX-Injected: yes", struct{}{}); err == nil {
		t.Fatal("WriteMediaType accepted a header-injection media type")
	}
	if invalid.Body.Len() != 0 || invalid.Header().Get("Content-Type") != "" {
		t.Fatalf("invalid media type committed a response: headers %v, body %q", invalid.Header(), invalid.Body.String())
	}
}
