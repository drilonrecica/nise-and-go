func TestDecode(t *testing.T) {
	t.Parallel()
	type payload struct {
		Name   string `json:"name"`
		Nested struct {
			Value int `json:"value"`
		} `json:"nested"`
	}

	tests := []struct {
		name        string
		body        string
		contentType string
		want        payload
		wantError   error
	}{
		{name: "valid", body: `{"name":"ok","nested":{"value":2}}`, contentType: "application/json; charset=utf-8", want: payload{Name: "ok", Nested: struct {
			Value int `json:"value"`
		}{Value: 2}}},
		{name: "empty", body: " \n\t", wantError: io.EOF},
		{name: "malformed", body: `{"name":`, contentType: "application/json", wantError: ErrInvalidJSON},
		{name: "trailing value", body: `{"name":"ok"} {}`, contentType: "application/json", wantError: ErrInvalidJSON},
		{name: "unknown field", body: `{"name":"ok","extra":true}`, contentType: "application/json", wantError: ErrInvalidJSON},
		{name: "duplicate field", body: `{"name":"first","Name":"second"}`, contentType: "application/json", wantError: ErrInvalidJSON},
		{name: "duplicate nested field", body: `{"nested":{"value":1,"value":2}}`, contentType: "application/json", wantError: ErrInvalidJSON},
		{name: "wrong media type", body: `{"name":"ok"}`, contentType: "text/json", wantError: ErrUnsupportedMediaType},
		{name: "missing media type", body: `{"name":"ok"}`, wantError: ErrUnsupportedMediaType},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			request := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(tc.body))
			request.Header.Set("Content-Type", tc.contentType)
			var got payload
			err := Decode(httptest.NewRecorder(), request, "application/json", &got)
			if !errors.Is(err, tc.wantError) {
				t.Fatalf("Decode error = %v, want errors.Is(_, %v)", err, tc.wantError)
			}
			if tc.wantError == nil && got != tc.want {
				t.Errorf("Decode value = %#v, want %#v", got, tc.want)
			}
		})
	}
}

