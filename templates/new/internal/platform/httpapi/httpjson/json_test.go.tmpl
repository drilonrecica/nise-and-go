func TestFoldKeyMatchesUnicodeEqualFold(t *testing.T) {
	t.Parallel()
	pairs := [][2]string{
		{"K", "\u212a"},
		{"S", "\u017f"},
		{"name", "NAME"},
	}
	for _, pair := range pairs {
		if !strings.EqualFold(pair[0], pair[1]) {
			t.Fatalf("test pair %q and %q is not EqualFold-equivalent", pair[0], pair[1])
		}
		if foldKey(pair[0]) != foldKey(pair[1]) {
			t.Errorf("foldKey(%q) != foldKey(%q)", pair[0], pair[1])
		}
	}
	if foldKey("name") == foldKey("names") {
		t.Error("foldKey merged unrelated keys")
	}
}

