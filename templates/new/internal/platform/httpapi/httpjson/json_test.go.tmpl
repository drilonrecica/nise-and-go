func TestDecodeAcceptsManyUniqueObjectKeys(t *testing.T) {
	t.Parallel()
	var body strings.Builder
	body.WriteByte('{')
	const keyCount = 20_000
	for i := range keyCount {
		if i > 0 {
			body.WriteByte(',')
		}
		body.WriteString(strconv.Quote("k" + strconv.Itoa(i)))
		body.WriteString(":0")
	}
	body.WriteByte('}')
	request := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body.String()))
	request.Header.Set("Content-Type", "application/json")
	var got map[string]int
	if err := Decode(httptest.NewRecorder(), request, "application/json", &got); err != nil {
		t.Fatalf("Decode high-cardinality object: %v", err)
	}
	if len(got) != keyCount {
		t.Fatalf("decoded keys = %d, want %d", len(got), keyCount)
	}
}

