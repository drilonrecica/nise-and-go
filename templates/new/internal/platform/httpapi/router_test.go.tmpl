func TestRecoveryResponseWriterRetainsStateWhenHijackIsUnsupported(t *testing.T) {
	t.Parallel()
	target := httptest.NewRecorder()
	writer := newRecoveryResponseWriter(target)
	writer.Header().Set("X-Staged", "yes")
	writer.WriteHeader(http.StatusAccepted)
	_, _ = writer.Write([]byte("staged body"))

	if _, _, err := writer.Hijack(); !errors.Is(err, http.ErrNotSupported) {
		t.Fatalf("Hijack error = %v, want http.ErrNotSupported", err)
	}
	if writer.passthrough {
		t.Fatal("unsupported hijack irreversibly changed the writer to passthrough")
	}
	if err := writer.commit(); err != nil {
		t.Fatalf("commit after unsupported hijack: %v", err)
	}
	if target.Code != http.StatusAccepted || target.Body.String() != "staged body" || target.Header().Get("X-Staged") != "yes" {
		t.Fatalf("committed response = status %d, headers %v, body %q", target.Code, target.Header(), target.Body.String())
	}
}

func TestRecoveryResponseWriterCarriesStagedResponseIntoHijack(t *testing.T) {
	t.Parallel()
	policy, err := secure.NewAPIPolicy(secure.Development)
	if err != nil {
		t.Fatalf("NewAPIPolicy: %v", err)
	}
	target := newHijackRecorder()
	var writer *recoveryResponseWriter
	var readWriter *bufio.ReadWriter
	secure.Middleware(policy)(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		writer = newRecoveryResponseWriter(w)
		writer.Header().Set("X-Staged", "yes")
		writer.Header().Set(secure.HeaderCSP, "default-src *")
		writer.WriteHeader(http.StatusAccepted)
		_, _ = writer.Write([]byte("staged body"))
		_, readWriter, err = writer.Hijack()
	})).ServeHTTP(target, httptest.NewRequest(http.MethodGet, "/", nil))
	if err != nil {
		t.Fatalf("Hijack: %v", err)
	}
	if !writer.passthrough {
		t.Fatal("successful hijack did not mark the response irreversible")
	}
	if err := readWriter.Writer.Flush(); err != nil {
		t.Fatalf("flush hijacked writer: %v", err)
	}
	for _, fragment := range []string{"HTTP/1.1 202 Accepted", "X-Staged: yes", "staged body", "Content-Security-Policy: " + policy.ContentSecurityPolicy()} {
		if !strings.Contains(target.output.String(), fragment) {
			t.Errorf("hijacked response lacks %q: %q", fragment, target.output.String())
		}
	}
	if strings.Contains(target.output.String(), "default-src *") {
		t.Fatalf("hijacked response retained weakened CSP: %q", target.output.String())
	}
}

func TestRecoveryResponseWriterFullDuplexSwitchesToPassthrough(t *testing.T) {
	t.Parallel()
	target := &fullDuplexRecorder{ResponseRecorder: httptest.NewRecorder()}
	writer := newRecoveryResponseWriter(target)
	if err := http.NewResponseController(writer).EnableFullDuplex(); err != nil {
		t.Fatalf("EnableFullDuplex: %v", err)
	}
	if !target.enabled || !writer.passthrough {
		t.Fatalf("full duplex state = target enabled %t, passthrough %t; want both true", target.enabled, writer.passthrough)
	}
	writer.Header().Set("Content-Type", "application/octet-stream")
	writer.WriteHeader(http.StatusAccepted)
	_, _ = writer.Write([]byte("duplex body"))
	if target.Code != http.StatusAccepted || target.Body.String() != "duplex body" {
		t.Fatalf("full duplex response = status %d, body %q", target.Code, target.Body.String())
	}
}

func TestRecoveryResponseWriterSupportsRealHTTP1FullDuplex(t *testing.T) {
	handlerErr := make(chan error, 1)
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	handler := recoverer(logger, fixedHTTPError(http.StatusInternalServerError, "internal server error"), true)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if err := http.NewResponseController(w).EnableFullDuplex(); err != nil {
			handlerErr <- err
			return
		}
		_, _ = io.WriteString(w, "ready\n")
		if err := http.NewResponseController(w).Flush(); err != nil {
			handlerErr <- err
			return
		}
		marker := make([]byte, len("finish"))
		if _, err := io.ReadFull(r.Body, marker); err != nil {
			handlerErr <- err
			return
		}
		if string(marker) != "finish" {
			handlerErr <- fmt.Errorf("request marker = %q, want finish", marker)
			return
		}
		if _, err := io.Copy(io.Discard, r.Body); err != nil {
			handlerErr <- err
			return
		}
		_, _ = io.WriteString(w, "done\n")
		handlerErr <- nil
	}))
	server := httptest.NewServer(handler)
	t.Cleanup(server.Close)

	requestReader, requestWriter := io.Pipe()
	t.Cleanup(func() { _ = requestWriter.Close() })
	request, err := http.NewRequest(http.MethodPost, server.URL, requestReader)
	if err != nil {
		t.Fatalf("NewRequest: %v", err)
	}
	client := server.Client()
	client.Timeout = 5 * time.Second
	responseResult := make(chan struct {
		response *http.Response
		err      error
	}, 1)
	go func() {
		response, err := client.Do(request)
		responseResult <- struct {
			response *http.Response
			err      error
		}{response: response, err: err}
	}()

	var response *http.Response
	select {
	case result := <-responseResult:
		if result.err != nil {
			t.Fatalf("Do before request completion: %v", result.err)
		}
		response = result.response
	case <-time.After(3 * time.Second):
		t.Fatal("HTTP/1 response did not arrive before request-body completion")
	}
	t.Cleanup(func() { _ = response.Body.Close() })
	prefix := make([]byte, len("ready\n"))
	if _, err := io.ReadFull(response.Body, prefix); err != nil || string(prefix) != "ready\n" {
		t.Fatalf("response prefix = %q, %v; want ready", prefix, err)
	}
	if _, err := requestWriter.Write([]byte("finish")); err != nil {
		t.Fatalf("write request marker after response: %v", err)
	}
	if err := requestWriter.Close(); err != nil {
		t.Fatalf("close request body: %v", err)
	}
	remainder, err := io.ReadAll(response.Body)
	if err != nil || string(remainder) != "done\n" {
		t.Fatalf("response remainder = %q, %v; want done", remainder, err)
	}
	if err := <-handlerErr; err != nil {
		t.Fatalf("full-duplex handler: %v", err)
	}
}

func TestRecoveryResponseWriterPreservesInformationalThenFinalStatus(t *testing.T) {
	t.Parallel()
	policy, err := secure.NewAPIPolicy(secure.Development)
	if err != nil {
		t.Fatalf("NewAPIPolicy: %v", err)
	}
	target := &statusSequenceWriter{header: make(http.Header)}
	secure.Middleware(policy)(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		writer := newRecoveryResponseWriter(w)
		writer.Header().Set(secure.HeaderCSP, "default-src *")
		writer.WriteHeader(http.StatusEarlyHints)
		writer.Header().Set(secure.HeaderCSP, "default-src *; script-src *")
		writer.WriteHeader(http.StatusCreated)
		_, _ = writer.Write([]byte("created"))
		if err := writer.commit(); err != nil {
			t.Errorf("commit: %v", err)
		}
	})).ServeHTTP(target, httptest.NewRequest(http.MethodGet, "/", nil))
	if got, want := target.statuses, []int{http.StatusEarlyHints, http.StatusCreated}; !reflect.DeepEqual(got, want) {
		t.Fatalf("status sequence = %v, want %v", got, want)
	}
	if target.body.String() != "created" {
		t.Fatalf("body = %q, want created", target.body.String())
	}
	for index, header := range target.headerSnapshots {
		if got := header.Get(secure.HeaderCSP); got != policy.ContentSecurityPolicy() {
			t.Errorf("status %d CSP = %q, want %q", target.statuses[index], got, policy.ContentSecurityPolicy())
		}
	}
}

