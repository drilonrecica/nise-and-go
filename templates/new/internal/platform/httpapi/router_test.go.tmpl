func TestRouterUsesIndependentAPIAndDocumentPolicies(t *testing.T) {
	chi.RegisterMethod("PROPFIND")
	deps, _, _ := routerTestDeps(t)
	deps.RegisterAPI = func(r chi.Router) {
		r.Get("/probe", func(w http.ResponseWriter, _ *http.Request) {
			w.Header().Set(secure.HeaderCSP, "default-src *")
			w.Header().Set("Content-Type", "application/json")
			_, _ = io.WriteString(w, `{"surface":"api"}`)
		})
		r.Head("/probe", func(w http.ResponseWriter, _ *http.Request) {
			w.WriteHeader(http.StatusNoContent)
		})
		r.MethodFunc("PROPFIND", "/probe", func(w http.ResponseWriter, _ *http.Request) {
			w.WriteHeader(http.StatusNoContent)
		})
	}
	handler, err := New(deps)
	if err != nil {
		t.Fatalf("New: %v", err)
	}

	apiResponse := serveRouter(handler, "/api/v1/probe")
	if apiResponse.Code != http.StatusOK {
		t.Fatalf("API status = %d, want 200", apiResponse.Code)
	}
	apiPolicy, err := secure.NewAPIPolicy(secure.Development)
	if err != nil {
		t.Fatalf("NewAPIPolicy: %v", err)
	}
	if got := apiResponse.Header().Get(secure.HeaderCSP); got != apiPolicy.ContentSecurityPolicy() {
		t.Fatalf("API CSP = %q, want independent API policy %q", got, apiPolicy.ContentSecurityPolicy())
	}
	if strings.Contains(apiResponse.Header().Get(secure.HeaderCSP), "default-src *") {
		t.Fatal("API handler weakened the security policy")
	}
	methodResponse := serveRouterMethod(handler, http.MethodPost, "/api/v1/probe")
	if methodResponse.Code != http.StatusMethodNotAllowed {
		t.Fatalf("known API path with wrong method status = %d, want 405", methodResponse.Code)
	}
	if got, want := methodResponse.Header().Values("Allow"), []string{http.MethodGet, http.MethodHead, "PROPFIND"}; !reflect.DeepEqual(got, want) {
		t.Fatalf("known API path Allow = %v, want %v", got, want)
	}
	assertAPIProblem(t, methodResponse, http.StatusMethodNotAllowed, "method_not_allowed")
	if got := methodResponse.Header().Get(secure.HeaderCSP); got != apiPolicy.ContentSecurityPolicy() {
		t.Fatalf("API method rejection CSP = %q, want API policy", got)
	}

	documentResponse := serveRouter(handler, "/healthz/live")
	if documentResponse.Code != http.StatusOK {
		t.Fatalf("document status = %d, want 200", documentResponse.Code)
	}
	documentPolicy, err := secure.NewDocumentPolicy(
		secure.Development,
		secure.WithScriptHashes(deps.UI.ScriptHashes()...),
		secure.WithStyleHashes(deps.UI.StyleHashes()...),
	)
	if err != nil {
		t.Fatalf("NewDocumentPolicy: %v", err)
	}
	if got := documentResponse.Header().Get(secure.HeaderCSP); got != documentPolicy.ContentSecurityPolicy() {
		t.Fatalf("document CSP = %q, want %q", got, documentPolicy.ContentSecurityPolicy())
	}
	if documentResponse.Header().Get(secure.HeaderCSP) == apiResponse.Header().Get(secure.HeaderCSP) {
		t.Fatal("API and document responses used the same CSP")
	}
}

func TestRouterCoreWrapsApplicationMiddleware(t *testing.T) {
	deps, registry, logs := routerTestDeps(t)
	events := make([]string, 0, 5)
	deps.Middleware.API = []Middleware{
		recordRouterEvents(&events, "first"),
		recordRouterEvents(&events, "second"),
	}
	deps.RegisterAPI = func(r chi.Router) {
		r.Get("/probe", func(w http.ResponseWriter, r *http.Request) {
			if _, ok := logging.RequestID(r.Context()); !ok {
				t.Error("application handler has no core request ID")
			}
			if _, ok := logging.CorrelationID(r.Context()); !ok {
				t.Error("application handler has no core correlation ID")
			}
			events = append(events, "handler")
			w.Header().Set(secure.HeaderCSP, "default-src *")
			w.WriteHeader(http.StatusNoContent)
		})
		r.Get("/panic", func(w http.ResponseWriter, _ *http.Request) {
			w.Header().Set(logging.DefaultRequestIDHeader, "hostile-request-id")
			w.Header().Set(logging.DefaultCorrelationIDHeader, "hostile-correlation-id")
			panic("router-test-panic")
		})
		r.Get("/write-then-panic", func(w http.ResponseWriter, _ *http.Request) {
			w.WriteHeader(http.StatusAccepted)
			_, _ = io.WriteString(w, "partial-secret-value")
			panic("write-then-panic-secret")
		})
		r.Get("/flush-then-panic", func(w http.ResponseWriter, _ *http.Request) {
			w.Header().Set("Content-Type", "text/event-stream")
			_, _ = io.WriteString(w, "stream-prefix")
			if err := http.NewResponseController(w).Flush(); err != nil {
				panic(err)
			}
			panic("flush-then-panic-secret")
		})
	}
	handler, err := New(deps)
	if err != nil {
		t.Fatalf("New: %v", err)
	}

	response := serveRouter(handler, "/api/v1/probe")
	if response.Code != http.StatusNoContent {
		t.Fatalf("status = %d, want 204", response.Code)
	}
	wantEvents := []string{"first:before", "second:before", "handler", "second:after", "first:after"}
	if !reflect.DeepEqual(events, wantEvents) {
		t.Fatalf("application middleware events = %v, want %v", events, wantEvents)
	}
	apiPolicy, err := secure.NewAPIPolicy(secure.Development)
	if err != nil {
		t.Fatalf("NewAPIPolicy: %v", err)
	}
	if got := response.Header().Get(secure.HeaderCSP); got != apiPolicy.ContentSecurityPolicy() {
		t.Fatalf("core security did not wrap application middleware: CSP = %q", got)
	}

	panicResponse := serveRouter(handler, "/api/v1/panic")
	if panicResponse.Code != http.StatusInternalServerError {
		t.Fatalf("panic status = %d, want 500", panicResponse.Code)
	}
	if got := panicResponse.Header().Get(secure.HeaderCSP); got != apiPolicy.ContentSecurityPolicy() {
		t.Fatalf("recovered panic lacks API CSP: %q", got)
	}
	assertAPIProblem(t, panicResponse, http.StatusInternalServerError, "internal_server_error")
	if !strings.Contains(logs.String(), "panic serving request") ||
		!strings.Contains(logs.String(), `"panic_type":"string"`) ||
		!strings.Contains(logs.String(), `"request_id"`) ||
		!strings.Contains(logs.String(), `"correlation_id"`) {
		t.Fatalf("core recovery did not log panic: %s", logs.String())
	}
	if strings.Contains(logs.String(), "router-test-panic") || strings.Contains(panicResponse.Body.String(), "router-test-panic") {
		t.Fatalf("core recovery exposed the panic value: response %q, logs %s", panicResponse.Body.String(), logs.String())
	}

	partialResponse := serveRouter(handler, "/api/v1/write-then-panic")
	assertAPIProblem(t, partialResponse, http.StatusInternalServerError, "internal_server_error")
	for _, forbidden := range []string{"partial-secret-value", "write-then-panic-secret"} {
		if strings.Contains(partialResponse.Body.String(), forbidden) || strings.Contains(logs.String(), forbidden) {
			t.Fatalf("write-then-panic exposed %q: response %q, logs %s", forbidden, partialResponse.Body.String(), logs.String())
		}
	}

	streamResponse, recovered := serveRouterRecover(handler, "/api/v1/flush-then-panic")
	if recoveredErr, ok := recovered.(error); !ok || !errors.Is(recoveredErr, http.ErrAbortHandler) {
		t.Fatalf("flush-then-panic recovered value = %#v, want http.ErrAbortHandler", recovered)
	}
	if got := streamResponse.Body.String(); got != "stream-prefix" {
		t.Fatalf("flushed streaming response = %q, want original committed prefix only", got)
	}
	if got := streamResponse.Header().Get("Content-Type"); got != "text/event-stream" {
		t.Fatalf("flushed streaming Content-Type = %q, want text/event-stream", got)
	}
	if strings.Contains(logs.String(), "flush-then-panic-secret") {
		t.Fatalf("streaming recovery exposed panic value: %s", logs.String())
	}
	var metrics bytes.Buffer
	if err := observability.WriteText(&metrics, registry); err != nil {
		t.Fatalf("WriteText: %v", err)
	}
	for _, fragment := range []string{
		"http_requests_total",
		`route="/api/v1/probe"`,
		`status_class="2xx"`,
		`status_class="panic"`,
	} {
		if !strings.Contains(metrics.String(), fragment) {
			t.Errorf("core metrics lack %q:\n%s", fragment, metrics.String())
		}
	}
}

func TestRouterKeepsUnmatchedAPIPathsOutOfTheUI(t *testing.T) {
	deps, _, _ := routerTestDeps(t)
	apiCalls := 0
	documentCalls := 0
	deps.Middleware.API = []Middleware{countRouterCalls(&apiCalls)}
	deps.Middleware.Document = []Middleware{countRouterCalls(&documentCalls)}
	handler, err := New(deps)
	if err != nil {
		t.Fatalf("New: %v", err)
	}
	apiPolicy, err := secure.NewAPIPolicy(secure.Development)
	if err != nil {
		t.Fatalf("NewAPIPolicy: %v", err)
	}

	for _, requestPath := range []string{"/api/v1", "/api/v1/", "/api/v1/missing"} {
		response := serveRouter(handler, requestPath)
		if response.Code != http.StatusNotFound {
			t.Errorf("%s status = %d, want API 404", requestPath, response.Code)
		}
		if got := response.Header().Get(secure.HeaderCSP); got != apiPolicy.ContentSecurityPolicy() {
			t.Errorf("%s CSP = %q, want API policy", requestPath, got)
		}
		assertAPIProblem(t, response, http.StatusNotFound, "not_found")
	}
	if apiCalls != 3 || documentCalls != 0 {
		t.Fatalf("unmatched API calls = api:%d document:%d, want 3/0", apiCalls, documentCalls)
	}

	documentResponse := serveRouter(handler, "/api/v10/missing")
	if documentResponse.Code != http.StatusOK {
		t.Fatalf("non-API lookalike status = %d, want UI 200", documentResponse.Code)
	}
	if documentCalls != 1 || apiCalls != 3 {
		t.Fatalf("lookalike calls = api:%d document:%d, want 3/1", apiCalls, documentCalls)
	}
	if documentResponse.Header().Get(secure.HeaderCSP) == apiPolicy.ContentSecurityPolicy() {
		t.Fatal("non-API lookalike received the API policy")
	}
}

