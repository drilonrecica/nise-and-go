func serveRouter(handler http.Handler, requestPath string) *httptest.ResponseRecorder {
	return serveRouterMethod(handler, http.MethodGet, requestPath)
}

func serveRouterMethod(handler http.Handler, method, requestPath string) *httptest.ResponseRecorder {
	response := httptest.NewRecorder()
	handler.ServeHTTP(response, httptest.NewRequest(method, requestPath, nil))
	return response
}

func serveRouterRecover(handler http.Handler, requestPath string) (response *httptest.ResponseRecorder, recovered any) {
	response = httptest.NewRecorder()
	defer func() { recovered = recover() }()
	handler.ServeHTTP(response, httptest.NewRequest(http.MethodGet, requestPath, nil))
	return response, nil
}

func recordRouterEvents(events *[]string, name string) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			*events = append(*events, name+":before")
			defer func() { *events = append(*events, name+":after") }()
			next.ServeHTTP(w, r)
		})
	}
}

func countRouterCalls(calls *int) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			(*calls)++
			next.ServeHTTP(w, r)
		})
	}
}

type fullDuplexRecorder struct {
	*httptest.ResponseRecorder
	enabled bool
}

func (r *fullDuplexRecorder) EnableFullDuplex() error {
	r.enabled = true
	return nil
}

type statusSequenceWriter struct {
	header          http.Header
	statuses        []int
	headerSnapshots []http.Header
	body            bytes.Buffer
}

type hijackRecorder struct {
	header http.Header
	output bytes.Buffer
	rw     *bufio.ReadWriter
}

func newHijackRecorder() *hijackRecorder {
	recorder := &hijackRecorder{header: make(http.Header)}
	recorder.rw = bufio.NewReadWriter(bufio.NewReader(strings.NewReader("")), bufio.NewWriter(&recorder.output))
	return recorder
}

func (w *hijackRecorder) Header() http.Header { return w.header }

func (w *hijackRecorder) WriteHeader(int) {}

func (w *hijackRecorder) Write(data []byte) (int, error) { return w.output.Write(data) }

func (w *hijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
	return nil, w.rw, nil
}

func (w *statusSequenceWriter) Header() http.Header { return w.header }

func (w *statusSequenceWriter) WriteHeader(status int) {
	w.statuses = append(w.statuses, status)
	w.headerSnapshots = append(w.headerSnapshots, w.header.Clone())
}

func (w *statusSequenceWriter) Write(data []byte) (int, error) {
	return w.body.Write(data)
}

func assertAPIProblem(t *testing.T, response *httptest.ResponseRecorder, status int, code string) {
	t.Helper()
	if got := response.Header().Get("Content-Type"); got != problem.MediaType {
		t.Fatalf("Content-Type = %q, want %q", got, problem.MediaType)
	}
	var body openapigen.Problem
	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode API problem: %v", err)
	}
	if body.Status != int32(status) || body.Code != code {
		t.Fatalf("problem = status %d, code %q; want status %d, code %q", body.Status, body.Code, status, code)
	}
	if body.RequestId == "" || body.RequestId != response.Header().Get(logging.DefaultRequestIDHeader) {
		t.Fatalf("problem request_id = %q, response header = %q", body.RequestId, response.Header().Get(logging.DefaultRequestIDHeader))
	}
	if body.CorrelationId == "" || body.CorrelationId != response.Header().Get(logging.DefaultCorrelationIDHeader) {
		t.Fatalf("problem correlation_id = %q, response header = %q", body.CorrelationId, response.Header().Get(logging.DefaultCorrelationIDHeader))
	}
}
