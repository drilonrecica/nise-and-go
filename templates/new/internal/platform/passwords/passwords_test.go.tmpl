// Generated once by nise; owned by this application. Nise will not overwrite it.

package passwords

import (
	"strings"
	"testing"

	"github.com/drilonrecica/nise-and-go/runtime/password"
)

func TestPolicyIsConstructible(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	if policy.Current().IsZero() {
		t.Fatal("the policy has no current parameter set")
	}
	if policy.Current().MemoryKiB() < password.MinMemoryKiB {
		t.Errorf("current memory %d KiB is below the accepted floor", policy.Current().MemoryKiB())
	}
}

func TestPolicyVersionsAreDistinctAndCurrentIsHighest(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	versions := policy.Versions()
	if len(versions) == 0 {
		t.Fatal("the policy accepts no parameter versions")
	}
	// The current set must be the newest label in the history. A rotation
	// that forgot to raise the version would still work, and would make the
	// history unreadable the next time someone has to reason about it.
	for _, version := range versions {
		if version > policy.Current().Version() {
			t.Errorf("superseded version %d is above the current %d", version, policy.Current().Version())
		}
	}
}

func TestPolicyHashesAndVerifies(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	const secret = "a password this application will never store in plaintext"

	encoded, err := policy.Hash(secret)
	if err != nil {
		t.Fatalf("Hash: %v", err)
	}
	if strings.Contains(encoded, secret) {
		t.Fatal("the stored hash contains the password")
	}
	verification, err := policy.Verify(encoded, secret)
	if err != nil {
		t.Fatalf("Verify: %v", err)
	}
	if !verification.Match {
		t.Fatal("a freshly hashed password did not verify")
	}
	if verification.NeedsRehash {
		t.Error("a freshly hashed password was flagged for rehash; Current is not the set Hash used")
	}
}
