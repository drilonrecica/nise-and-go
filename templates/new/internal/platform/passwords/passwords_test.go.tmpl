func TestPolicyIsConstructible(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	if policy.Current().IsZero() {
		t.Fatal("the policy has no current parameter set")
	}
	if policy.Current().MemoryKiB() < password.MinMemoryKiB {
		t.Errorf("current memory %d KiB is below the accepted floor", policy.Current().MemoryKiB())
	}
}

func TestPolicyVersionsAreDistinctAndCurrentIsHighest(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	versions := policy.Versions()
	if len(versions) == 0 {
		t.Fatal("the policy accepts no parameter versions")
	}
	// The current set must be the newest label in the history. A rotation
	// that forgot to raise the version would still work, and would make the
	// history unreadable the next time someone has to reason about it.
	for _, version := range versions {
		if version > policy.Current().Version() {
			t.Errorf("superseded version %d is above the current %d", version, policy.Current().Version())
		}
	}
}

func TestPolicyHashesAndVerifies(t *testing.T) {
	t.Parallel()

	policy, err := Policy()
	if err != nil {
		t.Fatalf("Policy: %v", err)
	}
	const secret = "a password this application will never store in plaintext"

	encoded, err := policy.Hash(secret)
	if err != nil {
		t.Fatalf("Hash: %v", err)
	}
	if strings.Contains(encoded, secret) {
		t.Fatal("the stored hash contains the password")
	}
	verification, err := policy.Verify(encoded, secret)
	if err != nil {
		t.Fatalf("Verify: %v", err)
	}
	if !verification.Match {
		t.Fatal("a freshly hashed password did not verify")
	}
	if verification.NeedsRehash {
		t.Error("a freshly hashed password was flagged for rehash; Current is not the set Hash used")
	}
}

func TestCheckEmphasizesLengthAndNothingElse(t *testing.T) {
	t.Parallel()

	compromised, err := Compromised()
	if err != nil {
		t.Fatalf("Compromised: %v", err)
	}
	const address = "person@example.test"

	// No composition rules: a long passphrase of nothing but lowercase words
	// is accepted, because requiring a digit and a symbol pushes people
	// towards predictable substitutions of short words rather than towards
	// length.
	accepted := []string{
		"correct horse battery staple",
		"a long enough sentence to be a password",
		strings.Repeat("x", MinLength),
		strings.Repeat("y", MaxLength),
	}
	for _, secret := range accepted {
		if err := Check(context.Background(), secret, address, compromised); err != nil {
			t.Errorf("Check(%d bytes) = %v, want acceptance", len(secret), err)
		}
	}

	rejected := map[string]error{
		strings.Repeat("x", MinLength-1): ErrTooShort,
		"":                               ErrTooShort,
		strings.Repeat("y", MaxLength+1): ErrTooLong,
		"personpassword12":               ErrDerivedFromAddress,
	}
	for secret, want := range rejected {
		if err := Check(context.Background(), secret, address, compromised); !errors.Is(err, want) {
			t.Errorf("Check(%d bytes) = %v, want %v", len(secret), err, want)
		}
	}
}

func TestCheckRefusesKnownCompromisedPasswords(t *testing.T) {
	t.Parallel()

	compromised, err := Compromised()
	if err != nil {
		t.Fatalf("Compromised: %v", err)
	}
	// An uncommon password of the same length is accepted, so the refusal
	// below is the list doing its job rather than a length rule.
	if err := Check(context.Background(), "correcthorsebattery", "person@example.test", compromised); err != nil {
		t.Fatalf("a long uncommon password was refused: %v", err)
	}

	list, err := password.NewCommonList([]string{"correcthorsebattery"})
	if err != nil {
		t.Fatalf("NewCommonList: %v", err)
	}
	if err := Check(context.Background(), "correcthorsebattery", "person@example.test", list); !errors.Is(err, ErrCompromised) {
		t.Fatalf("a listed password was accepted: %v", err)
	}
}

// failingChecker stands in for a compromised-password source that cannot
// answer, which is different from one that answers "no".
type failingChecker struct{}

func (failingChecker) IsCompromised(context.Context, string) (bool, error) {
	return false, errors.New("the source is unavailable")
}

func TestCheckDeniesWhenTheSourceCannotAnswer(t *testing.T) {
	t.Parallel()

	// Failing open here would accept a weak password during an outage,
	// silently, exactly when nobody is looking.
	err := Check(context.Background(), "a long enough password", "person@example.test", failingChecker{})
	if !errors.Is(err, ErrCheckUnavailable) {
		t.Fatalf("error = %v, want ErrCheckUnavailable", err)
	}
	if errors.Is(err, ErrCompromised) {
		t.Error("an unavailable source was reported as a compromised password")
	}
}

func TestCheckRefusesPasswordsDerivedFromTheAddress(t *testing.T) {
	t.Parallel()

	compromised, err := Compromised()
	if err != nil {
		t.Fatalf("Compromised: %v", err)
	}
	derived := map[string]string{
		"the whole address":     "person@example.test-and-more",
		"the local part":        "myperson-password",
		"the local part folded": "MYPERSONPASSWORD",
	}
	for name, secret := range derived {
		t.Run(name, func(t *testing.T) {
			t.Parallel()
			if err := Check(context.Background(), secret, "person@example.test", compromised); !errors.Is(err, ErrDerivedFromAddress) {
				t.Fatalf("error = %v, want ErrDerivedFromAddress", err)
			}
		})
	}

	// A short local part must not refuse passwords that merely share two
	// letters with an address.
	if err := Check(context.Background(), "abcdefghijklmn", "ab@example.test", compromised); err != nil {
		t.Errorf("a short local part refused an unrelated password: %v", err)
	}
	// No address at all is not a reason to refuse.
	if err := Check(context.Background(), "a long enough password", "", compromised); err != nil {
		t.Errorf("Check with no address: %v", err)
	}
}
