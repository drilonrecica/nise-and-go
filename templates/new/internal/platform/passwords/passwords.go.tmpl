// Generated once by nise; owned by this application. Nise will not overwrite it.

// Package passwords holds this application's Argon2id parameter history.
//
// The history is code rather than configuration, deliberately. Two things
// depend on every replica agreeing about it: which stored hashes verify, and
// which ones are rewritten at login. A replica reading a different environment
// variable would silently lock some accounts out and silently leave others on
// old parameters, and neither failure announces itself.
//
// Raising the parameters is therefore an ordinary code change, reviewed like
// any other:
//
//  1. Run `{{.AppName}} password benchmark` on the hardware that will serve
//     logins. It measures this machine, not a guess about it.
//  2. Add the recommended set as a new version below and make it Current.
//  3. Move the previous set into Superseded, and leave it there until enough
//     users have logged in for the rehash to have reached them.
//  4. Only then remove it. Removing a set is what locks its records out of
//     password login, which is sometimes intended and must never be accidental.
package passwords

import (
	"fmt"

	"github.com/drilonrecica/nise-and-go/runtime/password"
)

// current is the parameter set new and rehashed passwords are written under.
//
// It is the framework's shipped floor, which meets current OWASP guidance and
// claims nothing about this deployment's hardware. Replace it with the
// benchmark's recommendation before this application serves real logins.
func current() (password.Params, error) {
	shipped := password.Default()
	return password.NewParams(1, shipped.MemoryKiB(), shipped.Iterations(), shipped.Parallelism())
}

// superseded lists the older parameter sets that still verify.
//
// It is empty because there has been no rotation yet. Each entry stays until
// its records have been rehashed at login; a version removed from here can no
// longer let its owners in.
func superseded() ([]password.Params, error) {
	return nil, nil
}

// Policy builds this application's password policy.
func Policy() (*password.Policy, error) {
	currentParams, err := current()
	if err != nil {
		return nil, fmt.Errorf("current password parameters: %w", err)
	}
	previous, err := superseded()
	if err != nil {
		return nil, fmt.Errorf("superseded password parameters: %w", err)
	}
	policy, err := password.NewPolicy(currentParams, previous...)
	if err != nil {
		return nil, fmt.Errorf("building the password policy: %w", err)
	}
	return policy, nil
}
