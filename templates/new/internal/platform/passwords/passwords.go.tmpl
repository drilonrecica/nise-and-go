// Generated once by nise; owned by this application. Nise will not overwrite it.

// Package passwords holds this application's Argon2id parameter history.
//
// The history is code rather than configuration, deliberately. Two things
// depend on every replica agreeing about it: which stored hashes verify, and
// which ones are rewritten at login. A replica reading a different environment
// variable would silently lock some accounts out and silently leave others on
// old parameters, and neither failure announces itself.
//
// Raising the parameters is therefore an ordinary code change, reviewed like
// any other:
//
//  1. Run `{{.AppName}} password benchmark` on the hardware that will serve
//     logins. It measures this machine, not a guess about it.
//  2. Add the recommended set as a new version below and make it Current.
//  3. Move the previous set into Superseded, and leave it there until enough
//     users have logged in for the rehash to have reached them.
//  4. Only then remove it. Removing a set is what locks its records out of
//     password login, which is sometimes intended and must never be accidental.
package passwords

import (
	"context"
	"errors"
	"fmt"
	"strings"

	"github.com/drilonrecica/nise-and-go/runtime/password"
)

// Length bounds for a password this application will accept when one is set.
//
// The minimum emphasizes length and nothing else. There are no composition
// rules — no required digit, no required symbol, no forbidden repeat — because
// they measurably push people towards predictable substitutions of short words
// and towards writing the result down, while adding little an attacker's
// dictionary does not already cover. Length, a known-compromised check, and
// throttling are what actually help.
const (
	// MinLength is the shortest password this application accepts.
	MinLength = 12
	// MaxLength is the longest. It matches the hasher's own bound; nothing
	// about a longer password is stronger, and an unbounded one is a value
	// to carry around.
	MaxLength = password.MaxPasswordBytes
	// minAddressFragment is the shortest local part worth refusing a
	// password for containing. Below it the check would refuse passwords
	// that merely share two letters with an address.
	minAddressFragment = 4
)

// Errors reported when a proposed password is refused.
var (
	// ErrTooShort reports a password below MinLength.
	ErrTooShort = errors.New("password is shorter than the minimum length")
	// ErrTooLong reports a password above MaxLength.
	ErrTooLong = errors.New("password is longer than the maximum length")
	// ErrCompromised reports a password known to have been breached.
	ErrCompromised = errors.New("password appears in a known-compromised list")
	// ErrDerivedFromAddress reports a password containing the account's own
	// address, which is the first thing anybody targeting that account tries.
	ErrDerivedFromAddress = errors.New("password contains the account's own address")
	// ErrCheckUnavailable reports that the compromised-password source could
	// not answer. It is deliberately distinct from a clean result: a caller
	// that treated them the same would accept a weak password during an
	// outage, silently, exactly when nobody is looking.
	ErrCheckUnavailable = errors.New("the compromised-password check could not be completed")
)

// Check reports whether a proposed password may be set for the given address.
//
// It is called wherever a password is chosen — enrollment, a reset, a change —
// and nowhere else. Verification of an existing password never consults it: a
// rule tightened today must not lock out an account whose password was fine
// when it was set, and telling somebody their existing password is now invalid
// at the login prompt is how they end up in a reset loop.
func Check(ctx context.Context, secret, email string, compromised password.Compromised) error {
	switch {
	case len(secret) < MinLength:
		return fmt.Errorf("%w: %d bytes, minimum is %d", ErrTooShort, len(secret), MinLength)
	case len(secret) > MaxLength:
		return fmt.Errorf("%w: %d bytes, maximum is %d", ErrTooLong, len(secret), MaxLength)
	}
	if containsAddress(secret, email) {
		return ErrDerivedFromAddress
	}
	if compromised == nil {
		return nil
	}
	breached, err := compromised.IsCompromised(ctx, secret)
	if err != nil {
		return fmt.Errorf("%w: %w", ErrCheckUnavailable, err)
	}
	if breached {
		return ErrCompromised
	}
	return nil
}

// Compromised returns the known-compromised source this application uses.
//
// It is the framework's small local list: offline, no configuration, and no
// privacy decision made on this application's behalf. Replace it here to use a
// full breach corpus, and see the framework's own documentation for what each
// choice costs.
func Compromised() (password.Compromised, error) {
	list, err := password.BuiltinCommonList()
	if err != nil {
		return nil, fmt.Errorf("loading the known-compromised password list: %w", err)
	}
	return list, nil
}

// containsAddress reports whether the password contains the address or its
// local part, case-folded.
func containsAddress(secret, email string) bool {
	address := strings.ToLower(strings.TrimSpace(email))
	if address == "" {
		return false
	}
	folded := strings.ToLower(secret)
	if strings.Contains(folded, address) {
		return true
	}
	local, _, found := strings.Cut(address, "@")
	return found && len(local) >= minAddressFragment && strings.Contains(folded, local)
}

// current is the parameter set new and rehashed passwords are written under.
//
// It is the framework's shipped floor, which meets current OWASP guidance and
// claims nothing about this deployment's hardware. Replace it with the
// benchmark's recommendation before this application serves real logins.
func current() (password.Params, error) {
	shipped := password.Default()
	return password.NewParams(1, shipped.MemoryKiB(), shipped.Iterations(), shipped.Parallelism())
}

// superseded lists the older parameter sets that still verify.
//
// It is empty because there has been no rotation yet. Each entry stays until
// its records have been rehashed at login; a version removed from here can no
// longer let its owners in.
func superseded() ([]password.Params, error) {
	return nil, nil
}

// Policy builds this application's password policy.
func Policy() (*password.Policy, error) {
	currentParams, err := current()
	if err != nil {
		return nil, fmt.Errorf("current password parameters: %w", err)
	}
	previous, err := superseded()
	if err != nil {
		return nil, fmt.Errorf("superseded password parameters: %w", err)
	}
	policy, err := password.NewPolicy(currentParams, previous...)
	if err != nil {
		return nil, fmt.Errorf("building the password policy: %w", err)
	}
	return policy, nil
}
