func FuzzARoundTripReturnsTheSameBytes(f *testing.F) {
	f.Add([]byte(nil))
	f.Add([]byte("a small database"))
	f.Add(bytes.Repeat([]byte("x"), chunkSize))

	key, err := NewKey()
	if err != nil {
		f.Fatalf("NewKey: %v", err)
	}
	additional := []byte(`{"format":1}`)

	f.Fuzz(func(t *testing.T, plaintext []byte) {
		var ciphertext bytes.Buffer
		if err := seal(&ciphertext, bytes.NewReader(plaintext), key, additional); err != nil {
			t.Fatalf("seal: %v", err)
		}
		var restored bytes.Buffer
		if err := open(&restored, bytes.NewReader(ciphertext.Bytes()), key, additional); err != nil {
			t.Fatalf("open: %v", err)
		}
		if !bytes.Equal(restored.Bytes(), plaintext) {
			t.Errorf("a %d-byte plaintext did not survive the round trip", len(plaintext))
		}
	})
}

// A sealed backup must never be openable by chance, whatever the input is.
func FuzzCorruptionIsAlwaysCaught(f *testing.F) {
	f.Add(uint32(0), byte(1))
	f.Add(uint32(7), byte(0x80))

	key, err := NewKey()
	if err != nil {
		f.Fatalf("NewKey: %v", err)
	}
	additional := []byte(`{"format":1}`)
	plaintext := []byte("a small database, sealed once and then attacked")
	var buf bytes.Buffer
	if err := seal(&buf, bytes.NewReader(plaintext), key, additional); err != nil {
		f.Fatalf("seal: %v", err)
	}
	full := buf.Bytes()

	f.Fuzz(func(t *testing.T, at uint32, flip byte) {
		if flip == 0 {
			t.Skip("flipping no bits leaves the backup intact")
		}
		damaged := append([]byte{}, full...)
		damaged[int(at%uint32(len(damaged)))] ^= flip

		if bytes.Equal(damaged, full) {
			t.Skip("the damage was a no-op")
		}
		var restored bytes.Buffer
		err := open(&restored, bytes.NewReader(damaged), key, additional)
		if err == nil && bytes.Equal(restored.Bytes(), plaintext) {
			// Damage to the nonce prefix alone cannot be detected by the
			// AEAD — it changes which nonce is tried, so it fails — and
			// damage anywhere else fails the tag. There is no byte whose
			// change leaves the plaintext intact.
			t.Errorf("flipping %#x at byte %d was not detected", flip, int(at%uint32(len(full))))
		}
	})
}
