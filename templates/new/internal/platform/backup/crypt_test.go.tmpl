func TestAWrongKeyIsRefusedAndSaysNothingMore(t *testing.T) {
	t.Parallel()
	additional := []byte(`{"format":1}`)
	full := sealed(t, testKey(t), additional, []byte("a small database"))

	_, err := opened(t, testKey(t), additional, full)
	if !errors.Is(err, ErrCorrupt) {
		t.Fatalf("error = %v, want ErrCorrupt", err)
	}
	// The wrong key and a tampered file must be indistinguishable: telling
	// somebody probing a backup which of the two they got wrong hands them
	// an oracle, and the caller can do nothing different with the answer.
	tampered := append([]byte{}, full...)
	tampered[len(tampered)-1] ^= 0x01
	_, tamperErr := opened(t, testKey(t), additional, tampered)
	if err.Error() != tamperErr.Error() {
		t.Errorf("a wrong key reports %q and a tampered file reports %q; they must not be distinguishable", err, tamperErr)
	}
}

