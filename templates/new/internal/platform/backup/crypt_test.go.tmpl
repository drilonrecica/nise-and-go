	t.Parallel()
	for _, length := range []int{0, 16, 31, 33, 64} {
		if err := seal(io.Discard, bytes.NewReader(nil), make([]byte, length), nil); !errors.Is(err, ErrKeyLength) {
			t.Errorf("seal with a %d-byte key: error = %v, want ErrKeyLength", length, err)
		}
		if err := open(io.Discard, bytes.NewReader(nil), make([]byte, length), nil); !errors.Is(err, ErrKeyLength) {
			t.Errorf("open with a %d-byte key: error = %v, want ErrKeyLength", length, err)
		}
	}
}

