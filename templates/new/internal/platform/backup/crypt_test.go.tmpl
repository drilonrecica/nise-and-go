func TestEveryFileGetsItsOwnNoncePrefix(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	// A repeated (key, nonce) pair under GCM is catastrophic, so the prefix
	// carries the burden of separating files sealed with one key.
	seen := make(map[string]struct{})
	const files = 64
	for range files {
		full := sealed(t, key, additional, []byte("a small database"))
		seen[string(full[:noncePrefixBytes])] = struct{}{}
	}
	if len(seen) != files {
		t.Errorf("%d distinct nonce prefixes across %d files; they must all differ", len(seen), files)
	}
}

