func testKey(t *testing.T) []byte {
	t.Helper()
	key, err := NewKey()
	if err != nil {
		t.Fatalf("NewKey: %v", err)
	}
	return key
}

func sealed(t *testing.T, key, additional, plaintext []byte) []byte {
	t.Helper()
	var out bytes.Buffer
	if err := seal(&out, bytes.NewReader(plaintext), key, additional); err != nil {
		t.Fatalf("seal: %v", err)
	}
	return out.Bytes()
}

func opened(t *testing.T, key, additional, ciphertext []byte) ([]byte, error) {
	t.Helper()
	var out bytes.Buffer
	err := open(&out, bytes.NewReader(ciphertext), key, additional)
	return out.Bytes(), err
}

// The sizes that exercise the chunk boundary. The exact multiples are the
// interesting ones: a construction that only marks a short final read as
// final leaves them looking exactly like a truncated file.
func boundarySizes() []int {
	return []int{
		0,
		1,
		chunkSize - 1,
		chunkSize,
		chunkSize + 1,
		2 * chunkSize,
		2*chunkSize + 17,
	}
}

func TestARoundTripReturnsTheSameBytes(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	for _, size := range boundarySizes() {
		plaintext := make([]byte, size)
		if _, err := rand.Read(plaintext); err != nil {
			t.Fatalf("generating %d bytes: %v", size, err)
		}

		restored, err := opened(t, key, additional, sealed(t, key, additional, plaintext))
		if err != nil {
			t.Fatalf("open of a %d-byte plaintext: %v", size, err)
		}
		if !bytes.Equal(restored, plaintext) {
			t.Errorf("a %d-byte plaintext did not survive the round trip", size)
		}
	}
}

func TestATruncatedBackupIsRefusedRatherThanPartlyRestored(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	// Three chunks, so there is a truncation point that lands on an exact
	// chunk boundary — the case a per-chunk AEAD without a final marker
	// would happily decrypt into a prefix of the database.
	plaintext := make([]byte, 3*chunkSize)
	if _, err := rand.Read(plaintext); err != nil {
		t.Fatalf("generating a plaintext: %v", err)
	}
	full := sealed(t, key, additional, plaintext)
	chunk := chunkSize + 16 // one sealed chunk: plaintext plus GCM's tag.

	cuts := map[string]int{
		"after one whole chunk":  noncePrefixBytes + chunk,
		"after two whole chunks": noncePrefixBytes + 2*chunk,
		"mid-chunk":              noncePrefixBytes + chunk + 500,
		"the prefix alone":       noncePrefixBytes,
	}
	for name, cut := range cuts {
		restored, err := opened(t, key, additional, full[:cut])
		if !errors.Is(err, ErrCorrupt) {
			t.Errorf("truncated %s: error = %v, want ErrCorrupt", name, err)
		}
		if bytes.Equal(restored, plaintext) {
			t.Errorf("truncated %s: the whole plaintext came back", name)
		}
	}
}

// The negative check for the test above: if truncation after a whole chunk
// were accepted, that acceptance would produce a proper prefix of the
// plaintext. This states what a broken construction would return, so the test
// above is known to be testing something.
func TestTruncationWouldOtherwiseYieldAUsablePrefix(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	plaintext := make([]byte, 2*chunkSize)
	if _, err := rand.Read(plaintext); err != nil {
		t.Fatalf("generating a plaintext: %v", err)
	}
	full := sealed(t, key, additional, plaintext)

	// Open the first chunk by hand with the non-final nonce, which is what a
	// construction without a final flag would do for every chunk.
	aead, err := newAEAD(key)
	if err != nil {
		t.Fatalf("newAEAD: %v", err)
	}
	var prefix [noncePrefixBytes]byte
	copy(prefix[:], full[:noncePrefixBytes])
	first, err := aead.Open(nil, nonce(prefix, 0, false), full[noncePrefixBytes:noncePrefixBytes+chunkSize+aead.Overhead()], additional)
	if err != nil {
		t.Fatalf("opening the first chunk: %v", err)
	}
	if !bytes.Equal(first, plaintext[:chunkSize]) {
		t.Fatal("the first chunk is not the first chunk of the plaintext, so this test proves nothing")
	}
}

func TestAReorderedBackupIsRefused(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	plaintext := make([]byte, 2*chunkSize)
	if _, err := rand.Read(plaintext); err != nil {
		t.Fatalf("generating a plaintext: %v", err)
	}
	full := sealed(t, key, additional, plaintext)
	chunk := chunkSize + 16

	swapped := make([]byte, len(full))
	copy(swapped, full[:noncePrefixBytes])
	copy(swapped[noncePrefixBytes:], full[noncePrefixBytes+chunk:noncePrefixBytes+2*chunk])
	copy(swapped[noncePrefixBytes+chunk:], full[noncePrefixBytes:noncePrefixBytes+chunk])
	copy(swapped[noncePrefixBytes+2*chunk:], full[noncePrefixBytes+2*chunk:])

	if _, err := opened(t, key, additional, swapped); !errors.Is(err, ErrCorrupt) {
		t.Errorf("error = %v, want ErrCorrupt for two swapped chunks", err)
	}
}

func TestADuplicatedChunkIsRefused(t *testing.T) {
	t.Parallel()
	key := testKey(t)
	additional := []byte(`{"format":1}`)

	plaintext := make([]byte, 2*chunkSize)
	full := sealed(t, key, additional, plaintext)
	chunk := chunkSize + 16

	duplicated := make([]byte, 0, len(full)+chunk)
	duplicated = append(duplicated, full[:noncePrefixBytes+chunk]...)
	duplicated = append(duplicated, full[noncePrefixBytes:noncePrefixBytes+chunk]...)
	duplicated = append(duplicated, full[noncePrefixBytes+chunk:]...)

	if _, err := opened(t, key, additional, duplicated); !errors.Is(err, ErrCorrupt) {
		t.Errorf("error = %v, want ErrCorrupt for a duplicated chunk", err)
	}
}

