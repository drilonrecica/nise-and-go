func TestLoadBuildsTheCursorKeyRing(t *testing.T) {
	setTestEnvironment(t)
	t.Setenv("CURSOR_RETIRED_KEYS", testCursorKey("y2025b")+","+testCursorKey("y2025a"))

	cfg, warnings, err := Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.CursorKeysAreEphemeral {
		t.Error("a configured signing key was reported as ephemeral")
	}
	if got := cfg.CursorKeys.ActiveID(); got != "y2026a" {
		t.Errorf("ActiveID = %q, want y2026a", got)
	}
	if got := cfg.CursorKeys.IDs(); len(got) != 3 || got[1] != "y2025b" || got[2] != "y2025a" {
		t.Errorf("IDs = %v, want the active key and both retired keys", got)
	}
	if cfg.CursorTTL != time.Hour {
		t.Errorf("CursorTTL = %s, want 1h", cfg.CursorTTL)
	}
	for _, warning := range warnings {
		if strings.Contains(warning, "CURSOR_SIGNING_KEY") {
			t.Errorf("configured key produced warning %q", warning)
		}
	}
}

