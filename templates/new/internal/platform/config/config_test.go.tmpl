func TestLoadBuildsTheLoginThrottle(t *testing.T) {
	setTestEnvironment(t)

	cfg, warnings, err := Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	if cfg.LoginThrottle.Address().Attempts() != 10 || cfg.LoginThrottle.Client().Attempts() != 60 {
		t.Fatalf("throttle = %#v", cfg.LoginThrottle)
	}
	if cfg.LoginThrottle.Address().Window() != 15*time.Minute {
		t.Errorf("window = %s", cfg.LoginThrottle.Address().Window())
	}
	for _, warning := range warnings {
		if strings.Contains(warning, "LOGIN_ATTEMPTS_PER_CLIENT") {
			t.Errorf("the default pair warned: %q", warning)
		}
	}

	// Several people behind one address are one client, so a client limit
	// below the address limit is almost always a mistake.
	t.Setenv("LOGIN_ATTEMPTS_PER_CLIENT", "2")
	_, warnings, err = Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}
	warned := false
	for _, warning := range warnings {
		if strings.Contains(warning, "LOGIN_ATTEMPTS_PER_CLIENT") {
			warned = true
		}
	}
	if !warned {
		t.Errorf("warnings = %v, want one naming LOGIN_ATTEMPTS_PER_CLIENT", warnings)
	}
}

