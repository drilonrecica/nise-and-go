// testCursorKey builds a well-formed key for a given identifier. The secret is
// deliberately a fixed pattern: it is a test fixture, not a credential, and a
// real deployment generates one with openssl.
func testCursorKey(id string) string {
	secret := make([]byte, 32)
	for i := range secret {
		secret[i] = byte(i) ^ id[len(id)-1]
	}
	return id + ":" + base64.StdEncoding.EncodeToString(secret)
}

func unsetTestEnvironment(t *testing.T, name string) {
	t.Helper()
	value, existed := os.LookupEnv(name)
	if err := os.Unsetenv(name); err != nil {
		t.Fatalf("unset %s: %v", name, err)
	}
	t.Cleanup(func() {
		if existed {
			if err := os.Setenv(name, value); err != nil {
				t.Errorf("restore %s: %v", name, err)
			}
			return
		}
		if err := os.Unsetenv(name); err != nil {
			t.Errorf("restore unset %s: %v", name, err)
		}
	})
}
