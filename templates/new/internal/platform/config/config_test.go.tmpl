func TestLoadAppliesConservativeDatabasePoolDefaults(t *testing.T) {
	setTestEnvironment(t)

	cfg, _, err := Load()
	if err != nil {
		t.Fatalf("Load: %v", err)
	}

	if got, want := cfg.Database.MaxConns, int32(10); got != want {
		t.Errorf("Database.MaxConns = %d, want %d", got, want)
	}
	if got, want := cfg.Database.MinConns, int32(0); got != want {
		t.Errorf("Database.MinConns = %d, want %d", got, want)
	}
	if got, want := cfg.Database.MaxConnLifetime, 30*time.Minute; got != want {
		t.Errorf("Database.MaxConnLifetime = %s, want %s", got, want)
	}
	if got, want := cfg.Database.MaxConnIdleTime, 5*time.Minute; got != want {
		t.Errorf("Database.MaxConnIdleTime = %s, want %s", got, want)
	}
	if got, want := cfg.Database.HealthCheckPeriod, 30*time.Second; got != want {
		t.Errorf("Database.HealthCheckPeriod = %s, want %s", got, want)
	}
	if got, want := cfg.Database.ConnectTimeout, 5*time.Second; got != want {
		t.Errorf("Database.ConnectTimeout = %s, want %s", got, want)
	}
}

func TestLoadRejectsInvalidDatabasePoolRelationships(t *testing.T) {
	setTestEnvironment(t)
	t.Setenv("DB_MAX_CONNS", "2")
	t.Setenv("DB_MIN_CONNS", "3")
	t.Setenv("DB_MAX_CONN_IDLE_TIME", "31m")
	t.Setenv("DB_MAX_CONN_LIFETIME", "30m")

	_, _, err := Load()
	if err == nil {
		t.Fatal("Load succeeded with DB_MIN_CONNS above DB_MAX_CONNS and idle time above lifetime")
	}
	for _, name := range []string{"DB_MIN_CONNS", "DB_MAX_CONNS", "DB_MAX_CONN_IDLE_TIME", "DB_MAX_CONN_LIFETIME"} {
		if !strings.Contains(err.Error(), name) {
			t.Errorf("error %q does not name %s", err, name)
		}
	}
}

