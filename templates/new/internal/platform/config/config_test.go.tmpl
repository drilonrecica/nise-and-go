func TestLoadRejectsUnusableCursorConfiguration(t *testing.T) {
	tests := []struct {
		name  string
		env   map[string]string
		wants string
	}{
		{
			name:  "signing key is not id:base64",
			env:   map[string]string{"CURSOR_SIGNING_KEY": "no-separator"},
			wants: "CURSOR_SIGNING_KEY",
		},
		{
			name:  "signing key secret is too short",
			env:   map[string]string{"CURSOR_SIGNING_KEY": "y2026a:" + base64.StdEncoding.EncodeToString([]byte("short"))},
			wants: "CURSOR_SIGNING_KEY",
		},
		{
			name:  "retired key repeats the active identifier",
			env:   map[string]string{"CURSOR_RETIRED_KEYS": testCursorKey("y2026a")},
			wants: "CURSOR_SIGNING_KEY",
		},
		{
			name:  "retired entry is empty",
			env:   map[string]string{"CURSOR_RETIRED_KEYS": testCursorKey("y2025a") + ",,"},
			wants: "CURSOR_RETIRED_KEYS",
		},
		{
			name:  "retired keys without a signing key",
			env:   map[string]string{"CURSOR_SIGNING_KEY": "", "CURSOR_RETIRED_KEYS": testCursorKey("y2025a")},
			wants: "CURSOR_RETIRED_KEYS",
		},
		{
			name:  "lifetime is zero",
			env:   map[string]string{"CURSOR_TTL": "0s"},
			wants: "CURSOR_TTL",
		},
		{
			name:  "lifetime is beyond the ceiling",
			env:   map[string]string{"CURSOR_TTL": "25h"},
			wants: "CURSOR_TTL",
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			setTestEnvironment(t)
			for name, value := range tc.env {
				t.Setenv(name, value)
			}
			_, _, err := Load()
			if err == nil {
				t.Fatalf("Load accepted %v", tc.env)
			}
			if !strings.Contains(err.Error(), tc.wants) {
				t.Errorf("error %q does not name %s", err, tc.wants)
			}
		})
	}
}

