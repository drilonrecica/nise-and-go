// Generated once by nise; owned by this application. Nise will not overwrite it.

// Package config loads this application's typed configuration from the
// process environment.
//
// Every setting is read once, at startup, through runtime/config's explicit
// combinators. There is no reflection, no struct-tag decoder, and no .env
// file: the source of every value is visible at its call site in Load.
package config

import (
	"errors"
	"fmt"
	"log/slog"
	"net"
	"strings"
	"time"

	rtconfig "github.com/drilonrecica/nise-and-go/runtime/config"
	"github.com/drilonrecica/nise-and-go/runtime/forwarded"
	"github.com/drilonrecica/nise-and-go/runtime/lifecycle"
	"github.com/drilonrecica/nise-and-go/runtime/pagination"
	"github.com/drilonrecica/nise-and-go/runtime/secure"
	"github.com/drilonrecica/nise-and-go/runtime/session"

	"{{.ModulePath}}/internal/platform/database"
)

// Config is this application's fully resolved configuration.
type Config struct {
	// Env is the deployment environment. Production enables the
	// fail-closed checks in Load.
	Env rtconfig.Environment
	// Mode is the default process mode when the binary is started without
	// an explicit -mode flag.
	Mode lifecycle.Mode
	// BindAddr is the interface the HTTP server listens on.
	BindAddr string
	// Port is the TCP port the HTTP server listens on.
	Port string
	// Debug enables developer-facing behavior. It must be false in
	// production.
	Debug bool
	// LogLevel is the minimum slog level that is emitted.
	LogLevel slog.Level
	// LogFormat is "json" or "text".
	LogFormat string
	// TrustProxyHeaders allows inbound X-Request-Id and X-Correlation-Id
	// headers to be adopted instead of freshly generated. Enable it only
	// behind an ingress that sanitizes those headers, and only together with
	// TrustedProxies: trusting a proxy's identifiers while declaring that
	// there is no proxy is refused.
	TrustProxyHeaders bool
	// TrustedProxies decides what a request's real client address, scheme,
	// and host are. Its zero value reads no forwarded header at all, which
	// is correct for a service exposed directly.
	TrustedProxies forwarded.Policy
	// AllowPublicBind is the explicit opt-in that lets production bind a
	// public address.
	AllowPublicBind bool
	// OperatorToken gates the operator-only endpoints. When it is unset,
	// those endpoints are not mounted at all.
	OperatorToken rtconfig.Secret
	// DatabaseURL is the PostgreSQL connection string. Its Secret wrapper
	// prevents accidental formatting or structured logging.
	DatabaseURL rtconfig.Secret
	// DatabasePassword optionally supplies the password separately from
	// DatabaseURL, avoiding URL quoting hazards in deployment configuration.
	DatabasePassword rtconfig.Secret
	// Database holds the validated connection-pool limits.
	Database database.Settings
	// DatabaseSlowQueryThreshold controls when a sanitized query observation
	// is logged at warning level.
	DatabaseSlowQueryThreshold time.Duration
	// CursorKeys signs and verifies opaque pagination cursors. Its active
	// key signs; its retired keys verify cursors issued before the last
	// rotation.
	CursorKeys *pagination.KeyRing
	// CursorKeysAreEphemeral reports that no cursor key was configured and a
	// random one was generated for this process. Outstanding cursors stop
	// verifying when the process restarts, which production refuses.
	CursorKeysAreEphemeral bool
	// CursorTTL is how long an issued cursor stays valid.
	CursorTTL time.Duration
	// SessionLifetime is the idle window, absolute deadline, and activity
	// write interval applied to browser sessions.
	SessionLifetime session.Lifetime
	// SessionCookie is the name and attributes of the session cookie.
	SessionCookie session.CookiePolicy
	// AllowedOrigins are the origins permitted to make state-changing
	// requests. Its zero value means this application's own origin, derived
	// per request, which is the right policy for a single-origin
	// application.
	AllowedOrigins []string
	// SessionCookieInsecure reports that the session cookie has given up the
	// __Host- prefix and the Secure attribute. It exists for a development
	// origin that is not localhost; production refuses it.
	SessionCookieInsecure bool
}

// Addr is the host:port the HTTP server listens on.
func (c Config) Addr() string {
	return net.JoinHostPort(c.BindAddr, c.Port)
}

// Deployment maps Env onto the two-value deployment axis runtime/secure
// uses. Only Production gets Strict-Transport-Security; Test is treated as
// Development so a test run never pins HSTS in a browser.
func (c Config) Deployment() secure.Deployment {
	if c.Env == rtconfig.Production {
		return secure.Production
	}
	return secure.Development
}

// Load reads the configuration from the process environment. The returned
// warnings are non-fatal problems an operator should fix (for example an
// over-permissive secret file); they never contain a secret value.
//
// Load fails rather than guessing: an unparseable value, a missing required
// value, or a production configuration that breaks one of the checks below
// stops the process before it serves a single request.
func Load() (Config, []string, error) {
	l := rtconfig.NewLoader()

	env := l.Environment("APP_ENV", rtconfig.Default("development"))
	rawMode := l.String("APP_MODE", rtconfig.Default("all"))
	rawLevel := l.String("LOG_LEVEL", rtconfig.Default("info"))
	maxConns := l.Int("DB_MAX_CONNS", rtconfig.Default("10"))
	minConns := l.Int("DB_MIN_CONNS", rtconfig.Default("0"))
	maxConnLifetime := l.Duration("DB_MAX_CONN_LIFETIME", rtconfig.Default("30m"))
	maxConnIdleTime := l.Duration("DB_MAX_CONN_IDLE_TIME", rtconfig.Default("5m"))
	healthCheckPeriod := l.Duration("DB_HEALTH_CHECK_PERIOD", rtconfig.Default("30s"))
	connectTimeout := l.Duration("DB_CONNECT_TIMEOUT", rtconfig.Default("5s"))
	slowQueryThreshold := l.Duration("DB_SLOW_QUERY_THRESHOLD", rtconfig.Default("250ms"))
	cursorTTL := l.Duration("CURSOR_TTL", rtconfig.Default("1h"))
	sessionIdle := l.Duration("SESSION_IDLE_TIMEOUT", rtconfig.Default("12h"))
	sessionAbsolute := l.Duration("SESSION_ABSOLUTE_TIMEOUT", rtconfig.Default("720h"))
	sessionTouch := l.Duration("SESSION_TOUCH_INTERVAL", rtconfig.Default("5m"))
	sessionCookieName := l.String("SESSION_COOKIE_NAME", rtconfig.Default(""))
	trustedProxyCount := l.Int("TRUSTED_PROXY_COUNT", rtconfig.Default("0"))
	trustedProxyNetworks := l.String("TRUSTED_PROXY_NETWORKS", rtconfig.Default(""))
	allowedOrigins := l.String("ALLOWED_ORIGINS", rtconfig.Default(""))
	// The two cursor key variables are read into locals rather than kept as
	// Config fields: once the ring is built, holding the raw material would
	// only add a second place for it to escape from.
	cursorSigningKey := l.Secret("CURSOR_SIGNING_KEY", rtconfig.Default(""))
	cursorRetiredKeys := l.Secret("CURSOR_RETIRED_KEYS", rtconfig.Default(""))

	cfg := Config{
		Env:                        env,
		BindAddr:                   l.String("BIND_ADDR", rtconfig.Default("127.0.0.1")),
		Port:                       l.String("PORT", rtconfig.Default("8080")),
		Debug:                      l.Bool("DEBUG", rtconfig.Default("false")),
		LogFormat:                  l.String("LOG_FORMAT", rtconfig.Default("json")),
		TrustProxyHeaders:          l.Bool("TRUST_PROXY_HEADERS", rtconfig.Default("false")),
		AllowPublicBind:            l.Bool("ALLOW_PUBLIC_BIND", rtconfig.Default("false")),
		OperatorToken:              l.Secret("OPERATOR_TOKEN", rtconfig.Default("")),
		DatabaseURL:                l.Secret("DATABASE_URL"),
		DatabasePassword:           l.Secret("DATABASE_PASSWORD", rtconfig.Default("")),
		DatabaseSlowQueryThreshold: time.Duration(slowQueryThreshold),
		CursorTTL:                  time.Duration(cursorTTL),
		SessionCookieInsecure:      l.Bool("SESSION_COOKIE_INSECURE", rtconfig.Default("false")),
	}
	if err := l.Err(); err != nil {
		return Config{}, nil, err
	}
	warnings := l.Warnings()

	mode, err := lifecycle.ParseMode(rawMode)
	if err != nil {
		return Config{}, warnings, fmt.Errorf("APP_MODE: %w", err)
	}
	cfg.Mode = mode

	level, err := parseLevel(rawLevel)
	if err != nil {
		return Config{}, warnings, err
	}
	cfg.LogLevel = level

	databaseSettings, err := database.NewSettings(
		maxConns,
		minConns,
		time.Duration(maxConnLifetime),
		time.Duration(maxConnIdleTime),
		time.Duration(healthCheckPeriod),
		time.Duration(connectTimeout),
	)
	if err != nil {
		return Config{}, warnings, err
	}
	cfg.Database = databaseSettings
	if cfg.DatabaseSlowQueryThreshold <= 0 {
		return Config{}, warnings, errors.New("DB_SLOW_QUERY_THRESHOLD: must be greater than zero")
	}

	keys, ephemeral, err := resolveCursorKeys(cursorSigningKey, cursorRetiredKeys)
	if err != nil {
		return Config{}, warnings, err
	}
	cfg.CursorKeys = keys
	cfg.CursorKeysAreEphemeral = ephemeral
	if ephemeral {
		warnings = append(warnings, "CURSOR_SIGNING_KEY is unset: pagination cursors are signed with a key generated for this process and stop verifying when it restarts")
	}
	if cfg.CursorTTL <= 0 || cfg.CursorTTL > maxCursorTTL {
		return Config{}, warnings, fmt.Errorf("CURSOR_TTL: must be greater than zero and at most %s, found %s", maxCursorTTL, cfg.CursorTTL)
	}

	proxyNetworks, err := forwarded.ParseNetworks(trustedProxyNetworks)
	if err != nil {
		return Config{}, warnings, fmt.Errorf("TRUSTED_PROXY_NETWORKS: %w", err)
	}
	trustedProxies, err := forwarded.NewPolicy(trustedProxyCount, proxyNetworks)
	if err != nil {
		return Config{}, warnings, fmt.Errorf("TRUSTED_PROXY_COUNT/TRUSTED_PROXY_NETWORKS: %w", err)
	}
	cfg.TrustedProxies = trustedProxies
	if cfg.TrustProxyHeaders && !trustedProxies.TrustsForwardedHeaders() {
		return Config{}, warnings, errors.New("TRUST_PROXY_HEADERS: set while TRUSTED_PROXY_COUNT is 0; declare the proxy chain or stop trusting its identifiers")
	}
	if trustedProxies.TrustsForwardedHeaders() && len(proxyNetworks) == 0 {
		warnings = append(warnings, "TRUSTED_PROXY_NETWORKS is unset: forwarded headers are honored from any peer, so this is only safe when the application's port cannot be reached except through the proxy")
	}

	cfg.AllowedOrigins = splitList(allowedOrigins)

	sessionLifetime, err := session.NewLifetime(
		time.Duration(sessionIdle),
		time.Duration(sessionAbsolute),
		time.Duration(sessionTouch),
	)
	if err != nil {
		return Config{}, warnings, fmt.Errorf("SESSION_IDLE_TIMEOUT/SESSION_ABSOLUTE_TIMEOUT/SESSION_TOUCH_INTERVAL: %w", err)
	}
	cfg.SessionLifetime = sessionLifetime

	cookieOptions := make([]session.CookieOption, 0, 1)
	if sessionCookieName != "" {
		cookieOptions = append(cookieOptions, session.WithCookieName(sessionCookieName))
	}
	sessionCookie, err := session.NewCookiePolicy(!cfg.SessionCookieInsecure, cookieOptions...)
	if err != nil {
		return Config{}, warnings, fmt.Errorf("SESSION_COOKIE_NAME/SESSION_COOKIE_INSECURE: %w", err)
	}
	cfg.SessionCookie = sessionCookie
	if cfg.SessionCookieInsecure {
		warnings = append(warnings, "SESSION_COOKIE_INSECURE is set: the session cookie has given up the __Host- prefix and the Secure attribute, which is only safe on a development origin")
	}

	if cfg.LogFormat != "json" && cfg.LogFormat != "text" {
		return Config{}, warnings, fmt.Errorf(`LOG_FORMAT: must be "json" or "text", found %q`, cfg.LogFormat)
	}

	if err := rtconfig.Validate(cfg.Env, func(v *rtconfig.Validator) {
		v.RequireSecretSet("DATABASE_URL", cfg.DatabaseURL)
		v.Check(!cfg.Debug, "DEBUG",
			"debug mode is enabled in production",
			"set DEBUG=false")
		v.Check(cfg.LogFormat == "json", "LOG_FORMAT",
			"production logs must be machine-readable",
			"set LOG_FORMAT=json")
		v.Check(!isWildcardAddr(cfg.BindAddr) || cfg.AllowPublicBind, "BIND_ADDR",
			"bound to every interface without an explicit opt-in",
			"set BIND_ADDR to a private address, or set ALLOW_PUBLIC_BIND=true if a public bind is intended")
		v.Check(cfg.SessionCookie.Hardened(), "SESSION_COOKIE_INSECURE",
			"the session cookie would be sent without the __Host- prefix and without Secure",
			"unset SESSION_COOKIE_INSECURE; http://localhost is a secure context, so development needs no exception")
		v.Check(!cfg.CursorKeysAreEphemeral, "CURSOR_SIGNING_KEY",
			"pagination cursors would be signed with a key generated for this process, so every restart and every replica rejects outstanding cursors",
			"set CURSOR_SIGNING_KEY to <id>:<base64 secret>; generate one with: openssl rand -base64 32")
	}); err != nil {
		return Config{}, warnings, err
	}

	return cfg, warnings, nil
}

// maxCursorTTL bounds how long an issued cursor stays valid. A cursor pins a
// position in a result set that is still changing underneath it; a lifetime
// measured in days would let a client resume a listing whose ordering no
// longer resembles the one the cursor was cut from.
const maxCursorTTL = 24 * time.Hour

// resolveCursorKeys builds the cursor key ring from configuration.
//
// An unset CURSOR_SIGNING_KEY generates an ephemeral key rather than falling
// back to a fixed one: a checked-in default key would be a signing key
// everyone who has ever read this repository holds. Production refuses the
// ephemeral path in Load's validation below, so this convenience exists only
// for a development machine.
func resolveCursorKeys(signing, retired rtconfig.Secret) (*pagination.KeyRing, bool, error) {
	if !signing.IsSet() {
		if retired.IsSet() {
			return nil, false, errors.New("CURSOR_RETIRED_KEYS: set without CURSOR_SIGNING_KEY; a retired key verifies cursors but cannot sign them")
		}
		key, err := pagination.GenerateKey("ephemeral")
		if err != nil {
			return nil, false, fmt.Errorf("CURSOR_SIGNING_KEY: generating an ephemeral development key: %w", err)
		}
		ring, err := pagination.NewKeyRing(key)
		if err != nil {
			return nil, false, fmt.Errorf("CURSOR_SIGNING_KEY: %w", err)
		}
		return ring, true, nil
	}

	active, err := pagination.ParseKey(signing.Reveal())
	if err != nil {
		return nil, false, fmt.Errorf("CURSOR_SIGNING_KEY: %w", err)
	}
	previous, err := parseRetiredCursorKeys(retired)
	if err != nil {
		return nil, false, err
	}
	ring, err := pagination.NewKeyRing(active, previous...)
	if err != nil {
		return nil, false, fmt.Errorf("CURSOR_SIGNING_KEY: %w", err)
	}
	return ring, false, nil
}

// parseRetiredCursorKeys reads the comma-separated verification-only keys.
func parseRetiredCursorKeys(retired rtconfig.Secret) ([]pagination.Key, error) {
	if !retired.IsSet() {
		return nil, nil
	}
	entries := strings.Split(retired.Reveal(), ",")
	keys := make([]pagination.Key, 0, len(entries))
	for i, entry := range entries {
		entry = strings.TrimSpace(entry)
		if entry == "" {
			return nil, fmt.Errorf("CURSOR_RETIRED_KEYS: entry %d is empty", i+1)
		}
		key, err := pagination.ParseKey(entry)
		if err != nil {
			return nil, fmt.Errorf("CURSOR_RETIRED_KEYS: entry %d: %w", i+1, err)
		}
		keys = append(keys, key)
	}
	return keys, nil
}

// parseLevel converts a LOG_LEVEL value into a slog.Level. It refuses an
// unrecognized value rather than falling back to Info: a typo that silently
// downgraded logging would hide exactly the events an operator set the
// variable to see.
func parseLevel(raw string) (slog.Level, error) {
	switch strings.ToLower(raw) {
	case "debug":
		return slog.LevelDebug, nil
	case "info":
		return slog.LevelInfo, nil
	case "warn", "warning":
		return slog.LevelWarn, nil
	case "error":
		return slog.LevelError, nil
	default:
		return 0, fmt.Errorf(`LOG_LEVEL: must be one of debug, info, warn, error; found %q`, raw)
	}
}

// splitList reads a comma-separated setting into trimmed entries, dropping
// nothing: an empty entry reaches the validator that knows what it means.
func splitList(value string) []string {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return nil
	}
	entries := strings.Split(trimmed, ",")
	for i := range entries {
		entries[i] = strings.TrimSpace(entries[i])
	}
	return entries
}

// isWildcardAddr reports whether addr binds every interface.
func isWildcardAddr(addr string) bool {
	return addr == "" || addr == "0.0.0.0" || addr == "::" || addr == "[::]"
}
