func TestValidateRefusesHeaderInjection(t *testing.T) {
	t.Parallel()

	// Every one of these is a value that has, in real systems, arrived from
	// a form: a display name, a subject built from user text, an address
	// typed into a field. A newline in any of them ends the header it lands
	// in and begins another.
	cases := []struct {
		name    string
		message Message
	}{
		{"newline in the subject", Message{
			From: "a@example.com", To: []string{"b@example.com"},
			Subject: "Hello\nBcc: attacker@example.com", Text: "body",
		}},
		{"carriage return in the subject", Message{
			From: "a@example.com", To: []string{"b@example.com"},
			Subject: "Hello\rBcc: attacker@example.com", Text: "body",
		}},
		{"NUL in the subject", Message{
			From: "a@example.com", To: []string{"b@example.com"},
			Subject: "Hello\x00truncated", Text: "body",
		}},
		{"newline in a recipient", Message{
			From: "a@example.com", To: []string{"b@example.com\nBcc: attacker@example.com"},
			Subject: "Hello", Text: "body",
		}},
		{"newline in the sender", Message{
			From: "a@example.com\nBcc: attacker@example.com", To: []string{"b@example.com"},
			Subject: "Hello", Text: "body",
		}},
		{"newline in reply-to", Message{
			From: "a@example.com", To: []string{"b@example.com"}, ReplyTo: "c@example.com\nBcc: x@example.com",
			Subject: "Hello", Text: "body",
		}},
	}
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			t.Parallel()
			err := c.message.Validate()
			if !errors.Is(err, ErrHeaderInjection) && !errors.Is(err, ErrAddress) {
				t.Fatalf("Validate = %v, want a refusal", err)
			}
		})
	}
}

// TestValidateRefusesASmuggledSecondRecipient covers the injection that does
// not need a newline: a single address field holding a list.
func TestValidateRefusesASmuggledSecondRecipient(t *testing.T) {
	t.Parallel()

	m := Message{
		From:    "a@example.com, attacker@example.com",
		To:      []string{"b@example.com"},
		Subject: "Hello",
		Text:    "body",
	}
	if err := m.Validate(); !errors.Is(err, ErrAddress) {
		t.Fatalf("Validate = %v, want ErrAddress", err)
	}
}

func TestValidateRefusesTheObviouslyUnsendable(t *testing.T) {
	t.Parallel()

	base := Message{From: "a@example.com", To: []string{"b@example.com"}, Subject: "s", Text: "t"}

	noRecipients := base
	noRecipients.To = nil
	if err := noRecipients.Validate(); !errors.Is(err, ErrNoRecipients) {
		t.Errorf("no recipients = %v, want ErrNoRecipients", err)
	}

	tooMany := base
	tooMany.To = make([]string, MaxRecipients+1)
	for i := range tooMany.To {
		tooMany.To[i] = "b@example.com"
	}
	if err := tooMany.Validate(); !errors.Is(err, ErrTooManyRecipients) {
		t.Errorf("too many recipients = %v, want ErrTooManyRecipients", err)
	}

	empty := base
	empty.Text, empty.HTML = "", ""
	if err := empty.Validate(); !errors.Is(err, ErrEmptyBody) {
		t.Errorf("empty body = %v, want ErrEmptyBody", err)
	}

	long := base
	long.Subject = strings.Repeat("s", MaxSubjectBytes+1)
	if err := long.Validate(); !errors.Is(err, ErrSubjectTooLong) {
		t.Errorf("long subject = %v, want ErrSubjectTooLong", err)
	}
}

