}

// TestLogTransportNeverLogsTheBody is a privacy check, not a formatting one.
// A rendered message routinely carries a single-use token, a name, or an
// address, and a development log is the least protected place any of those
// could end up.
func TestLogTransportNeverLogsTheBody(t *testing.T) {
	t.Parallel()

	var buf bytes.Buffer
	logger := slog.New(slog.NewTextHandler(&buf, nil))
	transport, err := NewLog(logger, "noreply@example.com")
	if err != nil {
		t.Fatalf("NewLog: %v", err)
	}

	const secret = "inv1_a-single-use-token"
	err = transport.Send(context.Background(), Message{
		To:      []string{"b@example.com"},
		Subject: "Your invitation",
		Text:    "Open " + secret + " to continue",
		HTML:    "<a href=\"" + secret + "\">Open</a>",
	})
	if err != nil {
		t.Fatalf("Send: %v", err)
	}
	if strings.Contains(buf.String(), secret) {
		t.Fatalf("the log transport wrote the body, which held a token:\n%s", buf.String())
	}
	if !strings.Contains(buf.String(), "Your invitation") {
		t.Error("the log line does not identify the message at all")
	}
}

// TestLogTransportStillValidates keeps the development path honest: a
// message that could not be sent in production must not appear to succeed in
// development, or the mistake is found after deploy.
func TestLogTransportStillValidates(t *testing.T) {
	t.Parallel()

	transport, err := NewLog(slog.New(slog.NewTextHandler(&bytes.Buffer{}, nil)), "noreply@example.com")
	if err != nil {
		t.Fatalf("NewLog: %v", err)
	}
	err = transport.Send(context.Background(), Message{
		To:      []string{"b@example.com"},
		Subject: "Hello\nBcc: attacker@example.com",
		Text:    "body",
	})
	if !errors.Is(err, ErrHeaderInjection) {
		t.Fatalf("Send = %v, want the same refusal production would give", err)
	}
}

func TestMailerFuncSatisfiesMailer(t *testing.T) {
	t.Parallel()

	var sent Message
	var m Mailer = MailerFunc(func(_ context.Context, msg Message) error {
		sent = msg
		return nil
	})
	if err := m.Send(context.Background(), Message{Subject: "recorded"}); err != nil {
		t.Fatalf("Send: %v", err)
	}
	if sent.Subject != "recorded" {
		t.Error("MailerFunc did not receive the message")
	}
}
