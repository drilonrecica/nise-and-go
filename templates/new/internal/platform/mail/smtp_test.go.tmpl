// fakeServer is a minimal SMTP server on a loopback listener. It exists so
// the transport is tested against a real conversation — a rendered message
// read off a socket — rather than against an interface this package also
// wrote. Every assertion below about headers, MIME structure, and dot
// stuffing is made on bytes that crossed a connection.
type fakeServer struct {
	listener net.Listener
	mu       sync.Mutex
	// data holds each accepted message body.
	data []string
	// envelope holds the MAIL FROM and RCPT TO arguments, in order.
	envelope []string
	// offerStartTLS controls the EHLO capability list.
	offerStartTLS bool
	// offerAuth likewise.
	offerAuth bool
}

func newFakeServer(t *testing.T) *fakeServer {
	t.Helper()

	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatalf("listening: %v", err)
	}
	s := &fakeServer{listener: listener}
	t.Cleanup(func() { _ = listener.Close() })

	go func() {
		for {
			conn, err := listener.Accept()
			if err != nil {
				return
			}
			go s.handle(conn)
		}
	}()
	return s
}

func (s *fakeServer) addr(t *testing.T) (string, string) {
	t.Helper()
	host, port, err := net.SplitHostPort(s.listener.Addr().String())
	if err != nil {
		t.Fatalf("splitting the listener address: %v", err)
	}
	return host, port
}

func (s *fakeServer) messages() []string {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make([]string, len(s.data))
	copy(out, s.data)
	return out
}

func (s *fakeServer) envelopeLines() []string {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make([]string, len(s.envelope))
	copy(out, s.envelope)
	return out
}

func (s *fakeServer) handle(conn net.Conn) {
	defer func() { _ = conn.Close() }()
	_ = conn.SetDeadline(time.Now().Add(20 * time.Second))

	reader := bufio.NewReader(conn)
	write := func(line string) { _, _ = conn.Write([]byte(line + "\r\n")) }

	write("220 fake ESMTP")
	for {
		line, err := reader.ReadString('\n')
		if err != nil {
			return
		}
		command := strings.ToUpper(strings.TrimSpace(line))
		switch {
		case strings.HasPrefix(command, "EHLO"):
			write("250-fake")
			if s.offerStartTLS {
				write("250-STARTTLS")
			}
			if s.offerAuth {
				write("250-AUTH PLAIN")
			}
			write("250 SIZE 10240000")
		case strings.HasPrefix(command, "HELO"):
			write("250 fake")
		case strings.HasPrefix(command, "MAIL FROM") || strings.HasPrefix(command, "RCPT TO"):
			s.mu.Lock()
			s.envelope = append(s.envelope, strings.TrimSpace(line))
			s.mu.Unlock()
			write("250 OK")
		case command == "DATA":
			write("354 send it")
			var body strings.Builder
			for {
				dataLine, err := reader.ReadString('\n')
				if err != nil {
					return
				}
				if dataLine == ".\r\n" {
					break
				}
				body.WriteString(dataLine)
			}
			s.mu.Lock()
			s.data = append(s.data, body.String())
			s.mu.Unlock()
			write("250 queued")
		case command == "QUIT":
			write("221 bye")
			return
		default:
			write("250 OK")
		}
	}
}

// plainSettings builds settings pointing at the fake server with no
// encryption, which is the only mode a plaintext fake can serve.
func plainSettings(t *testing.T, s *fakeServer) Settings {
	t.Helper()
	host, port := s.addr(t)
	settings, err := NewSettings(host, port, "", "", string(EncryptionNone), "noreply@example.com")
	if err != nil {
		t.Fatalf("NewSettings: %v", err)
	}
	return settings
}

func TestSendWritesAWellFormedMessage(t *testing.T) {
	t.Parallel()

	server := newFakeServer(t)
	transport, err := NewSMTP(plainSettings(t, server))
	if err != nil {
		t.Fatalf("NewSMTP: %v", err)
	}

	err = transport.Send(context.Background(), Message{
		To:      []string{"Ada Lovelace <ada@example.com>"},
		ReplyTo: "support@example.com",
		Subject: "Your invitation",
		Text:    "Plain body",
		HTML:    "<p>HTML body</p>",
	})
	if err != nil {
		t.Fatalf("Send: %v", err)
	}

	messages := server.messages()
	if len(messages) != 1 {
		t.Fatalf("the server accepted %d messages, want 1", len(messages))
	}
	body := messages[0]

	for _, want := range []string{
		"From: noreply@example.com\r\n",
		"To: Ada Lovelace <ada@example.com>\r\n",
		"Reply-To: support@example.com\r\n",
		"Subject: Your invitation\r\n",
		"MIME-Version: 1.0\r\n",
		"multipart/alternative; boundary=",
		`Content-Type: text/plain; charset="utf-8"`,
		`Content-Type: text/html; charset="utf-8"`,
		"Plain body",
		"<p>HTML body</p>",
	} {
		if !strings.Contains(body, want) {
			t.Errorf("the delivered message lacks %q:\n%s", want, body)
		}
	}

	// The plain-text part must come first. A client renders the last
	// alternative it understands, so text after HTML would show the text to
	// everyone.
	if strings.Index(body, "text/plain") > strings.Index(body, "text/html") {
		t.Error("the HTML alternative precedes the plain-text one, so no client will render the HTML")
	}

	// The envelope carries bare addresses; a display name there is a syntax
	// error, not a nicety.
	for _, line := range server.envelopeLines() {
		if strings.Contains(line, "Ada Lovelace") {
			t.Errorf("the envelope carries a display name: %q", line)
		}
	}
}

// TestASubjectSurvivesNonASCII covers the difference between a subject that
// arrives readable and one that arrives as mojibake.
func TestASubjectSurvivesNonASCII(t *testing.T) {
	t.Parallel()

	server := newFakeServer(t)
	transport, err := NewSMTP(plainSettings(t, server))
	if err != nil {
		t.Fatalf("NewSMTP: %v", err)
	}
	if err := transport.Send(context.Background(), Message{
		To:      []string{"b@example.com"},
		Subject: "Ftesë për llogari",
		Text:    "body",
	}); err != nil {
		t.Fatalf("Send: %v", err)
	}

	body := server.messages()[0]
	if !strings.Contains(body, "=?utf-8?") {
		t.Errorf("a non-ASCII subject was not encoded:\n%s", body)
	}
	if strings.Contains(body, "Subject: Ftesë") {
		t.Error("a non-ASCII subject was sent raw, which arrives as mojibake in most clients")
	}
}

// TestALineWithOnlyADotIsEscaped covers the sequence that ends SMTP DATA.
// Without dot stuffing, a body containing that line truncates the message
// there and leaves the rest to be read as SMTP commands.
func TestALineWithOnlyADotIsEscaped(t *testing.T) {
	t.Parallel()

	server := newFakeServer(t)
	transport, err := NewSMTP(plainSettings(t, server))
	if err != nil {
		t.Fatalf("NewSMTP: %v", err)
	}
	if err := transport.Send(context.Background(), Message{
		To:      []string{"b@example.com"},
		Subject: "Hello",
		Text:    "before\n.\nafter",
	}); err != nil {
		t.Fatalf("Send: %v", err)
	}

	messages := server.messages()
	if len(messages) != 1 {
		t.Fatalf("the server accepted %d messages, want 1", len(messages))
	}
	body := messages[0]
	if !strings.Contains(body, "after") {
		t.Fatalf("the message was truncated at a lone dot:\n%s", body)
	}
	// Stuffed exactly once. net/smtp's DotWriter does this; a second layer
	// added here would produce "..." on the wire, and every message whose
	// body starts a line with a dot would arrive with an extra one. This
	// file caught precisely that.
	if !strings.Contains(body, "\r\n..\r\n") {
		t.Errorf("the lone dot was not stuffed, so the message ends there:\n%q", body)
	}
	if strings.Contains(body, "\r\n...\r\n") {
		t.Errorf("the lone dot was stuffed twice, so it arrives as two dots:\n%q", body)
	}
}

// TestSendRefusesBeforeConnecting proves an unsendable message costs no round
// trip and leaves no rejected attempt in the server's logs.
func TestSendRefusesBeforeConnecting(t *testing.T) {
	t.Parallel()

	server := newFakeServer(t)
	transport, err := NewSMTP(plainSettings(t, server))
	if err != nil {
		t.Fatalf("NewSMTP: %v", err)
	}
	err = transport.Send(context.Background(), Message{
		To:      []string{"b@example.com"},
		Subject: "Hello\nBcc: attacker@example.com",
		Text:    "body",
	})
	if !errors.Is(err, ErrHeaderInjection) {
		t.Fatalf("Send = %v, want ErrHeaderInjection", err)
	}
	if got := server.messages(); len(got) != 0 {
		t.Errorf("a refused message still reached the server: %v", got)
	}
	if got := server.envelopeLines(); len(got) != 0 {
		t.Errorf("a refused message still opened an envelope: %v", got)
	}
}

// TestStartTLSIsRequiredNotPreferred is the downgrade check. A server that
// does not offer STARTTLS must be an error, because a fallback to plaintext
// makes an active attacker's job a matter of stripping one capability line.
func TestStartTLSIsRequiredNotPreferred(t *testing.T) {
	t.Parallel()

	server := newFakeServer(t)
	server.offerStartTLS = false
	host, port := server.addr(t)
	settings, err := NewSettings(host, port, "", "", string(EncryptionStartTLS), "noreply@example.com")
	if err != nil {
		t.Fatalf("NewSettings: %v", err)
	}
	transport, err := NewSMTP(settings)
	if err != nil {
		t.Fatalf("NewSMTP: %v", err)
	}

	err = transport.Send(context.Background(), Message{
		To: []string{"b@example.com"}, Subject: "Hello", Text: "body",
	})
	if err == nil {
		t.Fatal("Send succeeded against a server offering no STARTTLS; the connection silently stayed in plaintext")
	}
	if !strings.Contains(err.Error(), "STARTTLS") {
		t.Errorf("the error does not say what was missing: %v", err)
	}
	if got := server.messages(); len(got) != 0 {
		t.Errorf("the message was delivered in plaintext anyway: %v", got)
	}
}

// TestCredentialsWithoutEncryptionAreRefusedAtStartup is the refusal that
// matters most in this file. AUTH PLAIN is a base64-encoded password on the
// wire; without TLS it hands the sending account to anything on the path.
func TestCredentialsWithoutEncryptionAreRefusedAtStartup(t *testing.T) {
	t.Parallel()

	_, err := NewSettings("smtp.example.com", "25", "postmaster", "hunter2", string(EncryptionNone), "noreply@example.com")
	if err == nil {
		t.Fatal("NewSettings accepted credentials with encryption disabled")
	}
	if !strings.Contains(err.Error(), "encryption") {
		t.Errorf("the refusal does not say why: %v", err)
	}
}

func TestNewSettingsRefusesTheIncoherent(t *testing.T) {
	t.Parallel()

	cases := []struct {
		name                                             string
		host, port, username, password, encryption, from string
	}{
		{"no host", "", "587", "", "", "starttls", "a@example.com"},
		{"no port", "smtp.example.com", "", "", "", "starttls", "a@example.com"},
		{"unknown encryption", "smtp.example.com", "587", "", "", "tls-ish", "a@example.com"},
		{"no from", "smtp.example.com", "587", "", "", "starttls", ""},
		{"unparseable from", "smtp.example.com", "587", "", "", "starttls", "not-an-address"},
		{"password with no username", "smtp.example.com", "587", "", "hunter2", "starttls", "a@example.com"},
		{"line break in host", "smtp.example.com\nEHLO evil", "587", "", "", "starttls", "a@example.com"},
	}
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			t.Parallel()
			if _, err := NewSettings(c.host, c.port, c.username, c.password, c.encryption, c.from); err == nil {
				t.Fatal("NewSettings accepted it")
			}
		})
	}
}

// TestSettingsNeverExposeThePassword covers the accessor surface: everything
// an operator needs for a startup line is available, and the one thing that
// must not appear in one is not.
func TestSettingsNeverExposeThePassword(t *testing.T) {
	t.Parallel()

	settings, err := NewSettings("smtp.example.com", "587", "postmaster", "hunter2", string(EncryptionStartTLS), "noreply@example.com")
	if err != nil {
		t.Fatalf("NewSettings: %v", err)
	}
	if settings.Host() != "smtp.example.com" || settings.Port() != "587" || settings.Username() != "postmaster" {
		t.Error("the non-secret settings are not readable")
	}
	if strings.Contains(settings.password.String(), "hunter2") {
		t.Error("the password formats as its own value")
	}
}
