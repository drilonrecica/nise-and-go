	t.Parallel()

	cookies := testCookies(t, true)
	if _, err := NewResolver(nil, cookies); err == nil {
		t.Error("NewResolver accepted a nil authenticator")
	}
	if _, err := NewResolver(&stubAuthenticator{}, nil); err == nil {
