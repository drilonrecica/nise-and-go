	}
}

func TestResolverAttachesAValidSession(t *testing.T) {
	t.Parallel()

	token := testToken(t)
	authenticator := &stubAuthenticator{
		accepted: token.Value(),
		record:   session.Record{ID: "s1", UserID: "u1", LastSeenAt: fixedNow},
	}
	resolver, _ := testResolver(t, authenticator)

	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.AddCookie(&http.Cookie{Name: "__Host-session", Value: token.Value()})
	response, record, authenticated := serve(t, resolver, request)

	if !authenticated {
		t.Fatal("a valid credential did not produce an authenticated request")
	}
	if record.UserID != "u1" || UserID(request.Context()) != "" {
		t.Fatalf("record = %#v; the identity must live in the handler's context, not the original request's", record)
	}
	if response.Header().Get("Set-Cookie") != "" {
		t.Errorf("a valid session's cookie was rewritten: %q", response.Header().Get("Set-Cookie"))
	}
}

func TestResolverLeavesAnAbsentCredentialUnauthenticated(t *testing.T) {
	t.Parallel()

	authenticator := &stubAuthenticator{accepted: "never"}
	resolver, _ := testResolver(t, authenticator)

	request := httptest.NewRequest(http.MethodGet, "/", nil)
	response, _, authenticated := serve(t, resolver, request)

	if authenticated {
		t.Fatal("a request with no cookie was authenticated")
	}
	if authenticator.calls != 0 {
		t.Errorf("an absent cookie cost %d database lookups", authenticator.calls)
	}
	// Nothing was presented, so there is nothing to clear: sending a
	// clearing cookie to every anonymous visitor would be noise on every
	// public page.
	if response.Header().Get("Set-Cookie") != "" {
		t.Errorf("an anonymous request received %q", response.Header().Get("Set-Cookie"))
	}
	if response.Code != http.StatusOK {
		t.Errorf("status = %d; the resolver must not reject", response.Code)
	}
}

func TestResolverClearsACredentialThatDidNotResolve(t *testing.T) {
	t.Parallel()

	authenticator := &stubAuthenticator{err: &refusal{reason: "revoked"}}
	resolver, _ := testResolver(t, authenticator)

	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.AddCookie(&http.Cookie{Name: "__Host-session", Value: testToken(t).Value()})
	response, _, authenticated := serve(t, resolver, request)

	if authenticated {
		t.Fatal("a refused credential produced an authenticated request")
	}
	header := response.Header().Get("Set-Cookie")
	if !strings.Contains(header, "Max-Age=0") {
		t.Fatalf("Set-Cookie = %q, want the dead credential cleared", header)
	}
	if response.Code != http.StatusOK {
		t.Errorf("status = %d; the resolver must not reject", response.Code)
	}
}

func TestResolverNeverLogsTheCredential(t *testing.T) {
	t.Parallel()

	token := testToken(t)
	authenticator := &stubAuthenticator{err: &refusal{reason: "expired"}}
	cookies := testCookies(t, true)
	resolver, err := NewResolver(authenticator, cookies)
	if err != nil {
		t.Fatalf("NewResolver: %v", err)
	}

	logs := &strings.Builder{}
	handler := resolver.Middleware(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.AddCookie(&http.Cookie{Name: "__Host-session", Value: token.Value()})
	ctx := logging.WithLogger(request.Context(), slog.New(slog.NewTextHandler(logs, nil)))
	handler.ServeHTTP(httptest.NewRecorder(), request.WithContext(ctx))

	if strings.Contains(logs.String(), token.Value()) {
		t.Fatalf("the log recorded the credential: %s", logs.String())
	}
	if !strings.Contains(logs.String(), "expired") {
		t.Errorf("the log does not name the refusal reason: %s", logs.String())
	}
}

func TestContextIdentityCannotBeForged(t *testing.T) {
	t.Parallel()

	// The key is unexported, so a value placed under any other key — even one
	// that looks the same — is not an identity.
	type lookalike struct{}
	ctx := context.WithValue(context.Background(), lookalike{}, session.Record{UserID: "attacker"})
	if _, ok := FromContext(ctx); ok {
		t.Fatal("a session placed under a foreign key was accepted")
	}
	if UserID(ctx) != "" {
		t.Fatal("UserID resolved a forged identity")
	}

	real := WithSession(context.Background(), session.Record{ID: "s1", UserID: "u1"})
	record, ok := FromContext(real)
	if !ok || record.UserID != "u1" || UserID(real) != "u1" {
		t.Fatalf("record = %#v, ok = %t", record, ok)
	}
}

// namedCookie builds one request cookie.
func namedCookie(name, value string) *http.Cookie {
	return &http.Cookie{Name: name, Value: value}
}

// cookieAttributes parses a Set-Cookie header into a comparable map.
func cookieAttributes(t *testing.T, header string) map[string]string {
	t.Helper()

	if header == "" {
		t.Fatal("no Set-Cookie header")
	}
	parsed := (&http.Response{Header: http.Header{"Set-Cookie": []string{header}}}).Cookies()
	if len(parsed) != 1 {
		t.Fatalf("parsed %d cookies from %q", len(parsed), header)
	}
	cookie := parsed[0]
	return map[string]string{
		"name":     cookie.Name,
		"path":     cookie.Path,
		"httponly": boolText(cookie.HttpOnly),
		"secure":   boolText(cookie.Secure),
		"samesite": boolText(cookie.SameSite == http.SameSiteLaxMode),
	}
}

func boolText(value bool) string {
	if value {
		return "true"
	}
	return "false"
}
