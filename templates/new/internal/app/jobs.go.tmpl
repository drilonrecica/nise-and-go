// Generated once by nise; owned by this application. Nise will not overwrite it.

package app

import (
{{- if or .HasUploads .HasNotifications }}
	"log/slog"

{{- end }}
{{- if .HasNotifications }}
	"{{.ModulePath}}/internal/features/notifications"
{{- end }}
{{- if .HasUploads }}
	"{{.ModulePath}}/internal/features/uploads"
{{- end }}
	"{{.ModulePath}}/internal/platform/jobs"
)

// registerJobs declares every background job kind this application knows how
// to run. It is the only place a job becomes runnable, and it is ordinary
// code: no init() function registers a worker behind your back, nothing is
// discovered by walking packages, and adding a job means adding a line here.
//
// A generated application starts with none, so a worker process reports
// `works_jobs=false` in its startup line until the first one is added. That
// is deliberate — an empty worker that says so is easier to reason about
// than a placeholder job that does nothing.
//
// Adding one looks like this:
//
//	jobs.Register(registry, &SendInvitationWorker{Mailer: mailer})
//
// where SendInvitationWorker implements river.Worker[SendInvitationArgs] and
// SendInvitationArgs implements river.JobArgs. The kind string that argument
// type returns is what the queue stores, so it is a name, not a Go type
// path: renaming the Go type must not change it, or jobs already enqueued
// stop matching a worker.
//
// A job that runs on a timer is scheduled as well as registered:

//	jobs.Register(registry, &PruneSessionsWorker{sessions: sessions})
//	if err := jobs.Periodic(registry, time.Hour, PruneSessionsArgs{}); err != nil {
//	    return err
//	}
//
// One insertion per interval across the whole deployment, enforced by a
// database constraint rather than by whichever replica happens to be the
// scheduler — see internal/platform/jobs/periodic.go for why the leader
// election alone is not enough. Scheduling a kind whose worker is not
// registered is refused at startup.
//
// Two rules apply to every job registered here.
//
// A job must be safe to run twice. A process killed mid-job leaves the row
// in the running state, and the next client to hold the leader lease rescues
// it. There is no exactly-once delivery to opt into, in this system or any
// other one worth trusting.
//
// A job must not assume the change that enqueued it is visible only to it.
// Jobs enqueued with [jobs.Client.InsertTx] become visible exactly when
// their transaction commits, which is the guarantee to rely on; anything
// finer is a race.
// It returns an error so that a scheduling mistake — an impossible interval,
// a kind scheduled twice — stops the process at startup rather than being
// discovered when the work quietly does not happen.
func registerJobs(
	registry *jobs.Registry,
{{- if .HasUploads }}
	uploadSweep *uploads.Uploads,
{{- end }}
{{- if .HasNotifications }}
	appNotifications *notifications.Notifications,
{{- end }}
{{- if or .HasUploads .HasNotifications }}
	logger *slog.Logger,
{{- end }}
) error {
{{- if .HasUploads }}
	// The uploads module's sweep: it expires staged uploads whose window
	// elapsed and deletes the objects they were holding a key for. Without
	// it, an abandoned upload occupies a quarantine key forever.
	if err := uploads.RegisterSweep(registry, uploadSweep, logger); err != nil {
		return err
	}
{{- end }}
{{- if .HasNotifications }}
	// The notifications module's delivery worker: one job per channel per
	// notification, so two channels' failures stay independent.
	if err := notifications.RegisterDelivery(registry, appNotifications, logger); err != nil {
		return err
	}
{{- end }}
{{- if not (or .HasUploads .HasNotifications) }}
	// Intentionally empty. See the doc comment above.
	_ = registry
{{- end }}
	return nil
}
