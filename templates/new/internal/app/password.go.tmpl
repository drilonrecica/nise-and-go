// Defaults for the benchmark command. The memory cost is the framework floor
// and the target is a login budget a person does not notice; both are meant to
// be overridden by an operator who knows what this deployment can afford.
const (
	DefaultBenchmarkMemoryKiB   = password.MinMemoryKiB
	DefaultBenchmarkParallelism = 1
	DefaultBenchmarkTarget      = 250 * time.Millisecond
	DefaultBenchmarkSamples     = 3
)

// PasswordBenchmarkRequest is one measured search for parameters.
type PasswordBenchmarkRequest struct {
	// MemoryKiB is the memory cost to hold fixed, in kibibytes.
	MemoryKiB uint32
	// Parallelism is the degree of parallelism to hold fixed.
	Parallelism uint8
	// Target is the per-login budget the recommendation must stay inside.
	Target time.Duration
	// Samples is how many evaluations each measurement is taken over.
	Samples int
}

// PasswordBenchmarkResult is the stable output of the benchmark command.
type PasswordBenchmarkResult struct {
	MemoryKiB    uint32                    `json:"memory_kib"`
	Parallelism  uint8                     `json:"parallelism"`
	Iterations   uint32                    `json:"iterations"`
	TargetMillis int64                     `json:"target_ms"`
	MeasuredMs   int64                     `json:"measured_ms"`
	AtCeiling    bool                      `json:"at_ceiling"`
	Current      string                    `json:"current_policy"`
	Measurements []PasswordBenchmarkSample `json:"measurements"`
}

// PasswordBenchmarkSample is one measured parameter set.
type PasswordBenchmarkSample struct {
	Iterations uint32 `json:"iterations"`
	MedianMs   int64  `json:"median_ms"`
}

// String renders the operator-readable report, including the line to paste
// into internal/platform/passwords.
func (r PasswordBenchmarkResult) String() string {
	var out strings.Builder
	fmt.Fprintf(&out, "argon2id benchmark on this machine (target %dms, %d KiB, p=%d)\n",
		r.TargetMillis, r.MemoryKiB, r.Parallelism)
	for _, sample := range r.Measurements {
		fmt.Fprintf(&out, "  t=%-3d %6dms\n", sample.Iterations, sample.MedianMs)
	}
	fmt.Fprintf(&out, "recommended: m=%d,t=%d,p=%d at %dms\n", r.MemoryKiB, r.Iterations, r.Parallelism, r.MeasuredMs)
	if r.AtCeiling {
		out.WriteString("note: the search stopped at the iteration ceiling, not at the target.\n")
		out.WriteString("      this machine has room to spare; raise --memory rather than passes.\n")
	}
	fmt.Fprintf(&out, "current policy: %s\n", r.Current)
	out.WriteString("put the recommendation in internal/platform/passwords as a new version,\n")
	out.WriteString("and move the previous set into superseded() until its records are rehashed.")
	return out.String()
}

// RunPasswordBenchmark measures Argon2id on this machine and recommends
// parameters.
//
// It deliberately touches no configuration and no database: the answer depends
// on the CPU and memory of the host it runs on and on nothing else, so the
// command is safe to run against a production host without production
// credentials.
func RunPasswordBenchmark(request PasswordBenchmarkRequest) (PasswordBenchmarkResult, error) {
	recommendation, err := password.Recommend(request.MemoryKiB, request.Parallelism, request.Target, request.Samples)
	if err != nil {
		return PasswordBenchmarkResult{}, err
	}
	policy, err := passwords.Policy()
	if err != nil {
		return PasswordBenchmarkResult{}, err
	}

	samples := make([]PasswordBenchmarkSample, 0, len(recommendation.Measurements))
	for _, measurement := range recommendation.Measurements {
		samples = append(samples, PasswordBenchmarkSample{
			Iterations: measurement.Params.Iterations(),
			MedianMs:   measurement.Duration.Milliseconds(),
		})
	}
	return PasswordBenchmarkResult{
		MemoryKiB:    recommendation.Params.MemoryKiB(),
		Parallelism:  recommendation.Params.Parallelism(),
		Iterations:   recommendation.Params.Iterations(),
		TargetMillis: recommendation.Target.Milliseconds(),
		MeasuredMs:   recommendation.Measured.Milliseconds(),
		AtCeiling:    recommendation.AtCeiling,
		Current:      policy.Current().String(),
		Measurements: samples,
	}, nil
}
