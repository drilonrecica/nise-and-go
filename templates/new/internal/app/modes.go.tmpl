// resolveMode decides which process mode this invocation runs. The -mode
// flag wins when it was given; otherwise APP_MODE, already parsed and
// validated by config.Load, decides. An unrecognized value is an error, not
// a fallback: guessing would start a deployment with the wrong components
// running.
func resolveMode(cfg config.Config, override string) (lifecycle.Mode, error) {
	if override == "" {
		return cfg.Mode, nil
	}
	mode, err := lifecycle.ParseMode(override)
	if err != nil {
		return "", fmt.Errorf("-mode: %w", err)
	}
	return mode, nil
}

// newWorker builds the background-processing component that lifecycle.Mode
// "all" and "worker" run.
//
// The loop is deliberately thin. River's client owns the fetching, the
// retry timing, and the leader election; this function owns only the two
// things the process needs from it — start when the component starts, and
// drain when the component's context is canceled.
//
// Draining is given its own timeout rather than inheriting the canceled
// context, because a canceled context is exactly what Stop must not be
// handed: it would return immediately and abandon jobs mid-flight. The
// window is shorter than lifecycle.DefaultShutdownTimeout so that the
// group's own deadline is not consumed entirely by this component.
func newWorker(client *jobs.Client, logger *slog.Logger) *lifecycle.Worker {
	return lifecycle.NewWorker(func(ctx context.Context) error {
		if err := client.Start(ctx); err != nil {
			return err
		}

		logger.Info("worker started",
			slog.Bool("works_jobs", client.Works()),
			slog.Int("max_workers", client.MaxWorkers()),
			slog.Any("job_kinds", client.Kinds()),
			slog.Any("periodic_job_kinds", client.PeriodicKinds()))

		<-ctx.Done()

		drainCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), workerDrainTimeout)
		defer cancel()
		if err := client.Stop(drainCtx); err != nil {
			// A drain that timed out is worth reporting and is not worth
			// failing the process over: the jobs still running are left in
			// the running state and are rescued by the next client to hold
			// the leader lease, which is why every job must be safe to run
			// twice.
			logger.Warn("worker drain did not complete", slog.String("detail", err.Error()))
		}
		logger.Info("worker stopped")
		return nil
	})
}

// workerDrainTimeout is how long a running job has to finish once shutdown
// begins.
const workerDrainTimeout = 20 * time.Second
