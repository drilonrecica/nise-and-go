// databaseRuntime is the database part of the explicit application object
// graph. Feature constructors receive Transactions; repositories receive Pool
// only when they intentionally run outside a business transaction.
type databaseRuntime struct {
	Pool         *pgxpool.Pool
	Transactions *database.Transactor
}

func openDatabaseRuntime(ctx context.Context, cfg config.Config, logger *slog.Logger, metrics *database.QueryMetrics) (databaseRuntime, error) {
	tracer, err := database.NewQueryTracer(database.QueryTraceOptions{
		SlowThreshold: cfg.DatabaseSlowQueryThreshold,
		Logger:        logger,
		Metrics:       metrics,
	})
	if err != nil {
		return databaseRuntime{}, fmt.Errorf("construct query tracer: %w", err)
	}
	pool, err := database.Open(ctx, cfg.DatabaseURL.Reveal(), cfg.DatabasePassword.Reveal(), cfg.Database, database.OpenOptions{Tracer: tracer})
	if err != nil {
		return databaseRuntime{}, err
	}
	transactions, err := database.NewTransactor(pool)
	if err != nil {
		pool.Close()
		return databaseRuntime{}, fmt.Errorf("construct transaction runner: %w", err)
	}
	return databaseRuntime{Pool: pool, Transactions: transactions}, nil
}

func (runtime databaseRuntime) Close() {
	if runtime.Pool != nil {
		runtime.Pool.Close()
	}
}
