// The two refusals this file can produce.
var (
	errNotificationsNeedMail = errors.New("the email notification channel needs a mailer")
	// errEmailChannelNotWired is returned until this application decides how
	// a notification becomes an email. It is a refusal rather than a silent
	// success on purpose: a channel that reports delivery without delivering
	// is worse than one that does not exist, because the delivery row would
	// say "sent".
	errEmailChannelNotWired = errors.New(
		"the email notification channel is not wired yet: resolve the recipient's address and render a message in internal/app/notifications.go")
)

// newNotifications builds the notification use case with the delivery
// channels this application offers.
//
// Channels are registered here, once, in ordinary code — there is no registry
// and no discovery. A channel that is not in this call cannot be named by a
// notification: Notify refuses an unknown channel name before it writes
// anything, so a typo is a refusal rather than a notification nothing will
// ever deliver.
func newNotifications(transactor *database.Transactor, mailer mail.Mailer, renderer *mail.Renderer, from string, logger *slog.Logger) (*notifications.Notifications, error) {
	email, err := newEmailChannel(mailer, renderer, from)
	if err != nil {
		return nil, err
	}
	_ = logger
	return notifications.NewNotifications(transactor, email)
}

// emailChannel delivers a notification as an email.
//
// It is deliberately thin: the notification's title and body are already
// rendered and already localized, so there is nothing left for this to decide
// except how to address the message. An application that wants a designed
// email per notification kind renders it here, from the kind and the data.
type emailChannel struct {
	mailer   mail.Mailer
	renderer *mail.Renderer
	from     string
}

func newEmailChannel(mailer mail.Mailer, renderer *mail.Renderer, from string) (*emailChannel, error) {
	if mailer == nil {
		return nil, errNotificationsNeedMail
	}
	return &emailChannel{mailer: mailer, renderer: renderer, from: from}, nil
}

// Name implements notifications.Channel.
func (c *emailChannel) Name() string { return "email" }

// Deliver implements notifications.Channel.
//
// The recipient's address is not on the notification, because a notification
// is addressed to a user and not to a mailbox: the address is looked up when
// delivery is attempted, so a person who changed it since gets the message at
// the current one. Resolving it is left to the application, which owns the
// user record — this is where that lookup goes.
func (c *emailChannel) Deliver(ctx context.Context, notification notifications.Notification) error {
	_ = ctx
	_ = notification
	return errEmailChannelNotWired
}

// newNotificationStream builds the live-update fan-out, or nil when this
// deployment has turned it off.
//
// Returning nil rather than a disabled stream is deliberate: a nil stream is
// not mounted at all, so a client that asks for it gets a 404 and falls back
// to polling immediately. A mounted-but-disabled endpoint would hold the
// connection open and deliver nothing, which is the same outcome after a
// much longer wait.
func newNotificationStream(cfg config.Config, pool *pgxpool.Pool, logger *slog.Logger) (*notifications.Stream, error) {
	if !cfg.NotificationsSSE {
		return nil, nil
	}
	return notifications.NewStream(pool, logger)
}

// notificationRoutes returns the API registration function for this
// application: the generated operations, plus the live-update endpoint when
// this deployment has one.
//
// It resolves everything it needs up front and returns an error, so a
// misconfigured stream stops startup rather than producing a route that fails
// on its first request.
//
// The stream is mounted here rather than described in api/openapi.yaml, and
// that is a deliberate exception with a narrow reason: an OpenAPI document
// describes request and response *bodies*, and a server-sent-event stream has
// no body in that sense — it has an unbounded sequence of framed events over
// one response. Every attempt to express that in OpenAPI produces a
// description generated code cannot use and a reader cannot trust. The
// endpoint is documented in docs/notifications.md instead, and the polling
// endpoints carrying the same information are in the document as usual.
func notificationRoutes(
	register func(chi.Router),
	stream *notifications.Stream,
	appNotifications *notifications.Notifications,
) (func(chi.Router), error) {
	if stream == nil {
		// Not mounted at all, so a client asking for it gets a 404 and
		// falls back to polling immediately. A mounted-but-disabled
		// endpoint would hold the connection open and deliver nothing,
		// which is the same outcome after a much longer wait.
		return register, nil
	}
	handler, err := stream.Handler(func(r *http.Request) (string, bool) {
		record, ok := httpauth.FromContext(r.Context())
		return record.UserID, ok
	}, appNotifications.Unread)
	if err != nil {
		return nil, err
	}
	return func(r chi.Router) {
		register(r)
		r.Get("/notifications/stream", handler)
	}, nil
}

// runNotificationStream keeps the live-update listener running for as long as
// ctx lasts, and returns only once it has stopped.
//
// It belongs to the **web** component, not the worker, and that placement is
// the whole of it. The fan-out is in-process: a subscriber registered by an
// HTTP handler is only ever woken by the listener running in that same
// process. Started in the worker instead, a deployment that splits `web` and
// `worker` would mount the endpoint on processes whose fan-out nothing feeds
// — clients would connect, subscribe, and silently receive nothing, forever,
// while the worker held a LISTEN connection with no subscribers to wake.
//
// That is exactly what this did until the security review asked which
// goroutine owned it.
//
// Returning only once the listener has stopped is the other half: the process
// closes its database pool on the way out, and a listener still releasing a
// connection at that moment is a shutdown race nobody would reproduce
// deliberately.
func runNotificationStream(ctx context.Context, stream *notifications.Stream, logger *slog.Logger) {
	if stream == nil {
		return
	}
	if err := stream.Run(ctx); err != nil {
		logger.Warn("the notification listener stopped", slog.String("detail", err.Error()))
	}
}
