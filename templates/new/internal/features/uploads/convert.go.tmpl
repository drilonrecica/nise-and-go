// toUpload converts one stored row into the shape this package's callers see.
//
// The conversion is explicit rather than a shared struct, because the store
// package's types are sqlc's and change when the schema does, while [Upload]
// is a contract this feature offers. A caller holding a store.Upload would be
// a caller a migration can break.
func toUpload(row store.Upload) Upload {
	return Upload{
		ID:           uuidString(row.ID),
		State:        string(row.State),
		OwnerUserID:  uuidString(row.OwnerUserID),
		StorageKey:   row.StorageKey,
		Filename:     row.Filename,
		DeclaredType: row.DeclaredType,
		DeclaredSize: row.DeclaredSize,
		ContentType:  row.ContentType.String,
		Size:         row.Size.Int64,
		Checksum:     row.Checksum,
		StagedAt:     timeOf(row.StagedAt),
		ExpiresAt:    timeOf(row.ExpiresAt),
		FinalizedAt:  timeOf(row.FinalizedAt),
		RejectedBy:   row.RejectedReason.String,
