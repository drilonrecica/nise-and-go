}

// mustUUID converts an identifier this package produced itself.
//
// It is used only on a value that has already round-tripped through the
// database, so a failure means the row's own primary key does not parse — a
// corruption this package cannot sensibly continue past. It returns the zero
// UUID rather than panicking, which makes the subsequent statement match no
// row and fail with an ordinary error.
func mustUUID(value string) pgtype.UUID {
	id, err := parseUUID(value)
