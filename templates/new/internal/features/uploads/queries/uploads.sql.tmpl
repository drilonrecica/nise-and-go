-- name: StageUpload :one
INSERT INTO uploads (
    owner_user_id, storage_key, filename, declared_type, declared_size, expires_at
) VALUES (
    $1, $2, $3, $4, $5, $6
)
RETURNING id, state, owner_user_id, storage_key, filename, declared_type,
          declared_size, content_type, size, checksum, staged_at, expires_at,
          finalized_at, rejected_reason, scanned_by;

-- name: GetUpload :one
SELECT id, state, owner_user_id, storage_key, filename, declared_type,
       declared_size, content_type, size, checksum, staged_at, expires_at,
       finalized_at, rejected_reason, scanned_by
FROM uploads
WHERE id = $1;

-- name: GetUploadForUpdate :one
SELECT id, state, owner_user_id, storage_key, filename, declared_type,
       declared_size, content_type, size, checksum, staged_at, expires_at,
       finalized_at, rejected_reason, scanned_by
FROM uploads
WHERE id = $1
FOR UPDATE;

-- name: MarkUploadAvailable :one
UPDATE uploads
SET state = 'available',
    storage_key = $2,
    content_type = $3,
    size = $4,
    checksum = $5,
    scanned_by = $6,
    finalized_at = now()
WHERE id = $1 AND state = 'staged'
RETURNING id, state, owner_user_id, storage_key, filename, declared_type,
          declared_size, content_type, size, checksum, staged_at, expires_at,
          finalized_at, rejected_reason, scanned_by;

-- name: MarkUploadRejected :one
UPDATE uploads
SET state = 'rejected',
    content_type = $2,
    size = $3,
    rejected_reason = $4,
    finalized_at = now()
WHERE id = $1 AND state = 'staged'
RETURNING id, state, owner_user_id, storage_key, filename, declared_type,
          declared_size, content_type, size, checksum, staged_at, expires_at,
          finalized_at, rejected_reason, scanned_by;

-- name: MarkUploadExpired :one
UPDATE uploads
SET state = 'expired',
    finalized_at = now()
WHERE id = $1 AND state = 'staged'
RETURNING id, state, owner_user_id, storage_key, filename, declared_type,
          declared_size, content_type, size, checksum, staged_at, expires_at,
          finalized_at, rejected_reason, scanned_by;

-- name: ListExpiredStagedUploads :many
SELECT id, state, owner_user_id, storage_key, filename, declared_type,
       declared_size, content_type, size, checksum, staged_at, expires_at,
       finalized_at, rejected_reason, scanned_by
FROM uploads
WHERE state = 'staged' AND expires_at <= $1
ORDER BY expires_at
LIMIT $2;

-- name: CountUploadsByState :one
SELECT count(*) FROM uploads WHERE state = $1;
