// TestAnExpiredStagingWindowIsRefusedAndSwept covers the deadline from both
// directions: finalizing late is refused, and a row nobody finalized at all
// is cleaned up along with its object.
func TestAnExpiredStagingWindowIsRefusedAndSwept(t *testing.T) {
	h := newHarness(t)
	content := pngBytes(512)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	h.advance(StagingLifetime + time.Minute)

	if _, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner); !errors.Is(err, ErrRejected) {
		t.Fatalf("a late Finalize = %v, want ErrRejected", err)
	}

	// A second staged upload, left alone, is swept.
	other := h.stageAndUpload(t, content, "image/png", int64(len(content)))
	h.advance(StagingLifetime + time.Minute)

	swept, err := h.uploads.Sweep(h.ctx, 10)
	if err != nil {
		t.Fatalf("Sweep: %v", err)
	}
	if swept != 1 {
		t.Fatalf("Sweep expired %d uploads, want 1", swept)
	}
	if h.stateOf(t, other.ID) != "expired" {
		t.Errorf("state = %q, want expired", h.stateOf(t, other.ID))
	}
	if h.objectExists(t, other.StorageKey) {
		t.Error("the swept object was left in quarantine")
	}
}

// TestSweepLeavesAvailableUploadsAlone is the negative half of the sweep: a
// finalized upload past what would have been its staging deadline must not be
// deleted.
func TestSweepLeavesAvailableUploadsAlone(t *testing.T) {
	h := newHarness(t)
	content := pngBytes(512)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	final, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if err != nil {
		t.Fatalf("Finalize: %v", err)
	}
	h.advance(30 * 24 * time.Hour)

	swept, err := h.uploads.Sweep(h.ctx, 10)
	if err != nil {
		t.Fatalf("Sweep: %v", err)
	}
	if swept != 0 {
		t.Fatalf("Sweep expired %d finalized uploads, want 0", swept)
	}
	if !h.objectExists(t, final.StorageKey) {
		t.Fatal("the sweep deleted an available object")
	}
}

// TestStagingRefusesWhatItCanRefuseEarly covers the checks that cost no
// quarantine object and no round trip.
func TestStagingRefusesWhatItCanRefuseEarly(t *testing.T) {
	h := newHarness(t)

	cases := []struct {
		name    string
		request StageRequest
	}{
		{"no owner", StageRequest{Filename: "a.png", ContentType: "image/png", Size: 1}},
		{"zero size", StageRequest{OwnerUserID: h.owner, Filename: "a.png", ContentType: "image/png", Size: 0}},
		{"negative size", StageRequest{OwnerUserID: h.owner, Filename: "a.png", ContentType: "image/png", Size: -1}},
		{"over the limit", StageRequest{OwnerUserID: h.owner, Filename: "a.png", ContentType: "image/png", Size: MaxUploadBytes + 1}},
		{"no type", StageRequest{OwnerUserID: h.owner, Filename: "a.png", Size: 1}},
		{"unaccepted type", StageRequest{OwnerUserID: h.owner, Filename: "a.html", ContentType: "text/html", Size: 1}},
		{"executable type", StageRequest{OwnerUserID: h.owner, Filename: "a.sh", ContentType: "application/x-sh", Size: 1}},
	}
	for _, c := range cases {
		t.Run(c.name, func(t *testing.T) {
			if _, err := h.uploads.Stage(h.ctx, c.request); err == nil {
				t.Fatal("Stage accepted it")
			}
		})
	}

	var staged int64
	if err := h.pool.QueryRow(h.ctx, `SELECT count(*) FROM uploads`).Scan(&staged); err != nil {
		t.Fatalf("counting: %v", err)
	}
	if staged != 0 {
		t.Errorf("a refused staging wrote %d rows", staged)
	}
}

// TestTheKeyIsNotDerivedFromAnythingTheClientSent is why a presigned URL is
// safe to hand out: the key it names cannot be guessed, and cannot be steered
// by two users choosing the same filename.
func TestTheKeyIsNotDerivedFromAnythingTheClientSent(t *testing.T) {
	h := newHarness(t)

	first, err := h.uploads.Stage(h.ctx, StageRequest{
		OwnerUserID: h.owner, Filename: "same.png", ContentType: "image/png", Size: 128,
	})
	if err != nil {
		t.Fatalf("Stage: %v", err)
	}
	second, err := h.uploads.Stage(h.ctx, StageRequest{
		OwnerUserID: h.owner, Filename: "same.png", ContentType: "image/png", Size: 128,
	})
	if err != nil {
		t.Fatalf("Stage: %v", err)
	}
	if first.Upload.StorageKey == second.Upload.StorageKey {
		t.Fatal("two uploads of the same filename collided on one key")
	}
	for _, staged := range []StagedUpload{first, second} {
		if err := storage.ValidateKey(staged.Upload.StorageKey); err != nil {
			t.Errorf("the derived key is not valid: %v", err)
		}
	}
}

// TestAKeyIsUnaffectedByAHostileFilename is the traversal case, at the
// boundary where a filename could have become part of a path.
func TestAKeyIsUnaffectedByAHostileFilename(t *testing.T) {
	h := newHarness(t)

	staged, err := h.uploads.Stage(h.ctx, StageRequest{
		OwnerUserID: h.owner,
		Filename:    "../../../etc/passwd",
		ContentType: "image/png",
		Size:        128,
	})
	if err != nil {
		t.Fatalf("Stage: %v", err)
	}
	key := staged.Upload.StorageKey
	if strings.Contains(key, "..") || strings.Contains(key, "etc/passwd") {
		t.Fatalf("the filename reached the key: %s", key)
	}
	if !strings.HasPrefix(key, QuarantinePrefix+"/") {
		t.Fatalf("the key is not under the quarantine prefix: %s", key)
	}
	if staged.Upload.Filename != "passwd" {
		t.Errorf("Filename = %q, want the sanitized base name", staged.Upload.Filename)
	}
}

// TestALocalStoreIssuesNoUploadURL pins the branch: a directory on this
// machine has no URL, and inventing one would mean this package quietly
// growing an HTTP server.
func TestALocalStoreIssuesNoUploadURL(t *testing.T) {
	h := newHarness(t)

	staged, err := h.uploads.Stage(h.ctx, StageRequest{
		OwnerUserID: h.owner, Filename: "a.png", ContentType: "image/png", Size: 128,
	})
	if err != nil {
		t.Fatalf("Stage: %v", err)
	}
	if staged.UploadURL != "" {
		t.Errorf("a local store issued an upload URL: %q", staged.UploadURL)
	}
}


// --- the malware-scanning boundary (ADR 0027) ---

// recordingScanner is a scanner a test controls.
type recordingScanner struct {
	name string
	// verdict is returned from Scan.
	verdict error
	// bytes is how much Scan was given.
	bytes int64
	// called counts invocations.
	called int
}

func (s *recordingScanner) Name() string { return s.name }

func (s *recordingScanner) Scan(_ context.Context, r io.Reader) error {
	s.called++
	n, err := io.Copy(io.Discard, r)
	if err != nil {
		return err
	}
	s.bytes = n
	return s.verdict
}

// TestNoScannerIsConfiguredByDefault states the shipped position, so a change
// to it is a change to a test rather than a surprise.
func TestNoScannerIsConfiguredByDefault(t *testing.T) {
	h := newHarness(t)
	content := pngBytes(512)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	final, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if err != nil {
		t.Fatalf("Finalize: %v", err)
	}
	if final.ScannedBy != "" {
		t.Errorf("ScannedBy = %q with no scanner configured", final.ScannedBy)
	}

	var scannedBy *string
	if err := h.pool.QueryRow(h.ctx, `SELECT scanned_by FROM uploads WHERE id = $1`, staged.ID).Scan(&scannedBy); err != nil {
		t.Fatalf("reading scanned_by: %v", err)
	}
	if scannedBy != nil {
		t.Errorf("scanned_by = %q, want NULL so that an unscanned object is recognisable", *scannedBy)
	}
}

// TestAScannerSeesTheStoredBytesAndIsRecorded covers the accepting path.
func TestAScannerSeesTheStoredBytesAndIsRecorded(t *testing.T) {
	h := newHarnessWithScanner(t, &recordingScanner{name: "probe"})
	content := pngBytes(2048)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	final, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if err != nil {
		t.Fatalf("Finalize: %v", err)
	}
	if final.ScannedBy != "probe" {
		t.Errorf("ScannedBy = %q, want the scanner's name", final.ScannedBy)
	}
	if h.scanner.called != 1 {
		t.Errorf("the scanner ran %d times, want 1", h.scanner.called)
	}
	if h.scanner.bytes != int64(len(content)) {
		t.Errorf("the scanner saw %d bytes, want the whole stored object (%d)", h.scanner.bytes, len(content))
	}
}

// TestARefusedObjectNeverLeavesQuarantine is the reason the scan happens
// before the move: there is no window in which a refused object is reachable,
// and no cleanup to get wrong.
func TestARefusedObjectNeverLeavesQuarantine(t *testing.T) {
	h := newHarnessWithScanner(t, &recordingScanner{name: "probe", verdict: errors.New("EICAR-Test-Signature")})
	content := pngBytes(512)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	_, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if !errors.Is(err, ErrRejected) {
		t.Fatalf("Finalize = %v, want ErrRejected", err)
	}
	if h.stateOf(t, staged.ID) != "rejected" {
		t.Errorf("state = %q, want rejected", h.stateOf(t, staged.ID))
	}
	if h.objectExists(t, staged.StorageKey) {
		t.Error("the refused object was left in quarantine")
	}
	// And it never reached the final prefix.
	finalKey := strings.Replace(staged.StorageKey, QuarantinePrefix+"/", ObjectPrefix+"/", 1)
	if h.objectExists(t, finalKey) {
		t.Error("a refused object exists at a reachable key")
	}
}

// TestAnUnavailableScannerDoesNotDeleteTheFile is the distinction that
// decides what happens to somebody's upload. "We could not check" and "we
// checked and it is malicious" are different facts, and only one of them
// should delete a file.
func TestAnUnavailableScannerDoesNotDeleteTheFile(t *testing.T) {
	h := newHarnessWithScanner(t, &recordingScanner{
		name:    "probe",
		verdict: fmt.Errorf("dialing clamd: %w", ErrScanUnavailable),
	})
	content := pngBytes(512)
	staged := h.stageAndUpload(t, content, "image/png", int64(len(content)))

	_, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if !errors.Is(err, ErrScanUnavailable) {
		t.Fatalf("Finalize = %v, want ErrScanUnavailable", err)
	}
	if errors.Is(err, ErrRejected) {
		t.Error("an unreachable scanner was reported as a rejection")
	}
	if h.stateOf(t, staged.ID) != "staged" {
		t.Errorf("state = %q, want the upload still staged so finalization can be retried", h.stateOf(t, staged.ID))
	}
	if !h.objectExists(t, staged.StorageKey) {
		t.Fatal("the object was deleted because the scanner was unreachable; that is data loss caused by an outage")
	}

	// And once the scanner recovers, the same upload finalizes.
	h.scanner.verdict = nil
	final, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner)
	if err != nil {
		t.Fatalf("Finalize after the scanner recovered: %v", err)
	}
	if !final.Available() {
		t.Errorf("state = %q, want available", final.State)
	}
}

// TestACheapRefusalCostsNoScan pins the ordering: an object that is the wrong
// type never reaches the scanner.
func TestACheapRefusalCostsNoScan(t *testing.T) {
	h := newHarnessWithScanner(t, &recordingScanner{name: "probe"})
	script := []byte("<html><script>alert(1)</script></html>")
	staged := h.stageAndUpload(t, script, "image/png", int64(len(script)))

	if _, err := h.uploads.Finalize(h.ctx, staged.ID, h.owner); !errors.Is(err, ErrRejected) {
		t.Fatalf("Finalize = %v, want ErrRejected", err)
	}
	if h.scanner.called != 0 {
		t.Errorf("the scanner ran %d times for an object refused by its type", h.scanner.called)
	}
}
