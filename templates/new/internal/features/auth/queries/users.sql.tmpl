-- CreateUser stores one account. The caller normalizes the address and hashes
-- the password; this query does neither, so neither can be skipped by writing
-- a second insert somewhere else.
-- name: CreateUser :one
INSERT INTO users (email, password_hash, created_at, updated_at)
VALUES ($1, $2, $3, $3)
RETURNING id, email, status, created_at, updated_at;

-- FindUserByEmail resolves a normalized address for the login path.
-- name: FindUserByEmail :one
SELECT id, email, password_hash, status
FROM users
WHERE email = $1;

-- FindUserByID resolves an account already identified by an authenticated
-- session.
-- name: FindUserByID :one
SELECT id, email, password_hash, status
FROM users
WHERE id = $1;

-- UpdateUserPasswordHash rewrites a stored hash, which happens on a password
-- change and on a transparent rehash at login.
-- name: UpdateUserPasswordHash :execrows
UPDATE users
SET password_hash = $2,
    updated_at = $3
WHERE id = $1;

-- SetUserStatus enables or disables an account. Disabling stops the account's
-- sessions from authenticating on their next request; revoking them is a
-- separate, explicit step.
-- name: SetUserStatus :execrows
UPDATE users
SET status = $2,
    updated_at = $3
WHERE id = $1;

-- GrantRole assigns one role. Re-granting is a no-op rather than an error, so
-- an administrator repeating themselves does not need a special case, and the
-- original grant's time and granter are preserved.
-- name: GrantRole :execrows
INSERT INTO user_roles (user_id, role, granted_at, granted_by)
VALUES ($1, $2, $3, $4)
ON CONFLICT (user_id, role) DO NOTHING;

-- RevokeRole removes one assignment.
-- name: RevokeRole :execrows
DELETE FROM user_roles
WHERE user_id = $1
  AND role = $2;

-- ListUserRoles returns the roles one account holds, in a stable order.
-- name: ListUserRoles :many
SELECT role, granted_at, granted_by
FROM user_roles
WHERE user_id = $1
ORDER BY role;

-- ListRoleHolders answers "who can do this", which is the question an audit or
-- an offboarding review actually asks.
-- name: ListRoleHolders :many
SELECT u.id, u.email, u.status, r.granted_at
FROM user_roles r
JOIN users u ON u.id = r.user_id
WHERE r.role = $1
ORDER BY u.email
LIMIT $2;
