-- RotateSession replaces one session with a new token, preserving the original
-- absolute deadline. Copying created_at and expires_at rather than recomputing
-- them is what stops repeated rotation from becoming an unbounded session.
-- The proof of identity is carried across as well: rotation is not a new proof
-- and not the loss of one, so a token replaced a moment after a password was
-- typed must not ask for that password again.
-- name: RotateSession :one
INSERT INTO sessions (user_id, token_digest, created_at, last_seen_at, expires_at, proven_at)
SELECT previous.user_id, $2, previous.created_at, $3, previous.expires_at, previous.proven_at
FROM sessions AS previous
WHERE previous.id = $1
  AND previous.revoked_at IS NULL
RETURNING id, user_id, created_at, last_seen_at, expires_at, revoked_at, proven_at;

-- CreateSession stores one issued session. Only the token digest is written;
-- the token itself never reaches this layer.
-- name: CreateSession :one
INSERT INTO sessions (user_id, token_digest, created_at, last_seen_at, expires_at, proven_at)
VALUES ($1, $2, $3, $3, $4, $3)
RETURNING id, user_id, created_at, last_seen_at, expires_at, revoked_at, proven_at;

-- The user's status is joined in rather than looked up separately: a disabled
-- account must stop authenticating immediately, and a second round trip would
-- be a window in which it did not.
-- name: FindSessionByTokenDigest :one
SELECT s.id,
       s.user_id,
       s.created_at,
       s.last_seen_at,
       s.expires_at,
       s.revoked_at,
       s.proven_at,
       u.status AS user_status
FROM sessions s
JOIN users u ON u.id = s.user_id
WHERE s.token_digest = $1;

-- TouchSession slides the idle window. It skips revoked sessions so a
-- concurrent revocation cannot be undone by an in-flight request.
-- name: TouchSession :execrows
UPDATE sessions
SET last_seen_at = $2
WHERE id = $1
  AND revoked_at IS NULL;

-- RevokeSession ends one session. The revoked_at guard makes it idempotent and
-- preserves the first revocation's reason.
-- name: RevokeSession :execrows
UPDATE sessions
SET revoked_at = $2,
    revoked_reason = $3
WHERE id = $1
  AND revoked_at IS NULL;

-- RevokeUserSessions ends every session an account holds, which is what a
-- password change or a compromise response needs.
-- name: RevokeUserSessions :execrows
UPDATE sessions
SET revoked_at = $2,
    revoked_reason = $3
WHERE user_id = $1
  AND revoked_at IS NULL;

-- RevokeOtherUserSessions ends every session except the one making the request,
-- which is the "sign out everywhere else" action.
-- name: RevokeOtherUserSessions :execrows
UPDATE sessions
SET revoked_at = $3,
    revoked_reason = $4
WHERE user_id = $1
  AND id <> $2
  AND revoked_at IS NULL;

-- ListUserSessions is the account's own view of its sessions. It returns no
-- digest: there is nothing a client could do with one but leak it.
-- name: ListUserSessions :many
SELECT id, created_at, last_seen_at, expires_at, revoked_at
FROM sessions
WHERE user_id = $1
ORDER BY created_at DESC
LIMIT $2;

-- The bounded subquery keeps one sweep a predictable amount of work rather
-- than one statement holding locks over an unbounded backlog.
-- name: DeleteExpiredSessions :execrows
DELETE FROM sessions
WHERE id IN (
    SELECT expiring.id
    FROM sessions AS expiring
    WHERE expiring.expires_at <= $1
    ORDER BY expiring.expires_at
    LIMIT $2
);

-- StampSessionProof records that the holder proved themselves again.
--
-- It touches one session, never the account's others: a proof given in one
-- browser must not make a session on another machine fresh. The proven_at guard
-- keeps the column monotonic, so a delayed write cannot move a proof backwards,
-- and the revoked_at guard stops a request in flight from proving anything
-- about a session that has just been ended.
-- name: StampSessionProof :execrows
UPDATE sessions
SET proven_at = $2
WHERE id = $1
  AND revoked_at IS NULL
  AND proven_at <= $2;
