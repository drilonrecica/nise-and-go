// ErrThrottled reports an attempt refused before any password was checked.
//
// It is separate from ErrInvalidCredentials because it is not a statement about
// the credentials at all, and because a caller should answer it differently: a
// 429 with a retry hint rather than a 401. It says nothing about whether the
// address exists — the counter is keyed by a digest of whatever was submitted.
var ErrThrottled = errors.New("too many attempts; try again later")

// ErrInvalidCredentials is the only failure a login returns.
//
// It covers an address with no account, a wrong password, and a disabled
// account, deliberately. Each of those is a fact an unauthenticated caller
// would like to learn, and a login form is the cheapest place to ask: "no such
// account" enumerates the directory, and "your account is disabled" tells a
// former employee their password still works. Which one actually happened is in
// the audit record.
var ErrInvalidCredentials = errors.New("the address and password do not match an enabled account")

// Outcome is what a login did, for the caller's audit record.
type Outcome string

const (
	// OutcomeSucceeded means a session was issued.
	OutcomeSucceeded Outcome = "succeeded"
	// OutcomeNoAccount means the address matched nothing.
	OutcomeNoAccount Outcome = "no_account"
	// OutcomeWrongPassword means the password did not verify.
	OutcomeWrongPassword Outcome = "wrong_password"
	// OutcomeDisabled means the account exists and may not sign in.
	OutcomeDisabled Outcome = "disabled"
	// OutcomeUnverifiable means the stored hash could not be checked at all,
	// which is a storage problem rather than a wrong password.
	OutcomeUnverifiable Outcome = "unverifiable"
	// OutcomeThrottled means the attempt was refused before any password was
	// checked.
	OutcomeThrottled Outcome = "throttled"
)

// Audit actions this feature records.
const (
	// ActionSessionCreated records a successful sign-in.
	ActionSessionCreated = "session.created"
	// ActionSessionDenied records a refused one. It is a separate action
	// rather than a failed outcome of the first, because a query for "when
	// did this person sign in" must not have to filter out the attempts that
	// were not them.
	ActionSessionDenied = "session.denied"
	// ActionPasswordChanged records a password change.
	ActionPasswordChanged = "password.changed"
	// ActionPasswordSet records a reset or enrollment password.
	ActionPasswordSet = "password.set"
)

// Login is the result of an attempt.
//
// It always carries an Outcome, including on failure, so the caller can record
// what happened without the response having said it.
type Login struct {
	// Outcome is what happened.
	Outcome Outcome
	// Account is the account that signed in. It is meaningful only when
	// Outcome is OutcomeSucceeded.
	Account Account
	// Session is the issued session, meaningful on success only.
	Session Issued
	// Rehashed reports that the stored hash was written under superseded
	// parameters and has been rewritten.
	Rehashed bool
}

// Throttler limits how often an attempt may be made. It is declared here, by
// the consumer, rather than imported from the package that provides it.
type Throttler interface {
	Allow(ctx context.Context, address string, client netip.Addr) (throttle.Decision, error)
	Reset(ctx context.Context, address string) error
}

// Auditor records what happened. It is declared here for the same reason.
type Auditor interface {
	Record(ctx context.Context, event audit.Event) (audit.Record, error)
}

// Credentials is the use case that turns an address and a password into a
// session.
//
// The throttle and the audit recorder are required, not optional. An
// authentication path that can be constructed without either is one that will
// be, and the two are exactly the controls whose absence is invisible until
// somebody needs them.
type Credentials struct {
	accounts *Accounts
	sessions *Sessions
	policy   *password.Policy
	throttle Throttler
	auditor  Auditor
}

// Policy returns the password policy this use case hashes with, for the
// enrollment path that has to hash inside its own transaction.
func (c *Credentials) Policy() *password.Policy { return c.policy }

// NewCredentials constructs the login use case.
func NewCredentials(accounts *Accounts, sessions *Sessions, policy *password.Policy, limiter Throttler, auditor Auditor) (*Credentials, error) {
	if accounts == nil || sessions == nil {
		return nil, errors.New("auth: account and session use cases are required")
	}
	if policy == nil {
		return nil, errors.New("auth: a password policy is required")
	}
	if limiter == nil || auditor == nil {
		return nil, errors.New("auth: a throttle and an audit recorder are required")
	}
	return &Credentials{accounts: accounts, sessions: sessions, policy: policy, throttle: limiter, auditor: auditor}, nil
}

// Authenticate verifies an address and password and issues a session.
//
// Every failure path costs one Argon2 evaluation, including the one where no
// account exists. Skipping the hash there is what turns response time into an
// account-existence oracle, and no amount of identical response bodies fixes
// that.
//
// A successful verification against a superseded parameter set rewrites the
// stored hash before returning. This is the only moment the server legitimately
// holds the plaintext, so it is the only moment the record can be upgraded
// without asking anybody to change their password.
func (c *Credentials) Authenticate(ctx context.Context, email, secret string) (Login, error) {
	// The throttle runs before anything expensive. Argon2 makes each guess
	// cost the server as much as the attacker, so a login endpoint that
	// hashed first and counted afterwards would be a way to exhaust the
	// machine as well as a way in.
	decision, err := c.throttle.Allow(ctx, email, forwarded.ClientIP(ctx))
	if err != nil {
		return Login{}, fmt.Errorf("checking the authentication throttle: %w", err)
	}
	if !decision.Allowed {
		c.record(ctx, ActionSessionDenied, audit.Failed, "", map[string]string{
			"reason": string(OutcomeThrottled),
			"scope":  decision.Scope,
		})
		return Login{Outcome: OutcomeThrottled}, ErrThrottled
	}

	login, err := c.authenticate(ctx, email, secret)
	c.recordLogin(ctx, login, email)
	if err == nil {
		// Only a success clears the address counter, and only that counter:
		// the client bucket keeps its history.
		if resetErr := c.throttle.Reset(ctx, email); resetErr != nil {
			logging.FromContext(ctx).Error("clearing the authentication throttle",
				slog.String("error_type", fmt.Sprintf("%T", resetErr)))
		}
	}
	return login, err
}

func (c *Credentials) authenticate(ctx context.Context, email, secret string) (Login, error) {
	credential, err := c.accounts.FindCredentialByEmail(ctx, email)
	if err != nil {
		if errors.Is(err, ErrAccountNotFound) || errors.Is(err, ErrEmail) {
			// Pay the same cost the real path pays, then give the same
			// answer it gives.
			c.policy.VerifyDummy(secret)
			return Login{Outcome: OutcomeNoAccount}, ErrInvalidCredentials
		}
		return Login{}, err
	}

	verification, err := c.policy.Verify(credential.PasswordHash, secret)
	if err != nil {
		// A stored hash this build cannot check — a retired parameter set,
		// or a damaged record — is not a wrong password. It is logged as
		// itself and still answered generically.
		logging.FromContext(ctx).Error("stored password hash could not be verified",
			slog.String("error_type", fmt.Sprintf("%T", err)))
		return Login{Outcome: OutcomeUnverifiable}, ErrInvalidCredentials
	}
	if !verification.Match {
		return Login{Outcome: OutcomeWrongPassword, Account: credential.Account}, ErrInvalidCredentials
	}
	// The status check is after verification, on purpose: checking it first
	// would let a caller distinguish a disabled account from a wrong password
	// by how long the answer took.
	if credential.Status != StatusActive {
		return Login{Outcome: OutcomeDisabled, Account: credential.Account}, ErrInvalidCredentials
	}

	result := Login{Outcome: OutcomeSucceeded, Account: credential.Account}
	if verification.NeedsRehash {
		if err := c.rehash(ctx, credential.ID, secret); err != nil {
			// A failed upgrade must not fail the login: the password was
			// correct, and the record is merely still old.
			logging.FromContext(ctx).Error("rehashing a password at login",
				slog.String("error_type", fmt.Sprintf("%T", err)))
		} else {
			result.Rehashed = true
		}
	}

	issued, err := c.sessions.Issue(ctx, credential.ID)
	if err != nil {
		return Login{}, fmt.Errorf("issuing the session: %w", err)
	}
	result.Session = issued
	return result, nil
}

// recordLogin writes one audit record for an attempt.
//
// The address is deliberately not in the detail: a failed attempt for an
// address with no account would otherwise put an arbitrary submitted string in
// the log, and a successful one already names the account it belongs to.
func (c *Credentials) recordLogin(ctx context.Context, login Login, email string) {
	if login.Outcome == OutcomeSucceeded {
		c.record(ctx, ActionSessionCreated, audit.Succeeded, login.Account.ID, map[string]string{
			"rehashed": boolText(login.Rehashed),
		})
		return
	}
	if login.Outcome == "" {
		// Nothing was decided — an infrastructure failure the caller is
		// already returning. There is no attempt to record.
		return
	}
	c.record(ctx, ActionSessionDenied, audit.Failed, login.Account.ID, map[string]string{
		"reason": string(login.Outcome),
	})
}

// record writes one audit record, logging rather than failing when it cannot.
//
// A login that succeeded must not be turned into a failure because the audit
// write did not land; a login that failed must not be retried by a caller
// because of it either. The failure is loud in the log, which is the honest
// place for it.
func (c *Credentials) record(ctx context.Context, action, outcome, actorID string, detail map[string]string) {
	event := audit.Event{
		Action:    action,
		Outcome:   outcome,
		ActorKind: audit.ActorAnonymous,
		Detail:    detail,
	}
	if actorID != "" {
		event.ActorKind = audit.ActorUser
		event.ActorID = actorID
	}
	if _, err := c.auditor.Record(ctx, event); err != nil {
		logging.FromContext(ctx).Error("recording an authentication audit event",
			slog.String("action", action),
			slog.String("error_type", fmt.Sprintf("%T", err)))
	}
}

func boolText(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

// rehash rewrites a stored hash under the current parameters.
func (c *Credentials) rehash(ctx context.Context, userID, secret string) error {
	encoded, err := c.policy.Hash(secret)
	if err != nil {
		return err
	}
	return c.accounts.UpdatePasswordHash(ctx, userID, encoded)
}

// ChangePassword replaces an account's password after proving the current one.
//
// It ends every other session the account holds and rotates the one that made
// the change. A password change is what somebody does when they think a
// credential has leaked; leaving the other sessions alive, or leaving the
// current token unchanged, would make that gesture do nothing.
//
// It returns the rotated session for the caller that made the change, so the
// response can set the new cookie. When keepSessionID is empty every session
// ends and the zero value is returned.
func (c *Credentials) ChangePassword(ctx context.Context, userID, current, next string, compromised password.Compromised, keepSessionID string) (Issued, error) {
	account, err := c.accounts.FindByID(ctx, userID)
	if err != nil {
		return Issued{}, err
	}
	credential, err := c.accounts.FindCredentialByEmail(ctx, account.Email)
	if err != nil {
		return Issued{}, err
	}

	verification, err := c.policy.Verify(credential.PasswordHash, current)
	if err != nil || !verification.Match {
		return Issued{}, ErrInvalidCredentials
	}
	if err := passwords.Check(ctx, next, account.Email, compromised); err != nil {
		return Issued{}, err
	}

	encoded, err := c.policy.Hash(next)
	if err != nil {
		return Issued{}, err
	}
	if err := c.accounts.UpdatePasswordHash(ctx, userID, encoded); err != nil {
		return Issued{}, err
	}

	if keepSessionID == "" {
		if _, err := c.sessions.RevokeAllForUser(ctx, userID, "password changed"); err != nil {
			return Issued{}, fmt.Errorf("ending sessions after a password change: %w", err)
		}
		c.record(ctx, ActionPasswordChanged, audit.Succeeded, userID, nil)
		return Issued{}, nil
	}

	if _, err := c.sessions.RevokeOtherSessions(ctx, userID, keepSessionID, "password changed"); err != nil {
		return Issued{}, fmt.Errorf("ending other sessions after a password change: %w", err)
	}
	c.record(ctx, ActionPasswordChanged, audit.Succeeded, userID, nil)
	// The surviving session gets a new token. The old one may have been what
	// prompted the change, and a password change that left the possibly-stolen
	// credential working would be a gesture rather than a response.
	rotated, err := c.sessions.Rotate(ctx, keepSessionID, "password changed")
	if err != nil {
		return Issued{}, fmt.Errorf("rotating the session after a password change: %w", err)
	}
	return rotated, nil
}

// SetPassword stores a password without proving a previous one.
//
// It is the enrollment and reset path, where there is no current password to
// prove and something else — an invitation token, a reset token — has already
// established that the person may set one. It is named separately from
// ChangePassword so that a review can see which of the two a call site used.
func (c *Credentials) SetPassword(ctx context.Context, userID, secret string, compromised password.Compromised) error {
	account, err := c.accounts.FindByID(ctx, userID)
	if err != nil {
		return err
	}
	if err := passwords.Check(ctx, secret, account.Email, compromised); err != nil {
		return err
	}
	encoded, err := c.policy.Hash(secret)
	if err != nil {
		return err
	}
	if err := c.accounts.UpdatePasswordHash(ctx, userID, encoded); err != nil {
		return err
	}
	if _, err := c.sessions.RevokeAllForUser(ctx, userID, "password set"); err != nil {
		return fmt.Errorf("ending sessions after setting a password: %w", err)
	}
	c.record(ctx, ActionPasswordSet, audit.Succeeded, userID, nil)
	return nil
}
