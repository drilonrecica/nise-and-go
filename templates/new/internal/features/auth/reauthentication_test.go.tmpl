func TestActionsInTheMatrixNeedARecentProof(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	roles := testRoles(t, h)
	invitations := testInvitations(t, h, policy)
	enrol(t, h, policy, "admin@example.test", goodPassword)
	account := h.account(t, "person@example.test")
	record := signIn(t, h, credentials, "admin@example.test", goodPassword)

	// An hour later the sign-in is still a valid session and no longer a
	// recent proof.
	h.advance(time.Hour)
	stale := h.onSession(t, record, authorization.RolesManage, authorization.RolesRead, authorization.UsersManage, authorization.UsersRead)

	if err := roles.Grant(stale, account.ID, authorization.RoleAuditor, record.UserID); !errors.Is(err, reauth.ErrRequired) {
		t.Fatalf("Grant error = %v, want reauth.ErrRequired", err)
	}
	if _, _, err := invitations.Create(stale, "new@example.test", nil, record.UserID); !errors.Is(err, reauth.ErrRequired) {
		t.Fatalf("Create error = %v, want reauth.ErrRequired", err)
	}
	if err := h.accounts.SetStatus(stale, account.ID, StatusActive); !errors.Is(err, reauth.ErrRequired) {
		t.Fatalf("SetStatus(active) error = %v, want reauth.ErrRequired", err)
	}

	// A refused action writes nothing.
	grants, err := roles.Grants(stale, account.ID)
	if err != nil {
		t.Fatalf("Grants: %v", err)
	}
	if len(grants) != 0 {
		t.Fatalf("a refused grant wrote %d rows", len(grants))
	}
	if count := h.invitationCount(t); count != 0 {
		t.Fatalf("a refused invitation wrote %d rows", count)
	}

	// Proving the password again is what makes the same request work, on the
	// same session, without signing in anywhere.
	if _, err := credentials.Reauthenticate(h.onSession(t, record), goodPassword); err != nil {
		t.Fatalf("Reauthenticate: %v", err)
	}
	record.ProvenAt = h.clock()
	fresh := h.onSession(t, record, authorization.RolesManage, authorization.RolesRead, authorization.UsersManage, authorization.UsersRead)

	if err := roles.Grant(fresh, account.ID, authorization.RoleAuditor, record.UserID); err != nil {
		t.Fatalf("Grant after reauthenticating: %v", err)
	}
	if _, _, err := invitations.Create(fresh, "new@example.test", nil, record.UserID); err != nil {
		t.Fatalf("Create after reauthenticating: %v", err)
	}
	// Disabling needs no proof; enabling again does, and now has one.
	if err := h.accounts.SetStatus(fresh, account.ID, StatusDisabled); err != nil {
		t.Fatalf("SetStatus(disabled): %v", err)
	}
	if err := h.accounts.SetStatus(fresh, account.ID, StatusActive); err != nil {
		t.Fatalf("SetStatus after reauthenticating: %v", err)
	}
}

// Withdrawing access is deliberately not in the matrix. The withdrawal is the
// response to a compromise, and a control that made the response slower than
// the attack would be helping the wrong party.
func TestWithdrawingAccessIsNotSlowedDown(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	roles := testRoles(t, h)
	invitations := testInvitations(t, h, policy)
	enrol(t, h, policy, "admin@example.test", goodPassword)
	account := h.account(t, "person@example.test")
	record := signIn(t, h, credentials, "admin@example.test", goodPassword)

	permissions := []authz.Permission{
		authorization.RolesManage,
		authorization.RolesRead,
		authorization.UsersManage,
		authorization.UsersRead,
		authorization.SessionsRevoke,
	}
	fresh := h.onSession(t, record, permissions...)
	if err := roles.Grant(fresh, account.ID, authorization.RoleAuditor, record.UserID); err != nil {
		t.Fatalf("Grant: %v", err)
	}
	invitation, _, err := invitations.Create(fresh, "new@example.test", nil, record.UserID)
	if err != nil {
		t.Fatalf("Create: %v", err)
	}

	h.advance(time.Hour)
	stale := h.onSession(t, record, permissions...)
	if err := roles.Revoke(stale, account.ID, authorization.RoleAuditor); err != nil {
		t.Fatalf("Revoke with a stale proof: %v", err)
	}
	if err := h.accounts.SetStatus(stale, account.ID, StatusDisabled); err != nil {
		t.Fatalf("SetStatus(disabled) with a stale proof: %v", err)
	}
	if err := invitations.Revoke(stale, invitation.ID); err != nil {
		t.Fatalf("invitation Revoke with a stale proof: %v", err)
	}
	if _, err := h.sessions.RevokeForAccount(stale, account.ID, "compromised"); err != nil {
		t.Fatalf("RevokeForAccount with a stale proof: %v", err)
	}
}

// Changing a password already takes the current password, which is a stronger
// proof than a recent one. It records that proof rather than asking for the
// same secret twice in one form.
func TestAPasswordChangeIsItsOwnProof(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	roles := testRoles(t, h)
	enrol(t, h, policy, "admin@example.test", goodPassword)
	account := h.account(t, "person@example.test")
	record := signIn(t, h, credentials, "admin@example.test", goodPassword)

	h.advance(time.Hour)
	compromised, err := passwords.Compromised()
	if err != nil {
		t.Fatalf("Compromised: %v", err)
	}
	const nextPassword = "a completely different passphrase"
	rotated, err := credentials.ChangePassword(h.ctx, record.UserID, goodPassword, nextPassword, compromised, record.ID)
	if err != nil {
		t.Fatalf("ChangePassword: %v", err)
	}
	if !rotated.Record.ProvenAt.Equal(h.clock()) {
		t.Fatalf("ProvenAt = %s, want %s", rotated.Record.ProvenAt, h.clock())
	}
	if !h.provenAt(t, rotated.Record.ID).Equal(h.clock()) {
		t.Fatal("the proof was not stored on the rotated session")
	}

	fresh := h.onSession(t, rotated.Record, authorization.RolesManage)
	if err := roles.Grant(fresh, account.ID, authorization.RoleAuditor, record.UserID); err != nil {
		t.Fatalf("Grant after a password change: %v", err)
	}
}

// Rotation is not a proof and not the loss of one. A token replaced a moment
// after a password was typed must not ask for that password again.
func TestRotationCarriesTheProof(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	enrol(t, h, policy, "person@example.test", goodPassword)
	record := signIn(t, h, credentials, "person@example.test", goodPassword)

	h.advance(10 * time.Minute)
	rotated, err := h.sessions.Rotate(h.ctx, record.ID, "privilege change")
	if err != nil {
		t.Fatalf("Rotate: %v", err)
	}
	if !rotated.Record.ProvenAt.Equal(record.ProvenAt) {
		t.Fatalf("ProvenAt = %s, want the previous session's %s", rotated.Record.ProvenAt, record.ProvenAt)
	}
	if !h.provenAt(t, rotated.Record.ID).Equal(record.ProvenAt) {
		t.Fatal("the rotated session stored a different proof than it carried")
	}
}
