// provenAt reads the stored proof directly, so a test can prove that a
// reauthentication wrote one rather than merely reporting that it did.
func (h *harness) provenAt(t *testing.T, sessionID string) time.Time {
	t.Helper()

	var stored time.Time
	if err := h.pool.QueryRow(h.ctx, `SELECT proven_at FROM sessions WHERE id = $1`, sessionID).Scan(&stored); err != nil {
		t.Fatalf("read the stored proof: %v", err)
	}
	return stored.UTC()
}

// onSession is the context a request carrying that session would have: the
// account, the session, and the proof the session currently holds, judged
// against the harness clock.
func (h *harness) onSession(t *testing.T, record session.Record, permissions ...authz.Permission) context.Context {
	t.Helper()

	granted, err := authz.NewSet(permissions...)
	if err != nil {
		t.Fatalf("NewSet: %v", err)
	}
	matrix, err := reauth.DefaultMatrix()
	if err != nil {
		t.Fatalf("DefaultMatrix: %v", err)
	}
	ctx := authorization.WithGrants(h.ctx, authorization.Grants{
		UserID:      record.UserID,
		Permissions: granted,
	})
	return reauth.WithState(ctx, reauth.State{
		UserID:    record.UserID,
		SessionID: record.ID,
		ProvenAt:  record.ProvenAt,
		Matrix:    matrix,
		At:        h.clock(),
	})
}

// signIn produces a real session for an enrolled account.
func signIn(t *testing.T, h *harness, credentials *Credentials, email, secret string) session.Record {
	t.Helper()

	login, err := credentials.Authenticate(h.ctx, email, secret)
	if err != nil {
		t.Fatalf("Authenticate: %v", err)
	}
	return login.Session.Record
}

// A session is proved when it is issued: the person typed the password a
// moment ago, and asking them again immediately would teach them nothing
// except that the prompt is noise.
func TestIssuingASessionRecordsAProof(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	enrol(t, h, policy, "person@example.test", goodPassword)

	record := signIn(t, h, credentials, "person@example.test", goodPassword)
	if !record.ProvenAt.Equal(record.CreatedAt) {
		t.Fatalf("ProvenAt = %s, want the creation time %s", record.ProvenAt, record.CreatedAt)
	}
	if !h.provenAt(t, record.ID).Equal(record.CreatedAt) {
		t.Fatal("the stored proof does not match the returned one")
	}
}

func TestReauthenticationProvesOneSessionAndNoOther(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	enrol(t, h, policy, "person@example.test", goodPassword)

	first := signIn(t, h, credentials, "person@example.test", goodPassword)
	second := signIn(t, h, credentials, "person@example.test", goodPassword)

	h.advance(30 * time.Minute)
	provenAt, err := credentials.Reauthenticate(h.onSession(t, first), goodPassword)
	if err != nil {
		t.Fatalf("Reauthenticate: %v", err)
	}
	if !provenAt.Equal(h.clock()) {
		t.Fatalf("provenAt = %s, want %s", provenAt, h.clock())
	}
	if !h.provenAt(t, first.ID).Equal(h.clock()) {
		t.Fatal("the proof was not written to the session that gave it")
	}
	// Proving yourself in one browser must leave a session on another machine
	// exactly as stale as it was.
	if !h.provenAt(t, second.ID).Equal(second.CreatedAt) {
		t.Fatal("reauthenticating one session refreshed another")
	}

	// A proof is not activity and not a new lifetime: reauthenticating hourly
	// forever must not be a session that never ends.
	var expiresAt time.Time
	if err := h.pool.QueryRow(h.ctx, `SELECT expires_at FROM sessions WHERE id = $1`, first.ID).Scan(&expiresAt); err != nil {
		t.Fatalf("read the absolute deadline: %v", err)
	}
	if !expiresAt.UTC().Equal(first.ExpiresAt) {
		t.Fatalf("the absolute deadline moved from %s to %s", first.ExpiresAt, expiresAt.UTC())
	}
}

func TestAWrongPasswordProvesNothing(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	account := enrol(t, h, policy, "person@example.test", goodPassword)
	record := signIn(t, h, credentials, "person@example.test", goodPassword)

	h.advance(30 * time.Minute)
	if _, err := credentials.Reauthenticate(h.onSession(t, record), "the wrong password"); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("error = %v, want ErrInvalidCredentials", err)
	}
	if !h.provenAt(t, record.ID).Equal(record.CreatedAt) {
		t.Fatal("a refused proof moved the stored proof time")
	}

	recorder, err := audit.NewRecorder(h.transactor(t), audit.WithClock(h.clock))
	if err != nil {
		t.Fatalf("NewRecorder: %v", err)
	}
	reader := authorized(t, account.ID, authorization.AuditRead)
	records, err := recorder.List(reader, audit.Filter{Action: ActionReauthenticationDenied}, audit.Position{}, 10)
	if err != nil {
		t.Fatalf("List: %v", err)
	}
	if len(records) != 1 {
		t.Fatalf("recorded %d refusals, want 1", len(records))
	}
	if records[0].Detail["reason"] != string(OutcomeWrongPassword) {
		t.Fatalf("reason = %q, want %q", records[0].Detail["reason"], OutcomeWrongPassword)
	}
	if records[0].ActorID != account.ID {
		t.Fatalf("actor = %q, want the account that could not prove itself", records[0].ActorID)
	}
}

// The endpoint must not be an unmetered oracle for a password the sign-in page
// counts. It shares the sign-in bucket, so guesses spent here are gone from
// there too.
func TestReauthenticationSharesTheSignInThrottle(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentialsWithThrottle(t, h, policy, tightThrottle(t, 3, 100))
	enrol(t, h, policy, "person@example.test", goodPassword)
	record := signIn(t, h, credentials, "person@example.test", goodPassword)

	for i := range 3 {
		if _, err := credentials.Reauthenticate(h.onSession(t, record), "the wrong password"); !errors.Is(err, ErrInvalidCredentials) {
			t.Fatalf("attempt %d: error = %v, want ErrInvalidCredentials", i+1, err)
		}
	}
	if _, err := credentials.Reauthenticate(h.onSession(t, record), "the wrong password"); !errors.Is(err, ErrThrottled) {
		t.Fatalf("error = %v, want ErrThrottled", err)
	}
	// And the guesses were spent from the sign-in budget as well.
	if _, err := credentials.Authenticate(h.ctx, "person@example.test", goodPassword); !errors.Is(err, ErrThrottled) {
		t.Fatalf("signing in was not throttled after the reauthentication attempts: %v", err)
	}
}

// A session that has outlived its account's status may last one more request;
// it must not be able to prove itself for a sensitive one.
func TestADisabledAccountCannotProveItself(t *testing.T) {
	h := newHarness(t, testLifetime(t))
	policy := testPasswordPolicy(t, 1)
	credentials := testCredentials(t, h, policy)
	account := enrol(t, h, policy, "person@example.test", goodPassword)
	record := signIn(t, h, credentials, "person@example.test", goodPassword)

	admin := authorized(t, h.account(t, "admin@example.test").ID, authorization.UsersManage)
	if err := h.accounts.SetStatus(admin, account.ID, StatusDisabled); err != nil {
		t.Fatalf("SetStatus: %v", err)
	}
	if _, err := credentials.Reauthenticate(h.onSession(t, record), goodPassword); !errors.Is(err, ErrInvalidCredentials) {
		t.Fatalf("error = %v, want ErrInvalidCredentials", err)
	}
	if !h.provenAt(t, record.ID).Equal(record.CreatedAt) {
		t.Fatal("a disabled account moved the stored proof time")
	}
}

