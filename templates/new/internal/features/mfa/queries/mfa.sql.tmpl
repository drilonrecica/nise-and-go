-- EnrolSecret stores an unconfirmed secret, replacing any earlier unconfirmed
-- one. A confirmed row is left alone: replacing it would let anybody who can
-- reach the enrollment path silently swap out somebody's second factor.
-- name: EnrolSecret :one
INSERT INTO totp_secrets (user_id, secret, created_at)
VALUES ($1, $2, $3)
ON CONFLICT (user_id) DO UPDATE
SET secret = EXCLUDED.secret,
    created_at = EXCLUDED.created_at,
    last_step = NULL
WHERE totp_secrets.confirmed_at IS NULL
RETURNING user_id, secret, created_at, confirmed_at, last_step;

-- FindSecret reads one account's secret and its replay position.
-- name: FindSecret :one
SELECT user_id, secret, created_at, confirmed_at, last_step
FROM totp_secrets
WHERE user_id = $1;

-- ConfirmSecret turns an enrolled secret into a second factor, recording the
-- step the confirming code used so it cannot immediately be replayed.
-- name: ConfirmSecret :execrows
UPDATE totp_secrets
SET confirmed_at = $2,
    last_step = $3
WHERE user_id = $1
  AND confirmed_at IS NULL;

-- AdvanceStep records the step a code was accepted at. The comparison is what
-- makes it a replay window rather than a note: a step at or below the stored
-- one updates nothing, and the caller reads zero rows as a refusal.
-- name: AdvanceStep :execrows
UPDATE totp_secrets
SET last_step = $2
WHERE user_id = $1
  AND confirmed_at IS NOT NULL
  AND (last_step IS NULL OR last_step < $2);

-- DeleteSecret removes an account's second factor.
-- name: DeleteSecret :execrows
DELETE FROM totp_secrets
WHERE user_id = $1;

-- DeleteRecoveryCodes removes an account's whole set. A set is replaced
-- together, never topped up, so an older list cannot outlive the moment
-- somebody regenerated it.
-- name: DeleteRecoveryCodes :execrows
DELETE FROM recovery_codes
WHERE user_id = $1;

-- CreateRecoveryCode stores one code's digest.
-- name: CreateRecoveryCode :exec
INSERT INTO recovery_codes (user_id, code_digest, created_at)
VALUES ($1, $2, $3);

-- ConsumeRecoveryCode spends one unused code and reports whether it did. The
-- used_at guard is the single-use rule, enforced by the statement rather than
-- by a read followed by a write that another request could interleave with.
-- name: ConsumeRecoveryCode :execrows
UPDATE recovery_codes
SET used_at = $3
WHERE user_id = $1
  AND code_digest = $2
  AND used_at IS NULL;

-- CountUnusedRecoveryCodes is what tells somebody they are running out.
-- name: CountUnusedRecoveryCodes :one
SELECT count(*) FROM recovery_codes
WHERE user_id = $1
  AND used_at IS NULL;

-- CreateChallenge stores the second step of one sign-in.
-- name: CreateChallenge :one
INSERT INTO mfa_challenges (user_id, token_digest, created_at, expires_at)
VALUES ($1, $2, $3, $4)
RETURNING id, user_id, created_at, expires_at, attempts;

-- FindChallenge reads a challenge by its digest, with the account's status
-- joined in so a disabled account cannot finish a sign-in it started before
-- somebody turned it off.
-- name: FindChallenge :one
SELECT c.id,
       c.user_id,
       c.created_at,
       c.expires_at,
       c.attempts,
       u.status AS user_status
FROM mfa_challenges c
JOIN users u ON u.id = c.user_id
WHERE c.token_digest = $1;

-- CountChallengeAttempt records a wrong code against one challenge.
-- name: CountChallengeAttempt :one
UPDATE mfa_challenges
SET attempts = attempts + 1
WHERE id = $1
RETURNING attempts;

-- DeleteChallenge removes one challenge. It runs on success and on exhaustion:
-- a challenge is single-use in both directions.
-- name: DeleteChallenge :execrows
DELETE FROM mfa_challenges
WHERE id = $1;

-- DeleteExpiredChallenges sweeps a bounded batch, so one sweep is a
-- predictable amount of work rather than one statement holding locks over an
-- unbounded backlog.
-- name: DeleteExpiredChallenges :execrows
DELETE FROM mfa_challenges
WHERE id IN (
    SELECT expiring.id
    FROM mfa_challenges AS expiring
    WHERE expiring.expires_at <= $1
    ORDER BY expiring.expires_at
    LIMIT $2
);
