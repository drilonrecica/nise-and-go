-- name: CreateNotification :one
INSERT INTO notifications (recipient_id, kind, title, body, data)
VALUES ($1, $2, $3, $4, $5)
RETURNING id, recipient_id, kind, title, body, data, created_at, read_at;

-- name: GetNotification :one
SELECT id, recipient_id, kind, title, body, data, created_at, read_at
FROM notifications
WHERE id = $1;

-- name: ListNotifications :many
SELECT id, recipient_id, kind, title, body, data, created_at, read_at
FROM notifications
WHERE recipient_id = $1
  AND (sqlc.narg('before')::timestamptz IS NULL OR created_at < sqlc.narg('before')::timestamptz)
ORDER BY created_at DESC, id DESC
LIMIT $2;

-- name: CountUnreadNotifications :one
SELECT count(*) FROM notifications WHERE recipient_id = $1 AND read_at IS NULL;

-- name: MarkNotificationRead :one
UPDATE notifications
SET read_at = now()
WHERE id = $1 AND recipient_id = $2 AND read_at IS NULL
RETURNING id, recipient_id, kind, title, body, data, created_at, read_at;

-- name: MarkAllNotificationsRead :execrows
UPDATE notifications
SET read_at = now()
WHERE recipient_id = $1 AND read_at IS NULL;

-- name: CreateDelivery :one
INSERT INTO notification_deliveries (notification_id, channel)
VALUES ($1, $2)
ON CONFLICT (notification_id, channel) DO NOTHING
RETURNING id, notification_id, channel, state, attempts, last_error, created_at, updated_at;

-- name: GetDelivery :one
SELECT id, notification_id, channel, state, attempts, last_error, created_at, updated_at
FROM notification_deliveries
WHERE notification_id = $1 AND channel = $2;

-- name: MarkDeliverySent :exec
UPDATE notification_deliveries
SET state = 'sent', attempts = attempts + 1, last_error = NULL, updated_at = now()
WHERE notification_id = $1 AND channel = $2;

-- name: MarkDeliveryFailed :exec
UPDATE notification_deliveries
SET state = 'failed', attempts = attempts + 1, last_error = $3, updated_at = now()
WHERE notification_id = $1 AND channel = $2;

-- name: RecordDeliveryAttempt :exec
UPDATE notification_deliveries
SET attempts = attempts + 1, last_error = $3, updated_at = now()
WHERE notification_id = $1 AND channel = $2;

-- name: ListDeliveries :many
SELECT id, notification_id, channel, state, attempts, last_error, created_at, updated_at
FROM notification_deliveries
WHERE notification_id = $1
ORDER BY channel;
