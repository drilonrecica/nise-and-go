# Generated once by nise; owned by this application. Nise will not overwrite it.

# Go targets are named explicitly rather than as ./... : frontend/ sits
# inside this Go module, so ./... and `gofmt -l .` would both walk
# frontend/node_modules/, and an npm package that happens to ship a .go file
# would show up as a package of this application.
GO_PACKAGES := ./cmd/... ./db/... ./internal/...
GO_FMT_DIRS := cmd db internal
BINARY := bin/{{.AppName}}
SQLC_CONFIGS := $(shell find internal/features -type f -name sqlc.yaml -print | LC_ALL=C sort)
OAPI_SPEC := api/openapi.yaml
OAPI_CONFIG := api/oapi-codegen.yaml
OAPI_GENERATED := internal/platform/httpapi/openapigen/openapi.gen.go

.PHONY: help build dist run test migration-test fmt lint sqlc-generate sqlc-compile sqlc-vet api-generate api-check api-types-generate api-types-check web-install web-check web-test web-build web-clean all

help: ## List the available targets.
	@grep -hE '^[a-z][a-zA-Z0-9_-]*:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "}; {printf "  %-14s %s\n", $$1, $$2}'

all: fmt api-check lint sqlc-vet test web-test dist ## Format, verify generated API contracts, lint, test, and build the shipping binary.

build: ## Build the application binary into bin/ against whatever frontend is embedded.
	go build -o $(BINARY) ./cmd/{{.AppName}}

dist: web-build build ## Build the frontend, then the binary that embeds it. This is the shipping artifact.

run: ## Run the application from source in the default process mode.
	go run ./cmd/{{.AppName}}

test: ## Run the Go test suite with the race detector.
	go test -race $(GO_PACKAGES)

migration-test: ## Run clean-install and supported-upgrade tests against disposable PostgreSQL.
	go test -race ./internal/platform/database -run '^TestMigrationMatrix' -count=1

fmt: ## Format Go source in place.
	gofmt -s -w $(GO_FMT_DIRS)

lint: ## Vet the Go packages. Add golangci-lint here if you adopt it.
	go vet $(GO_PACKAGES)

sqlc-generate: ## Generate every feature-local store in stable path order.
	@if [ -z "$(strip $(SQLC_CONFIGS))" ]; then \
		echo "no feature-local sqlc.yaml files found"; \
	else \
		set -e; \
		for config in $(SQLC_CONFIGS); do \
			echo "sqlc generate -f $$config"; \
			go tool sqlc generate --no-remote -f "$$config"; \
		done; \
	fi

sqlc-compile: ## Compile-check every feature-local SQL contract.
	@if [ -z "$(strip $(SQLC_CONFIGS))" ]; then \
		echo "no feature-local sqlc.yaml files found"; \
	else \
		set -e; \
		for config in $(SQLC_CONFIGS); do \
			echo "sqlc compile -f $$config"; \
			go tool sqlc compile --no-remote -f "$$config"; \
		done; \
	fi

sqlc-vet: ## Enforce output confinement and project SQL safety rules.
	@if [ -z "$(strip $(SQLC_CONFIGS))" ]; then \
		echo "no feature-local sqlc.yaml files found"; \
	else \
		set -e; \
		go test ./internal/platform/database/sqlcsafety; \
		for config in $(SQLC_CONFIGS); do \
			echo "sqlc vet -f $$config"; \
			go tool sqlc vet --no-remote -f "$$config"; \
		done; \
	fi

api-generate: ## Regenerate strict chi bindings from the authoritative OpenAPI document.
	go tool oapi-codegen --config $(OAPI_CONFIG) -o $(OAPI_GENERATED) $(OAPI_SPEC)

api-check: ## Fail when checked-in strict chi bindings are stale.
	@set -e; \
	temporary="$$(mktemp)"; \
	trap 'rm -f "$$temporary"' 0 1 2 15; \
	go tool oapi-codegen --config $(OAPI_CONFIG) -o "$$temporary" $(OAPI_SPEC); \
	if ! cmp -s $(OAPI_GENERATED) "$$temporary"; then \
		echo "$(OAPI_GENERATED) is stale; run 'make api-generate'" >&2; \
		diff -u $(OAPI_GENERATED) "$$temporary" || true; \
		exit 1; \
	fi

api-types-generate: ## Regenerate TypeScript models from the authoritative OpenAPI document.
	pnpm --dir frontend run api:generate

api-types-check: ## Fail when checked-in TypeScript models are stale.
	pnpm --dir frontend run api:check

web-install: ## Install the frontend's dependencies.
	pnpm --dir frontend install

web-check: api-types-check ## Type-check the frontend and its generated API contract.
	pnpm --dir frontend run check

web-test: web-check ## Run the frontend unit contract tests after type checking.
	pnpm --dir frontend run test:unit

web-build: ## Build the frontend into internal/platform/webui/embedded/client/.
	pnpm --dir frontend build

web-clean: ## Remove the frontend build so `build` falls back to the committed placeholder page.
	rm -rf internal/platform/webui/embedded/client
