// A use-case failure becomes the right public code, and a failure the catalog
// does not name stays a 500 rather than becoming a status somebody trusts.
func Test{{.TitlePlural}}FailuresMapToThePublicCatalog(t *testing.T) {
	t.Parallel()

	for name, expected := range map[string]struct {
		err  error
		code string
	}{
		"denied":    {authorization.ErrDenied, "permission_denied"},
		"not found": {{"{"}}{{.Singular}}.ErrNotFound, "not_found"},
		"bad name":  {{"{"}}{{.Singular}}.ErrName, "invalid_request"},
	} {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			var named *problem.Error
			if !errors.As({{.Singular}}Failure(expected.err), &named) {
				t.Fatalf("{{.Singular}}Failure(%v) is not a *problem.Error", expected.err)
			}
			if got := named.Definition().Code(); got != expected.code {
				t.Errorf("code = %q, want %q", got, expected.code)
			}
		})
	}
}

// A failure the catalog does not name is a defect rather than a decision, and
// answering it with a status a caller might trust is how one leaks as a 404
