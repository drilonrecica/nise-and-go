// new{{.TitlePlural}} builds the use case against a disposable database, and a
// context holding every permission it checks.
func new{{.TitlePlural}}(t *testing.T) (*{{.Singular}}.{{.TitlePlural}}, context.Context) {
	t.Helper()

	testDatabase := dbtest.New(t)
	ctx, cancel := context.WithTimeout(context.Background(), {{.Singular}}TestTimeout)
	t.Cleanup(cancel)

	settings, err := database.NewSettings(4, 0, time.Minute, time.Minute, time.Second, 5*time.Second)
	if err != nil {
		t.Fatalf("NewSettings: %v", err)
	}
	url := testDatabase.URL().Reveal()
	password := testDatabase.Password().Reveal()
	pool, err := database.Open(ctx, url, password, settings, database.OpenOptions{})
	if err != nil {
		t.Fatalf("open test pool: %v", err)
	}
	t.Cleanup(pool.Close)

	migrator, err := database.OpenMigrator(ctx, url, password, 5*time.Second, migrationdb.Migrations())
	if err != nil {
		t.Fatalf("OpenMigrator: %v", err)
	}
	t.Cleanup(func() {
		if err := migrator.Close(); err != nil {
			t.Errorf("close migrator: %v", err)
		}
	})
	if _, err := migrator.Up(ctx); err != nil {
		t.Fatalf("migrate test database: %v", err)
	}

	transactor, err := database.NewTransactor(pool)
	if err != nil {
		t.Fatalf("NewTransactor: %v", err)
	}
	use, err := {{.Singular}}.New{{.TitlePlural}}(transactor)
	if err != nil {
		t.Fatalf("New{{.TitlePlural}}: %v", err)
	}

	held, err := rtauthz.NewSet(authorization.{{.PermissionRead}}, authorization.{{.PermissionManage}})
	if err != nil {
		t.Fatalf("NewSet: %v", err)
	}
	return use, authorization.WithGrants(ctx, authorization.Grants{
		UserID:      "00000000-0000-0000-0000-000000000001",
		Permissions: held,
	})
}
