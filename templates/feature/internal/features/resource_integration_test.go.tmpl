// The database-backed starting point.
//
// It runs against real PostgreSQL through dbtest, which is the only place
// several of this feature's rules exist at all: the CHECK constraint on the
// name, what `RETURNING *` actually returns, and whether the list's index is
// the one the planner uses. A test that mocked the store would prove the mock.
//
// It skips when no test database is configured, which is what keeps
// `go test ./...` usable on a machine with no PostgreSQL; CI does not skip.

const {{.Singular}}TestTimeout = 30 * time.Second

func TestCreateAndReadBack(t *testing.T) {
	t.Parallel()

	use, ctx := new{{.TitlePlural}}(t)

	created, err := use.Create(ctx, "  Acme  ")
	if err != nil {
		t.Fatalf("Create: %v", err)
	}
	// The name was normalized on the way in, and the database assigned the
	// identifier and both timestamps.
	if created.Name != "Acme" {
		t.Errorf("Name = %q, want %q", created.Name, "Acme")
	}
	if created.ID == "" || created.CreatedAt.IsZero() || created.UpdatedAt.IsZero() {
		t.Errorf("the database did not assign the identifier and timestamps: %#v", created)
	}

	found, err := use.Get(ctx, created.ID)
	if err != nil {
		t.Fatalf("Get: %v", err)
	}
	if found.ID != created.ID || found.Name != created.Name {
		t.Errorf("Get returned %#v, want %#v", found, created)
	}
}

func TestGetAndDeleteReportMissingRatherThanGuessing(t *testing.T) {
	t.Parallel()

	use, ctx := new{{.TitlePlural}}(t)

	// A well-formed identifier that is not there, and a malformed one, are the
	// same answer: telling a caller which of the two they sent is telling them
	// about records they may not read.
	for _, id := range []string{"00000000-0000-0000-0000-000000000000", "not-an-identifier"} {
		if _, err := use.Get(ctx, id); !errors.Is(err, {{.Singular}}.ErrNotFound) {
			t.Errorf("Get(%q) = %v, want ErrNotFound", id, err)
		}
		if err := use.Delete(ctx, id); !errors.Is(err, {{.Singular}}.ErrNotFound) {
			t.Errorf("Delete(%q) = %v, want ErrNotFound", id, err)
		}
	}
}

func TestListPagesWithoutSkippingOrRepeating(t *testing.T) {
	t.Parallel()

	use, ctx := new{{.TitlePlural}}(t)

	// Created in one loop, so several share a created_at down to the
	// microsecond — which is exactly the case a cursor comparing only the
	// timestamp gets wrong.
	const total = 5
	for i := range total {
		if _, err := use.Create(ctx, string(rune('a'+i))+" record"); err != nil {
			t.Fatalf("Create: %v", err)
		}
	}

	seen := map[string]int{}
	after := {{.Singular}}.{{.Type}}{}
	for range total {
		page, err := use.List(ctx, "", after, 2)
		if err != nil {
			t.Fatalf("List: %v", err)
		}
		for _, item := range page.Items {
			seen[item.ID]++
		}
		if !page.HasMore || len(page.Items) == 0 {
			break
		}
		after = page.Items[len(page.Items)-1]
	}

	if len(seen) != total {
		t.Errorf("saw %d distinct records over the pages, want %d", len(seen), total)
	}
	for id, count := range seen {
		if count != 1 {
			t.Errorf("%s appeared %d times across pages, want once", id, count)
		}
	}
}

